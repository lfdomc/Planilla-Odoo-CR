<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── FORM ─────────────────────────────────────────────────── -->
    <record id="planilla_amonestacion_view_form" model="ir.ui.view">
        <field name="name">planilla.amonestacion.view.form</field>
        <field name="model">planilla.amonestacion</field>
        <field name="arch" type="xml">
            <form string="Amonestación Escrita">
                <header>
                    <button name="action_issue"
                            string="Emitir"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_acknowledge"
                            string="Marcar como Recibida"
                            type="object"
                            class="btn-success"
                            invisible="state != 'issued'"/>
                    <button name="action_print_amonestacion"
                            string="Imprimir / Ver PDF"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel"
                            string="Cancelar"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('cancelled', 'draft')"/>
                    <button name="action_draft"
                            string="Volver a Borrador"
                            type="object"
                            invisible="state not in ('cancelled', 'issued')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,issued,acknowledged"/>
                </header>
                <sheet>
                    <!-- Smart buttons -->
                    <div name="button_box" class="oe_button_box">
                        <button name="action_print_amonestacion"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-print"
                                invisible="state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Imprimir</span>
                            </div>
                        </button>
                    </div>

                    <!-- Alerta amonestaciones previas -->
                    <div class="alert alert-warning"
                         role="alert"
                         invisible="previous_count == 0">
                        <i class="fa fa-exclamation-triangle" title="Advertencia"/>
                        <strong> Atención:</strong> Este empleado tiene
                        <field name="previous_count" nolabel="1" readonly="1"/>
                        amonestación(es) previa(s) emitidas o confirmadas.
                    </div>

                    <group>
                        <group string="Datos del Empleado">
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="date"
                                   readonly="state != 'draft'"/>
                            <field name="location"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Tipo de Falta">
                            <field name="amonestacion_type"
                                   readonly="state != 'draft'"/>
                            <field name="subject"
                                   readonly="state != 'draft'"/>
                            <field name="legal_basis"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <separator string="Hechos Específicos"/>
                    <field name="specific_incidents"
                           nolabel="1"
                           readonly="state != 'draft'"
                           style="width:100%;"/>

                    <separator string="Texto Adicional de la Carta (opcional)"/>
                    <field name="body"
                           nolabel="1"
                           readonly="state != 'draft'"
                           style="width:100%;"/>

                    <separator string="Consecuencias de Reincidencia"/>
                    <field name="consequences"
                           nolabel="1"
                           readonly="state != 'draft'"
                           style="width:100%;"/>

                    <group string="Datos del Firmante">
                        <group>
                            <field name="signed_by_name"
                                   readonly="state != 'draft'"/>
                            <field name="signed_by_title"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <!-- Odoo 18/19: chatter simplificado -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── LIST ─────────────────────────────────────────────────── -->
    <record id="planilla_amonestacion_view_list" model="ir.ui.view">
        <field name="name">planilla.amonestacion.view.list</field>
        <field name="model">planilla.amonestacion</field>
        <field name="arch" type="xml">
            <list string="Amonestaciones"
                  decoration-warning="state == 'issued'"
                  decoration-success="state == 'acknowledged'"
                  decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="branch_id" optional="show"/>
                <field name="amonestacion_type"/>
                <field name="subject"/>
                <field name="signed_by_name" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ── SEARCH ───────────────────────────────────────────────── -->
    <record id="planilla_amonestacion_view_search" model="ir.ui.view">
        <field name="name">planilla.amonestacion.view.search</field>
        <field name="model">planilla.amonestacion</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="amonestacion_type"/>
                <field name="subject"/>
                <separator/>
                <filter string="Borradores"
                        name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Emitidas"
                        name="issued"
                        domain="[('state','=','issued')]"/>
                <filter string="Recibidas"
                        name="acknowledged"
                        domain="[('state','=','acknowledged')]"/>
                <separator/>
                <filter string="Por Empleado"
                        name="by_employee"
                        context="{'group_by':'employee_id'}"/>
                <filter string="Por Tipo"
                        name="by_type"
                        context="{'group_by':'amonestacion_type'}"/>
                <filter string="Por Mes"
                        name="by_month"
                        context="{'group_by':'date:month'}"/>
            
                <separator/>
                <filter name="current_company" string="Empresa Actual"
                        domain="[('company_id', '=', allowed_company_ids[0])]"/>
            </search>
        </field>
    </record>

    <!-- ── ACTION ───────────────────────────────────────────────── -->
    <record id="planilla_amonestacion_action" model="ir.actions.act_window">
        <field name="name">Amonestaciones Escritas</field>
        <field name="res_model">planilla.amonestacion</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_issued': 1, 'search_default_current_company': 1}</field>
    </record>

</odoo>
