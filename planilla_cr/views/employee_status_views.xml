<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_status_list" model="ir.ui.view">
        <field name="name">planilla.employee.status.list</field>
        <field name="model">planilla.employee.status</field>
        <field name="arch" type="xml">
            <list string="Estados de Empleado" editable="top">
                <field name="code"/>
                <field name="name"/>
                <field name="is_active_payroll"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_employee_status" model="ir.actions.act_window">
        <field name="name">Estados de Empleado</field>
        <field name="res_model">planilla.employee.status</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
