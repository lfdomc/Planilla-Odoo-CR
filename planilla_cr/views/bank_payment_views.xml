<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bank_payment_wizard_form" model="ir.ui.view">
        <field name="name">planilla.bank.payment.form</field>
        <field name="model">planilla.bank.payment</field>
        <field name="arch" type="xml">
            <form string="Exportar Planilla para Banco">
                <sheet>
                    <div class="oe_title">
                        <h1>Exportar Planilla para Banco</h1>
                    </div>
                    <group string="Parametros Generales">
                        <group>
                            <field name="company_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="bank_format" widget="radio"/>
                        </group>
                    </group>

                    <!-- BCR DAV -->
                    <group string="Configuracion BCR - Archivo DAV"
                           invisible="bank_format != 'bcr_dav'">
                        <group>
                            <field name="bcr_concept"
                                   placeholder="Ej: Pago Planilla Marzo 2026"/>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert">
                                <strong>Formato BCR DAV:</strong> CSV sin encabezado.
                                Columnas: IBAN, Nombre, Monto, Concepto, Concepto, Concepto.
                                Los empleados deben tener el campo IBAN registrado.
                            </div>
                        </group>
                    </group>

                    <!-- BNCR SIN -->
                    <group string="Configuracion BNCR - Archivo SINPE"
                           invisible="bank_format != 'bncr_sin'">
                        <group string="Datos de la Empresa">
                            <field name="bncr_client_id"
                                   placeholder="15 caracteres - ID asignado por BNCR"/>
                            <field name="bncr_client_id_type"/>
                            <field name="bncr_company_id_number"
                                   placeholder="Cedula juridica sin guiones"/>
                            <field name="bncr_debit_iban"
                                   placeholder="CR + 20 digitos - cuenta empresa en BNCR"/>
                        </group>
                        <group string="Datos del Archivo">
                            <field name="bncr_transfer_number"
                                   placeholder="Consecutivo de 5 digitos Ej: 00001"/>
                            <field name="bncr_currency"/>
                            <field name="bncr_concept"
                                   placeholder="Max 45 caracteres"/>
                        </group>
                        <group colspan="2">
                            <div class="alert alert-warning" role="alert">
                                <strong>Formato BNCR SINPE (.SIN):</strong> Archivo posicional de longitud fija.
                                Requiere que los empleados tengan IBAN registrado.
                                Creditos a cuentas BNCR se procesan en T+0, otros bancos en T+1.
                            </div>
                        </group>
                    </group>

                    <!-- Seccion SINPE Movil -->
                    <group invisible="bank_format != 'sinpe_movil'">
                        <group string="Configuracion SINPE Movil">
                            <field name="sinpe_concept"
                                   placeholder="Pago de Planilla -- max 60 caracteres"/>
                        </group>
                        <group colspan="2">
                            <div class="alert alert-info" role="alert">
                                <strong><i class="fa fa-mobile" title="Mobile"/> SINPE Movil -- Todos los bancos:</strong>
                                Genera un CSV con telefono, monto y concepto por empleado.
                                Compatible con BAC, Scotiabank, Davivienda, BCR, BNCR y cualquier banco adherido a SINPE.
                                Cada empleado debe tener registrado su <strong>Telefono SINPE Movil</strong> de 8 digitos en su ficha.
                            </div>
                        </group>
                    </group>

                </sheet>
                <footer>
                    <button name="action_export" type="object"
                            string="Generar Archivo" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_payment_wizard" model="ir.actions.act_window">
        <field name="name">Exportar para Banco</field>
        <field name="res_model">planilla.bank.payment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
