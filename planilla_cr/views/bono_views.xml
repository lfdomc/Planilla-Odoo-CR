<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ FORM ══════════════════════════════════════════════════════════ -->
    <record id="view_bono_form" model="ir.ui.view">
        <field name="name">planilla.bono.form</field>
        <field name="model">planilla.bono</field>
        <field name="arch" type="xml">
            <form string="Bono / Incentivo">
                <header>
                    <button name="action_suspend" string="Suspender"
                            type="object" class="btn-warning"
                            invisible="state != 'active'"/>
                    <button name="action_reactivate" string="Reactivar"
                            type="object" class="btn-success"
                            invisible="state != 'suspended'"/>
                    <button name="action_end" string="Finalizar"
                            type="object"
                            invisible="state == 'ended'"
                            confirm="¿Finalizar este bono? Ya no se aplicara en boletas futuras."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,suspended,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Empleado">
                            <field name="code" string="Codigo" readonly="1" optional="show"/>
                <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Vigencia">
                            <field name="is_recurring"/>
                            <field name="date_start"/>
                            <field name="date_end"
                                   help="Dejar vacío para aplicar indefinidamente."/>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- Aviso cuando el bono es puntual — impacto en renta -->
                    <div invisible="is_recurring" class="alert alert-warning" role="alert">
                        <strong>⚠ Bono Puntual — Tratamiento Fiscal Especial</strong><br/>
                        Este bono <strong>NO es recurrente</strong> (is_recurring = No).
                        El sistema aplicará el siguiente tratamiento fiscal (v5.28.45):<br/>
                        • <strong>Renta:</strong> el monto NO se anualiza para calcular el tramo de impuesto.
                        Solo se suma al período actual sin proyectarlo a períodos futuros.
                        Esto evita cobrar impuesto de renta por ingresos que no se repetirán.<br/>
                        • <strong>CCSS y Provisiónes:</strong> sí se incluyen en la base del período.<br/>
                        Fundamento legal: Art. 33 LIR / DGT-R-016-2026.
                    </div>

                    <group string=" Tipo de Bono">
                        <group>
                            <field name="bono_type"/>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert">
                                <strong>ℹ Reglas fiscales CR:</strong><br/>
                                • <strong>Productividad, Asistencia, Antigüedad, Comisiones:</strong>
                                  Afectos CCSS y Renta — integran el salario para aguinaldo y cesantía.<br/>
                                • <strong>Transporte:</strong> Exento CCSS/Renta hasta ₡74 000/mes (Reglamento 2023).<br/>
                                • <strong>Alimentación en dinero:</strong> Afecto CCSS y Renta.<br/>
                                • <strong>Gastos de Representación documentados:</strong> Exento CCSS (Art. 5 Ley 7983).
                            </div>
                        </group>
                    </group>

                    <group string=" Monto">
                        <group>
                            <field name="amount_type" widget="radio"/>
                            <field name="amount"
                                   invisible="amount_type != 'fixed'"
                                   string="Monto Fijo (₡)"/>
                            <field name="percentage"
                                   invisible="amount_type != 'percentage'"
                                   string="Porcentaje del Salario Base (%)"/>
                        </group>
                        <group>
                            <field name="monto_gravable_ccss" readonly="1"/>
                            <field name="monto_gravable_renta" readonly="1"/>
                        </group>
                    </group>

                    <group string="⚖ Afectación Fiscal">
                        <group>
                            <field name="afecto_ccss"/>
                            <field name="afecto_renta"/>
                            <field name="tope_exento"
                                   invisible="afecto_ccss and afecto_renta"
                                   help="Monto mensual exento de CCSS/Renta (ej: ₡74 000 para transporte)."/>
                        </group>
                    </group>

                    <field name="note" placeholder="Referencia de acuerdo, acta de junta, etc."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══ LIST ══════════════════════════════════════════════════════════ -->
    <record id="view_bono_list" model="ir.ui.view">
        <field name="name">planilla.bono.list</field>
        <field name="model">planilla.bono</field>
        <field name="arch" type="xml">
            <list string="Bonos y Beneficios"
                  decoration-success="state=='active'"
                  decoration-warning="state=='suspended'"
                  decoration-muted="state=='ended'">
                <field name="employee_id"/>
                <field name="branch_id" optional="show"/>
                <field name="name" string="Concepto"/>
                <field name="bono_type" string="Tipo"/>
                <field name="amount_type" string="Cálculo"/>
                <field name="amount" string="Monto (₡)" optional="show"/>
                <field name="percentage" string="%" optional="show"/>
                <field name="afecto_ccss" string="CCSS" optional="show"/>
                <field name="afecto_renta" string="Renta" optional="show"/>
                <field name="is_recurring" string="Recurrente" optional="show"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-warning="state=='suspended'"
                       decoration-danger="state=='ended'"/>
            </list>
        </field>
    </record>

    <!-- ══ SEARCH ════════════════════════════════════════════════════════ -->
    <record id="view_bono_search" model="ir.ui.view">
        <field name="name">planilla.bono.search</field>
        <field name="model">planilla.bono</field>
        <field name="arch" type="xml">
            <search string="Buscar Bonos">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="bono_type"/>
                <filter string="Activos" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Recurrentes" name="recurring"
                        domain="[('is_recurring','=',True)]"/>
                <filter string="Afectos CCSS" name="ccss"
                        domain="[('afecto_ccss','=',True)]"/>
                <separator/>
                <filter string="Productividad" name="productividad"
                        domain="[('bono_type','=','productividad')]"/>
                <filter string="Transporte" name="transporte"
                        domain="[('bono_type','=','transporte')]"/>
                <filter string="Alimentación" name="alimentacion"
                        domain="[('bono_type','=','alimentacion')]"/>
                <filter string="Antigüedad" name="antiguedad"
                        domain="[('bono_type','=','antiguedad')]"/>
                <separator/>
                <filter string="▾ Por Empleado" name="by_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="▾ Por Tipo de Bono" name="by_type"
                        context="{'group_by': 'bono_type'}"/>
                <filter string="▾ Por Sucursal" name="by_branch"
                        context="{'group_by': 'branch_id'}"/>
            </search>
        </field>
    </record>

    <!-- ══ ACTION ════════════════════════════════════════════════════════ -->
    <record id="action_bono" model="ir.actions.act_window">
        <field name="name">Bonos y Beneficios</field>
        <field name="res_model">planilla.bono</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bono_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay bonos registrados.
            </p>
            <p>
                Registre aquí los bonos formales: productividad, asistencia perfecta,
                transporte, alimentación, antigüedad, etc.
                Se aplicarán automáticamente en cada boleta respetando las
                <strong>reglas fiscales CR</strong> (CCSS / Renta).
            </p>
        </field>
    </record>


</odoo>
