<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Incapacidades -->
    <record id="view_disability_list" model="ir.ui.view">
        <field name="name">planilla.disability.list</field>
        <field name="model">planilla.disability</field>
        <field name="arch" type="xml">
            <list string="Incapacidades" decoration-success="state=='confirmed'"
                  decoration-muted="state=='paid'">
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="disability_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days"/>
                <field name="employer_cost"/>
                <field name="ccss_subsidy"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_disability_form" model="ir.ui.view">
        <field name="name">planilla.disability.form</field>
        <field name="model">planilla.disability</field>
        <field name="arch" type="xml">
            <form string="Incapacidad">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <group>
                        <group string="Empleado">
                            <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="disability_type"/>
                        </group>
                        <group string="Período">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="days" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Subsidio CCSS">
                            <field name="subsidy_percentage"/>
                            <field name="employer_percentage"/>
                            <field name="daily_salary" readonly="1"/>
                        </group>
                        <group string="Montos">
                            <field name="employer_cost" readonly="1"/>
                            <field name="ccss_subsidy" readonly="1"/>
                        </group>
                    </group>
                    <group string="Documentación">
                        <field name="certificate_number"/>
                        <field name="diagnosis"/>
                    </group>
                    <field name="note" placeholder="Observaciones..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_disability" model="ir.actions.act_window">
        <field name="name">Incapacidades</field>
        <field name="res_model">planilla.disability</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
