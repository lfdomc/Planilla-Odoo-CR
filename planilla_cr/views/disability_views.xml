<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_disability_list" model="ir.ui.view">
        <field name="name">planilla.disability.list</field>
        <field name="model">planilla.disability</field>
        <field name="arch" type="xml">
            <list string="Incapacidades"
                  decoration-success="state=='confirmed'"
                  decoration-muted="state=='paid'">
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="disability_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days"/>
                <field name="fecha_parto" optional="show"/>
                <field name="prenatal_days" optional="show"/>
                <field name="postnatal_days" optional="show"/>
                <field name="employer_cost"/>
                <field name="ccss_subsidy"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_disability_form" model="ir.ui.view">
        <field name="name">planilla.disability.form</field>
        <field name="model">planilla.disability</field>
        <field name="arch" type="xml">
            <form string="Incapacidad">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_recompute" type="object" string="Recalcular Montos"
                            invisible="state != 'draft'" class="btn-secondary"
                            help="Fuerza el recálculo del salario diario y subsidio CCSS"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <group>
                        <group string="Empleado">
                            <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="disability_type"/>
                        </group>

                        <!-- Nota: maternidad se gestiona aquí (subsidio CCSS) -->
                        <div class="alert alert-info col-12" role="alert"
                             invisible="disability_type != 'maternity'">
                            <strong>ℹ️ ¿Por qué la maternidad está en Incapacidades?</strong><br/>
                            La licencia de maternidad se gestiona aquí porque involucra
                            un <strong>subsidio económico de la CCSS</strong> (Art. 94 CT):
                            la CCSS paga el 100% del salario promedio directamente.
                            El sistema calcula el monto del subsidio y registra el costo patronal (₡0).<br/>
                            <strong>Licencias sin subsidio</strong> (paternidad, duelo, matrimonio, etc.)
                            se gestionan en
                            <a href="/odoo/planilla-cr/licencias" target="_blank">
                                <strong>Novedades → Licencias Especiales</strong>
                            </a>.
                        </div>
                        <group string="Período">
                            <field name="date_start"
                                   string="Fecha Inicio (Prenatal)"
                                   invisible="disability_type != 'maternity'"/>
                            <field name="date_start"
                                   invisible="disability_type == 'maternity'"/>
                            <field name="date_end"
                                   string="Fecha Fin (Postnatal)"
                                   invisible="disability_type != 'maternity'"/>
                            <field name="date_end"
                                   invisible="disability_type == 'maternity'"/>
                            <field name="days" readonly="1"/>
                        </group>
                    </group>

                    <!-- Sección Maternidad (Art. 94 CT) -->
                    <group string="Datos de Maternidad (Art. 94 CT)"
                           invisible="disability_type != 'maternity'">
                        <group>
                            <field name="fecha_parto"/>
                            <field name="maternity_avg_salary" readonly="1"/>
                        </group>
                        <group>
                            <field name="prenatal_days" readonly="1"/>
                            <field name="postnatal_days" readonly="1"/>
                        </group>
                        <div class="alert alert-info col-12" role="alert">
                            <strong>Art. 94 CT — Licencia de Maternidad:</strong>
                            Un solo registro cubre todo el período (prenatal + postnatal).
                            <br/>• <strong>Fecha Inicio:</strong> Inicio de licencia prenatal (máx 30 días antes del parto).
                            <br/>• <strong>Fecha Parto:</strong> Fecha real o estimada del parto.
                            <br/>• <strong>Fecha Fin:</strong> Fin de licencia postnatal = Fecha Parto + 90 días.
                            <br/>• <strong>Total máximo:</strong> 120 días naturales.
                            <br/>La CCSS subsidia el 100% desde el día 1. El patrono NO paga salario durante este período.
                            <br/>Si el Salario Diario Base muestra 0, presione <strong>Recalcular Montos</strong>.
                        </div>
                    </group>

                    <!-- Sección CCSS / INS (no maternidad) -->
                    <group invisible="disability_type == 'maternity'">
                        <group string="Subsidio CCSS">
                            <field name="subsidy_percentage" groups="planilla_cr.group_planilla_admin"/>
                            <field name="employer_percentage" groups="planilla_cr.group_planilla_admin"/>
                            <field name="daily_salary" readonly="1"/>
                        </group>
                        <group string="Montos">
                            <field name="employer_cost" readonly="1"/>
                            <field name="ccss_subsidy" readonly="1"/>
                        </group>
                    </group>

                    <!-- Montos maternidad -->
                    <group invisible="disability_type != 'maternity'">
                        <group string="Montos (100% CCSS)">
                            <field name="employer_cost" readonly="1"
                                   string="Costo Patrono (debe ser 0)"/>
                            <field name="ccss_subsidy" readonly="1"
                                   string="Subsidio CCSS (100%)"/>
                        </group>
                    </group>

                    <group string="Documentación">
                        <field name="certificate_number"/>
                        <field name="diagnosis"/>
                    </group>
                    <field name="note" placeholder="Observaciones..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_disability" model="ir.actions.act_window">
        <field name="name">Incapacidades</field>
        <field name="res_model">planilla.disability</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
