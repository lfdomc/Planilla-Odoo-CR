<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_type_list" model="ir.ui.view">
        <field name="name">planilla.employee.type.list</field>
        <field name="model">planilla.employee.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Empleado" editable="top">
                <field name="code"/>
                <field name="name"/>
                <field name="contract_type"/>
                <field name="apply_ccss"/>
                <field name="apply_ins"/>
                <field name="apply_income_tax"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_employee_type" model="ir.actions.act_window">
        <field name="name">Tipos de Empleado</field>
        <field name="res_model">planilla.employee.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
