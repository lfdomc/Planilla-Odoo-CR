<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_movement_list" model="ir.ui.view">
        <field name="name">planilla.employee.movement.list</field>
        <field name="model">planilla.employee.movement</field>
        <field name="arch" type="xml">
            <list string="Movimientos de Personal"
                  decoration-success="movement_type in ('ingreso','reingreso')"
                  decoration-danger="movement_type == 'salida'"
                  decoration-info="movement_type == 'aumento'"
                  decoration-warning="movement_type == 'suspension'">
                <field name="movement_date" string="Fecha"/>
                <field name="employee_id" string="Empleado"/>
                <field name="branch_id" string="Sucursal" optional="show"/>
                <field name="movement_type" string="Tipo"/>
                <field name="reason" string="Motivo"/>
                <field name="salary_before" string="Salario Anterior" optional="show"/>
                <field name="salary_after" string="Salario Nuevo" optional="show"/>
                <field name="registered_by" string="Registrado por" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_employee_movement_form" model="ir.ui.view">
        <field name="name">planilla.employee.movement.form</field>
        <field name="model">planilla.employee.movement</field>
        <field name="arch" type="xml">
            <form string="Movimiento de Personal">
                <sheet>
                    <group string="Datos del Movimiento">
                        <group>
                            <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="movement_type"/>
                            <field name="movement_date"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="salary_before"
                                   invisible="movement_type not in ('salida','aumento')"/>
                            <field name="salary_after"
                                   invisible="movement_type not in ('ingreso','reingreso','aumento')"/>
                            <field name="registered_by" readonly="1"/>
                        </group>
                    </group>
                    <group string="Referencias">
                        <field name="termination_id" readonly="1"
                               invisible="not termination_id"/>
                        <field name="salary_history_id" readonly="1"
                               invisible="not salary_history_id"/>
                    </group>
                    <field name="note" placeholder="Observaciones adicionales..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_movement_search" model="ir.ui.view">
        <field name="name">planilla.employee.movement.search</field>
        <field name="model">planilla.employee.movement</field>
        <field name="arch" type="xml">
            <search string="Buscar Movimientos">
                <field name="employee_id"/>
                <field name="movement_type"/>
                <field name="reason"/>
                <filter string="Ingresos" name="ingresos"
                        domain="[('movement_type','=','ingreso')]"/>
                <filter string="Reingresos" name="reingresos"
                        domain="[('movement_type','=','reingreso')]"/>
                <filter string="Salidas" name="salidas"
                        domain="[('movement_type','=','salida')]"/>
                <filter string="Aumentos" name="aumentos"
                        domain="[('movement_type','=','aumento')]"/>
                <separator/>
                <filter string="Por Empleado" name="by_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="Por Tipo" name="by_type"
                        context="{'group_by': 'movement_type'}"/>
                <filter string="Por Mes" name="by_month"
                        context="{'group_by': 'movement_date:month'}"/>
                <filter string="Por Sucursal" name="by_branch"
                        context="{'group_by': 'branch_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_employee_movement" model="ir.actions.act_window">
        <field name="name">Movimientos de Personal</field>
        <field name="res_model">planilla.employee.movement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_movement_search"/>
    </record>

    <menuitem id="menu_employee_movement"
              name="Movimientos de Personal"
              parent="planilla_cr.menu_planilla_cr_reports"
              action="action_employee_movement"
              sequence="25"/>
</odoo>
