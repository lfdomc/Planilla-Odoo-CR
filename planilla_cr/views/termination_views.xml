<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_termination_list" model="ir.ui.view">
        <field name="name">planilla.termination.list</field>
        <field name="model">planilla.termination</field>
        <field name="arch" type="xml">
            <list string="Liquidaciónes / Finiquitos"
                  decoration-success="state=='paid'"
                  decoration-warning="state=='confirmed'"
                  decoration-muted="state=='cancelled'">
                <field name="employee_id" string="Empleado"/>
                <field name="termination_date" string="Fecha Salida"/>
                <field name="termination_reason" string="Motivo"/>
                <field name="years_service" string="Años" digits="[4,1]"/>
                <field name="total_net" string="Total a Pagar"/>
                <field name="state" string="Estado" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_termination_form" model="ir.ui.view">
        <field name="name">planilla.termination.form</field>
        <field name="model">planilla.termination</field>
        <field name="arch" type="xml">
            <form string="Liquidación / Finiquito">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_pay" type="object" string="Marcar como Pagado"
                            invisible="state != 'confirmed'" class="btn-success"/>
                    <button name="action_print_termination" type="object" string="Imprimir Finiquito"
                            invisible="state == 'draft'"/>
                    <button name="action_view_accounting_entry" type="object" string="Ver Asiento"
                            invisible="not move_id"/>
                    <field name="move_id" invisible="1"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object" string="Volver a Borrador" icon="fa-undo"
                            invisible="state not in ('cancelled', 'confirmed')" class="btn-warning"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>

                    <!-- ── PASO 1: Datos básicos ──────────────────── -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <h4 style="color:#1F4E79; border-bottom:2px solid #1F4E79; padding-bottom:4px;">
                                1. Datos del Empleado
                            </h4>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="last_salary" string="Salario Bruto Mensual (₡)"
                                   help="Para empleados con salario variable (comisiones, HE recurrentes), el sistema auto-completa este campo con el promedio de las últimas 4 boletas pagadas. Verifique y ajuste si es necesario."/>
                        </group>
                        <group>
                            <field name="entry_date" string="Fecha de Ingreso"/>
                            <field name="termination_date" string="Fecha de Salida"/>
                            <field name="termination_reason" string="Motivo de Salida"/>
                        </group>
                    </group>

                    <!-- Alerta salario variable -->
                    <div class="alert alert-info col-12" role="alert"
                         invisible="not employee_id">
                        <i class="fa fa-info-circle" title="Información"/>
                        <strong>Salario Bruto Mensual:</strong>
                        Para empleados con comisiones o ingresos variables, este campo
                        se auto-completó con el <strong>promedio de las últimas 4 boletas pagadas</strong>
                        (Art. 153 CT). Verifique que el monto refleje correctamente el
                        ingreso promedio real antes de confirmar la liquidación.
                        Si el empleado no tiene historial salarial en el sistema, ingrese
                        el promedio manualmente consultando los recibos de pago anteriores.
                    </div>

                    <!-- Resumen tiempo de servicio -->
                    <div invisible="not employee_id"
                         style="background:#f0f4f8; border-radius:6px; padding:10px 16px; margin-bottom:16px;">
                        <strong>Tiempo de servicio: </strong>
                        <field name="years_service" digits="[4,1]" nolabel="1" readonly="1"/> años
                        (<field name="months_service" nolabel="1" readonly="1"/> meses /
                        <field name="days_service" nolabel="1" readonly="1"/> días)
                    </div>

                    <!-- ── PASO 2: Componentes liquidación ─────────── -->
                    <div class="row mb-2">
                        <div class="col-12">
                            <h4 style="color:#1F4E79; border-bottom:2px solid #1F4E79; padding-bottom:4px;">
                                2. Componentes de la Liquidación
                            </h4>
                        </div>
                    </div>

                    <group>
                        <!-- Preaviso -->
                        <group string="Preaviso (Art. 28 CT)">
                            <field name="preaviso_applies" string="¿Aplica preaviso?"/>
                            <field name="preaviso_days" string="Días de preaviso" readonly="1"
                                   invisible="not preaviso_applies"/>
                            <field name="preaviso_amount" string="Monto preaviso (₡)" readonly="1"
                                   invisible="not preaviso_applies"/>
                        </group>

                        <!-- Cesantía -->
                        <group string="Cesantía (Art. 29 CT)">
                            <field name="cesantia_applies" readonly="1"
                                   string="¿Aplica cesantía?"/>
                            <field name="cesantia_amount" string="Monto cesantía (₡)" readonly="1"
                                   invisible="not cesantia_applies"/>
                            <div invisible="cesantia_applies" style="color:#888; font-size:12px;">
                                No aplica según el motivo de salida selecciónado.
                            </div>
                        </group>

                        <!-- Vacaciones -->
                        <group string="Vacaciones Proporcionales (Art. 153 CT)">
                            <field name="vacation_days_accrued" string="Días acumulados"
                                   digits="[4,2]" readonly="1"/>
                            <field name="vacation_amount" string="Monto vacaciones (₡)" readonly="1"/>
                        </group>

                        <!-- Aguinaldo -->
                        <group string="Aguinaldo Proporcional (Art. 228 CT)">
                            <field name="aguinaldo_months" string="Meses del período" readonly="1"/>
                            <field name="aguinaldo_amount" string="Monto aguinaldo (₡)" readonly="1"/>
                        </group>
                    </group>

                    <!-- ── PASO 3: Otros conceptos ────────────────── -->
                    <div class="row mb-2">
                        <div class="col-12">
                            <h4 style="color:#1F4E79; border-bottom:2px solid #1F4E79; padding-bottom:4px;">
                                3. Otros Conceptos (opcional)
                            </h4>
                        </div>
                    </div>
                    <group>
                        <group string="Pagos adicionales">
                            <field name="other_payments" string="Monto adicional (₡)"/>
                            <field name="other_payments_note" string="Descripción"
                                   invisible="not other_payments"
                                   placeholder="Ej: Bono, comisión pendiente..."/>
                        </group>
                        <group string="Deducciónes">
                            <field name="deductions" string="Monto a deducir (₡)"/>
                            <field name="deductions_note" string="Descripción"
                                   invisible="not deductions"
                                   placeholder="Ej: Adelanto de salario..."/>
                        </group>
                    </group>

                    <!-- ── TOTAL ──────────────────────────────────── -->
                    <div invisible="not employee_id"
                         style="background:#1F4E79; color:#fff; border-radius:8px; padding:16px 20px; margin-top:16px;">
                        <div style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <div style="font-size:13px; opacity:0.8;">Total Bruto</div>
                                <div style="font-size:16px; font-weight:600;">
                                    ₡ <field name="total_gross" nolabel="1" readonly="1"
                                              style="color:#fff; font-size:16px;"/>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:13px; opacity:0.8;">(-) CCSS Obrero Retenido</div>
                                <div style="font-size:16px;">
                                    ₡ <field name="ccss_employee_on_termination" nolabel="1" readonly="1"
                                              style="color:#fff; font-size:16px;"/>
                                </div>
                            </div>
                            <div style="text-align:right;">
                                <div style="font-size:13px; opacity:0.8;">(-) Otras Deducciónes</div>
                                <div style="font-size:16px;">
                                    ₡ <field name="deductions" nolabel="1" readonly="1"
                                              style="color:#fff; font-size:16px;"/>
                                </div>
                            </div>
                            <div style="text-align:right; border-left:2px solid rgba(255,255,255,0.3); padding-left:20px;">
                                <div style="font-size:14px; opacity:0.85;">TOTAL NETO A PAGAR</div>
                                <div style="font-size:24px; font-weight:700;">
                                    ₡ <field name="total_net" nolabel="1" readonly="1"
                                              style="color:#fff; font-size:24px; font-weight:700;"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notas -->
                    <group style="margin-top:16px;">
                        <field name="note" string="Observaciones"
                               placeholder="Observaciones adicionales..." nolabel="1"/>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_termination" model="ir.actions.act_window">
        <field name="name">Liquidaciónes / Finiquitos</field>
        <field name="res_model">planilla.termination</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nueva liquidación / finiquito
            </p>
            <p>Registre la liquidación de un empleado con cálculo automático de preaviso,
            cesantía, vacaciones y aguinaldo según el Código de Trabajo de Costa Rica.</p>
        </field>
    </record>

    <!-- Server action que abre el formulario en pantalla completa -->
    <record id="action_termination_form_full" model="ir.actions.act_window">
        <field name="name">Liquidaciónes / Finiquitos</field>
        <field name="res_model">planilla.termination</field>
        <field name="view_mode">form,list</field>
        <field name="target">current</field>
    </record>
</odoo>
