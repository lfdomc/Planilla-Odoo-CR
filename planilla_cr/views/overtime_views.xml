<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_overtime_list" model="ir.ui.view">
        <field name="name">planilla.overtime.list</field>
        <field name="model">planilla.overtime</field>
        <field name="arch" type="xml">
            <list string="Horas Extras" decoration-success="state=='approved'"
                  decoration-muted="state=='paid'" decoration-danger="state=='cancelled'">
                <header>
                    <button name="action_recalculate_all_rates" type="object"
                            string="Recalcular Tarifas (corregir errores)"
                            class="btn-warning"
                            confirm="Esto recalculara la tarifa horaria y monto de todas las HE en estado Borrador y Aprobado usando el salario mensual actual de cada empleado. Continuar?"/>
                </header>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="overtime_type"/>
                <field name="hours"/>
                <field name="hourly_rate" string="Tarifa/Hora" optional="show"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_overtime_form" model="ir.ui.view">
        <field name="name">planilla.overtime.form</field>
        <field name="model">planilla.overtime</field>
        <field name="arch" type="xml">
            <form string="Horas Extras">
                <header>
                    <button name="action_approve" type="object" string="Aprobar"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <!-- Banner de advertencia legal — visible cuando se superan límites Art. 139 CT -->
                    <div class="alert alert-warning o_no_print"
                         role="alert"
                         invisible="not legal_warning">
                        <strong>⚠ Advertencia Legal — Art. 139 Código de Trabajo CR</strong><br/>
                        <field name="legal_warning" readonly="1"/>
                        <br/><small>Esta advertencia no bloquea el registro. Se recomienda
                        gestiónar autorización especial con el empleado si corresponde.</small>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="overtime_type"/>
                            <field name="hours"/>
                            <field name="hourly_rate"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Observaciones..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_overtime" model="ir.actions.act_window">
        <field name="name">Horas Extras</field>
        <field name="res_model">planilla.overtime</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
