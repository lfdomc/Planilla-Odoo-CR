<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ccss_report_wizard_form" model="ir.ui.view">
        <field name="name">planilla.ccss.report.form</field>
        <field name="model">planilla.ccss.report</field>
        <field name="arch" type="xml">
            <form string="Planilla CCSS - Cuotas de Patrono">
                <sheet>
                    <div class="oe_title">
                        <h1>Planilla CCSS - Cuotas de Patrono</h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <separator string="Seleccione las Planillas"/>
                    <field name="payroll_run_ids" widget="many2many_checkboxes"
                               domain="[('state','=','done')]"/>
                            <field name="date_from" readonly="1" invisible="not payroll_run_ids"/>
                            <field name="date_to" readonly="1" invisible="not payroll_run_ids"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="report_format" widget="radio"/>
                            <field name="patron_number"
                                   invisible="report_format != 'sicere'"
                                   placeholder="Ej: 2-01-0123456"/>
                            <div class="alert alert-info" role="alert"
                                 invisible="report_format != 'sicere'">
                                <strong>Archivo SICERE:</strong> Formato electrónico
                                para subir directamente al portal
                                sicere.ccss.sa.cr antes del dia 15.
                            </div>
                            <div class="alert alert-info" role="alert"
                                 invisible="report_format == 'sicere'">
                                <strong>Tasas vigentes CCSS:</strong><br/>
                                Cuota Obrero: 10.83%<br/>
                                Cuota Patronal: 26.83%<br/>
                                Presentar antes del dia 15 via SICERE.
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generar Reporte" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ccss_report_wizard" model="ir.actions.act_window">
        <field name="name">Planilla CCSS (Patrono)</field>
        <field name="res_model">planilla.ccss.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
