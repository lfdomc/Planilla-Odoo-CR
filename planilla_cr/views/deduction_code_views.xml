<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_deduction_code_list" model="ir.ui.view">
        <field name="name">planilla.deduction.code.list</field>
        <field name="model">planilla.deduction.code</field>
        <field name="arch" type="xml">
            <list string="Códigos de Deducción">
                <field name="code"/>
                <field name="name"/>
                <field name="deduction_type"/>
                <field name="calculation_type"/>
                <field name="company_id"/>
                <field name="employee_percentage"/>
                <field name="employer_percentage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_deduction_code_form" model="ir.ui.view">
        <field name="name">planilla.deduction.code.form</field>
        <field name="model">planilla.deduction.code</field>
        <field name="arch" type="xml">
            <form string="Código de Deducción">
                <sheet>
                    <group>
                        <group string="Identificación">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="deduction_type"/>
                            <field name="calculation_type"/>
                        </group>
                        <group string="Porcentajes / Montos">
                            <field name="employee_percentage"
                                   invisible="calculation_type == 'fixed'"/>
                            <field name="employer_percentage"
                                   invisible="calculation_type == 'fixed'"/>
                            <field name="fixed_amount"
                                   invisible="calculation_type != 'fixed'"/>
                            <field name="has_ceiling"/>
                            <field name="salary_ceiling"
                                   invisible="not has_ceiling"/>
                        </group>
                    </group>
                    <group string="Empresa">
                        <field name="company_id"/>
                    </group>
                    <group string="Categorías">
                        <group>
                            <field name="is_ccss"/>
                            <field name="is_ins"/>
                            <field name="is_income_tax"/>
                        </group>
                    </group>

                    <!-- Tasas INS por clase de riesgo (solo si es INS) -->
                    <group string="Tasas INS por Clase de Riesgo" invisible="not is_ins">
                        <group>
                            <field name="ins_valid_from"/>
                            <field name="ins_rate_i" string="Clase I — Oficinas (%)"/>
                            <field name="ins_rate_ii" string="Clase II — Comercio (%)"/>
                            <field name="ins_rate_iii" string="Clase III — Industria liviana (%)"/>
                        </group>
                        <group>
                            <field name="ins_rate_iv" string="Clase IV — Construcción (%)"/>
                            <field name="ins_rate_v" string="Clase V — Alto riesgo (%)"/>
                        </group>
                        <div style="background:#fff3cd; border-radius:4px; padding:8px; font-size:12px; color:#856404;">
                            Estas tasas se usan automáticamente en boletas e informe INS.
                            Actualícelas cuando el INS emita nuevas tarifas.
                        </div>
                    </group>
                    <group string="Cuentas Contables">
                        <group>
                            <field name="account_debit_id"/>
                            <field name="account_credit_id"/>
                            <field name="account_employee_id"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_deduction_code" model="ir.actions.act_window">
        <field name="name">Códigos de Deducción</field>
        <field name="res_model">planilla.deduction.code</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
