<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_run_cr_list" model="ir.ui.view">
        <field name="name">planilla.run.cr.list</field>
        <field name="model">planilla.run.cr</field>
        <field name="arch" type="xml">
            <list string="Planillas"
                  decoration-success="state=='done'"
                  decoration-warning="state=='confirmed'"
                  decoration-muted="state=='cancelled'">

                <!-- ── Identificación ── -->
                <field name="name"/>
                <field name="branch_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="payroll_calendar_id" string="Calendarización"/>
                <field name="date_start" string="Desde"/>
                <field name="date_end" string="Hasta"/>
                <field name="payslip_count" string="Boletas"/>
                <field name="count_missing_calendar" string="Sin calendarización"
                       optional="show"
                       decoration-danger="count_missing_calendar > 0"/>
                <field name="count_missing_schedule" string="Sin horario"
                       optional="hide"
                       decoration-warning="count_missing_schedule > 0"/>

                <!-- ── INGRESOS ── -->
                <field name="total_gross" string="Total Bruto"/>
                <field name="total_overtime" string="Horas Extras" optional="hide"/>
                <field name="total_vacaciones_pagadas" string="Vacaciones Pagadas" optional="hide"/>
                <field name="total_bonos_salariales" string="Bonos (afecto CCSS)" optional="hide"/>

                <!-- ── INCAPACIDADES ── -->
                <field name="total_disability_days" string="Días Incap." optional="hide"/>
                <field name="total_salario_cotizable" string="Total Cotizable" optional="hide"
                       help="Suma del salario cotizable. Menor al bruto si hay incapacidades en el período."/>
                <field name="total_ccss_subsidy" string="Subsidio CCSS" optional="hide"/>

                <!-- ── DEDUCCIONES OBRERO (orden de prioridad legal) ── -->
                <field name="total_ccss_employee" string="CCSS Obrero" optional="hide"/>
                <field name="total_income_tax" string="Imp. Renta" optional="hide"/>
                <field name="total_income_tax_credits" string="Créditos Fiscales" optional="hide"/>
                <field name="total_pension_alimentaria" string="Pensión Alimentaria" optional="hide"/>
                <field name="total_embargo" string="Embargos" optional="hide"/>
                <field name="total_loans" string="Préstamos / Adelantos" optional="hide"/>
                <field name="total_cobros_empleado" string="Cobros Empleado" optional="hide"/>
                <field name="total_licencias_sin_goce" string="Lic. Sin Goce / Ausencias" optional="hide"/>
                <field name="total_deductions" string="Total Deducciónes"
                       help="CCSS Obrero + Impuesto de Renta"/>

                <!-- ── RESULTADO OBRERO ── -->
                <field name="total_net" string="Total Neto"
                       help="Bruto menos CCSS Obrero y Renta"/>
                <field name="total_salary_payable" string="A Pagar" optional="show"
                       help="Lo que realmente se deposita: neto menos préstamos y deducciónes adicionales"/>

                <!-- ── CARGAS PATRONALES ── -->
                <field name="total_ccss_employer" string="CCSS Patronal" optional="hide"/>
                <field name="total_ins_employer" string="INS Patronal" optional="hide"/>
                <field name="total_rop_employer" string="ROP Patronal" optional="hide"/>
                <field name="total_aguinaldo_provision" string="Prov. Aguinaldo" optional="hide"/>
                <field name="total_cesantia_provision" string="Prov. Cesantía" optional="hide"/>
                <field name="total_vacation_provision" string="Prov. Vacaciones" optional="hide"/>
                <field name="total_employer_cost" string="Costo Total Patronal"/>
                <field name="cost_per_net_colon" string="₡ Costo/₡ Neto"
                       widget="float" digits="[6,2]"
                       help="Por cada ₡1 que el empleado recibe en mano, la empresa gasta este monto total"/>

                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_run_cr_form" model="ir.ui.view">
        <field name="name">planilla.run.cr.form</field>
        <field name="model">planilla.run.cr</field>
        <field name="arch" type="xml">
            <form string="Planilla">
                <header>
                    <button name="action_generate_payslips" type="object"
                            string="Generar Planilla" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_sync_all_draft" type="object"
                            string="Sincronizar Novedades" class="btn-secondary"
                            icon="fa-refresh"
                            invisible="state != 'draft'"
                            confirm="Esto sincronizara novedades en todas las boletas en Borrador. Las boletas confirmadas o pagadas no seran tocadas. Continuar?"/>
                    <button name="action_recalculate_all_draft" type="object"
                            string="Recalcular" class="btn-secondary"
                            icon="fa-calculator"
                            invisible="state != 'draft'"
                            confirm="Esto recalculara todas las boletas en Borrador. Las boletas confirmadas o pagadas no seran tocadas. Continuar?"/>
                    <button name="action_confirm" type="object"
                            string="Confirmar Planilla" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_pay" type="object"
                            string="Pagar Planilla" class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_view_accounting_entry" type="object"
                            string="Ver Asiento Contable" class="btn-secondary"
                            invisible="not move_id"/>
                    <button name="action_send_all_payslips" type="object"
                            string="Enviar Boletas"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object" string="Volver a Borrador" icon="fa-undo"
                            invisible="state not in ('cancelled', 'confirmed')"
                            class="btn-warning"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <!-- FIX F5: Alertas de datos faltantes en empleados -->
                    <div class="alert alert-danger" role="alert"
                         invisible="count_missing_calendar == 0">
                        <i class="fa fa-exclamation-circle" title="Error"/>
                        <strong><field name="count_missing_calendar" readonly="1"/> empleado(s) sin calendarización de planilla.</strong>
                        El salario puede estar calculándose con frecuencia mensual aunque esta planilla sea quincenal o semanal.
                        Configure la calendarización en cada empleado:
                        <strong>Empleados → pestaña Planilla CR → Horario y Pago → Calendarización de Planilla.</strong>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="count_missing_schedule == 0">
                        <i class="fa fa-exclamation-triangle" title="Advertencia"/>
                        <strong><field name="count_missing_schedule" readonly="1"/> empleado(s) sin tipo de horario configurado.</strong>
                        El cálculo de horas extras y jornadas puede ser impreciso.
                        Configure el tipo de horario en:
                        <strong>Empleados → pestaña Planilla CR → Horario y Pago → Tipo de Horario.</strong>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payslips" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <field name="payslip_count" widget="statinfo" string="Boletas"/>
                        </button>
                    </div>
                    <group>
                        <group string="General">
                            <field name="payroll_calendar_id" required="1"/>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Período">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <div colspan="2" style="margin-top:4px">
                                <button name="action_suggest_dates" type="object"
                                        string="Sugerir Fechas del Período Actual"
                                        class="btn btn-sm btn-secondary"
                                        icon="fa-calendar"
                                        invisible="state != 'draft' or not payroll_calendar_id"/>
                            </div>
                        </group>
                    </group>

                    <group string="Resumen Financiero" invisible="state == 'draft'">
                        <group>
                            <field name="total_gross" readonly="1"/>
                            <field name="total_net" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_ccss_employee" readonly="1"/>
                            <field name="total_ccss_employer" readonly="1"/>
                            <field name="total_employer_cost" readonly="1"/>
                        </group>
                    </group>

                    <field name="payslip_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="branch_id"/>
                            <field name="gross_salary"/>
                            <field name="ccss_employee"/>
                            <field name="income_tax"/>
                            <field name="net_salary"/>
                            <field name="state"/>
                        </list>
                    </field>

                    <field name="note" placeholder="Notas..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payroll_run_cr" model="ir.actions.act_window">
        <field name="name">Planillas</field>
        <field name="res_model">planilla.run.cr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
