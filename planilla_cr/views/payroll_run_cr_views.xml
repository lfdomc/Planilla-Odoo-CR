<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_run_cr_list" model="ir.ui.view">
        <field name="name">planilla.run.cr.list</field>
        <field name="model">planilla.run.cr</field>
        <field name="arch" type="xml">
            <list string="Planillas" decoration-success="state=='done'"
                  decoration-warning="state=='confirmed'">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="department_id"/>
                <field name="payroll_calendar_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="payslip_count"/>
                <field name="total_gross"/>
                <field name="total_net"/>
                <field name="total_employer_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_run_cr_form" model="ir.ui.view">
        <field name="name">planilla.run.cr.form</field>
        <field name="model">planilla.run.cr</field>
        <field name="arch" type="xml">
            <form string="Planilla">
                <header>
                    <button name="action_generate_payslips" type="object"
                            string="Generar Boletas" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object"
                            string="Confirmar Planilla" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_pay" type="object"
                            string="Pagar Planilla" class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_view_accounting_entry" type="object"
                            string="Ver Asiento Contable" class="btn-secondary"
                            invisible="not move_id"/>
                    <button name="action_send_all_payslips" type="object"
                            string="Enviar Boletas"
                            invisible="state != 'done'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_to_draft" type="object" string="⟲ Volver a Borrador"
                            invisible="state not in ('cancelled', 'confirmed')"
                            class="btn-warning"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payslips" type="object"
                                class="oe_stat_button" icon="fa-file-text">
                            <field name="payslip_count" widget="statinfo" string="Boletas"/>
                        </button>
                    </div>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="department_id"/>
                            <field name="payroll_calendar_id"/>
                        </group>
                        <group string="Período">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>

                    <group string="Resumen Financiero" invisible="state == 'draft'">
                        <group>
                            <field name="total_gross" readonly="1"/>
                            <field name="total_net" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_ccss_employee" readonly="1"/>
                            <field name="total_ccss_employer" readonly="1"/>
                            <field name="total_employer_cost" readonly="1"/>
                        </group>
                    </group>

                    <field name="payslip_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="branch_id"/>
                            <field name="gross_salary"/>
                            <field name="ccss_employee"/>
                            <field name="income_tax"/>
                            <field name="net_salary"/>
                            <field name="state"/>
                        </list>
                    </field>

                    <field name="note" placeholder="Notas..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payroll_run_cr" model="ir.actions.act_window">
        <field name="name">Planillas</field>
        <field name="res_model">planilla.run.cr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
