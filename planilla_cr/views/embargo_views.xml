<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- == FORM ========================================================== -->
    <record id="view_embargo_form" model="ir.ui.view">
        <field name="name">planilla.embargo.form</field>
        <field name="model">planilla.embargo</field>
        <field name="arch" type="xml">
            <form string="Embargo Judicial">
                <header>
                    <button name="action_suspend" string="Suspender"
                            type="object" class="btn-warning"
                            invisible="state != 'active'"
                            confirm="¿Suspender este embargo? Las boletas futuras no lo incluiran hasta reactivarlo."/>
                    <button name="action_reactivate" string="Reactivar"
                            type="object" class="btn-success"
                            invisible="state != 'suspended'"/>
                    <button name="action_end" string="Finalizar"
                            type="object"
                            invisible="state == 'ended'"
                            confirm="¿Finalizar este embargo? Esta accion lo desactivara permanentemente."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,suspended,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-danger" role="alert">
                        <strong>⚖ Art. 172 Codigo de Trabajo:</strong>
                        El embargo judicial no puede superar el <strong>25 % del salario neto disponible</strong>
                        (despues de CCSS obrera, renta y pensiones alimentarias).
                        El patrono tiene <strong>responsabilidad solidaria</strong> si no aplica el descuento.
                    </div>

                    <group>
                        <group string="Empleado">
                            <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Vigencia">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string=" Datos Judiciales">
                        <group>
                            <field name="numero_expediente"/>
                            <field name="juzgado"/>
                            <field name="fecha_resolucion"/>
                        </group>
                    </group>

                    <group string=" Beneficiario / Acreedor">
                        <group>
                            <field name="beneficiario_nombre"/>
                            <field name="beneficiario_cuenta"
                                   placeholder="CR21015108010018023571"/>
                        </group>
                    </group>

                    <group string="$ Monto del Embargo">
                        <group>
                            <field name="calculation_type" widget="radio"/>
                            <field name="fixed_amount"
                                   invisible="calculation_type != 'fixed'"/>
                            <field name="percentage"
                                   invisible="calculation_type != 'percentage'"
                                   help="Maximo legal: 25 % del neto disponible (Art. 172 CT)."/>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert"
                                 invisible="calculation_type != 'percentage'">
                                El porcentaje se aplica sobre el neto disponible
                                (bruto − CCSS obrera − renta − pensiones alimentarias).
                                Si varios embargos suman mas del 25 %, se prorratean.
                            </div>
                        </group>
                    </group>

                    <field name="note" placeholder="Observaciones adicionales, historial de pagos, etc."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- == LIST ========================================================== -->
    <record id="view_embargo_list" model="ir.ui.view">
        <field name="name">planilla.embargo.list</field>
        <field name="model">planilla.embargo</field>
        <field name="arch" type="xml">
            <list string="Embargos Judiciales"
                  decoration-success="state=='active'"
                  decoration-warning="state=='suspended'"
                  decoration-muted="state=='ended'">
                <field name="employee_id"/>
                <field name="branch_id" optional="show"/>
                <field name="numero_expediente"/>
                <field name="juzgado" optional="show"/>
                <field name="beneficiario_nombre"/>
                <field name="calculation_type" string="Calculo"/>
                <field name="fixed_amount" string="Monto (CRC)" optional="show"/>
                <field name="percentage" string="%" optional="show"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-warning="state=='suspended'"
                       decoration-danger="state=='ended'"/>
            </list>
        </field>
    </record>

    <!-- == SEARCH ======================================================== -->
    <record id="view_embargo_search" model="ir.ui.view">
        <field name="name">planilla.embargo.search</field>
        <field name="model">planilla.embargo</field>
        <field name="arch" type="xml">
            <search string="Buscar Embargos">
                <field name="employee_id"/>
                <field name="numero_expediente"/>
                <field name="beneficiario_nombre"/>
                <filter string="Activos" name="active"
                        domain="[('state','=','active')]"/>
                <filter string="Suspendidos" name="suspended"
                        domain="[('state','=','suspended')]"/>
                <filter string="Finalizados" name="ended"
                        domain="[('state','=','ended')]"/>
                <separator/>
                <filter string="Archivados" name="archived"
                        domain="[('active','=',False)]"/>
                <separator/>
                <filter string="▾ Por Empleado" name="by_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="▾ Por Sucursal" name="by_branch"
                        context="{'group_by': 'branch_id'}"/>
                <filter string="▾ Por Estado" name="by_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- == ACTION ======================================================== -->
    <record id="action_embargo" model="ir.actions.act_window">
        <field name="name">Embargos Judiciales</field>
        <field name="res_model">planilla.embargo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_embargo_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay embargos judiciales registrados.
            </p>
            <p>
                Registre aqui los embargos judiciales ordenados por el juzgado.
                Se descontaran automaticamente en cada boleta respetando el
                limite del <strong>25 % del salario neto</strong> (Art. 172 CT).
            </p>
        </field>
    </record>


</odoo>
