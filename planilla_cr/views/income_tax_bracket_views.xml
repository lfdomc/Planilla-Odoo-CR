<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_income_tax_bracket_list" model="ir.ui.view">
        <field name="name">planilla.income.tax.bracket.list</field>
        <field name="model">planilla.income.tax.bracket</field>
        <field name="arch" type="xml">
            <list string="Tramos de Renta" editable="bottom"
                  decoration-muted="active == False"
                  decoration-success="active == True">
                <field name="sequence" widget="handle"/>
                <field name="year" string="Ano Fiscal"/>
                <field name="name"/>
                <field name="limit_from"/>
                <field name="limit_to"/>
                <field name="rate" string="Tasa (%)"/>
                <field name="valid_from"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_income_tax_bracket_form" model="ir.ui.view">
        <field name="name">planilla.income.tax.bracket.form</field>
        <field name="model">planilla.income.tax.bracket</field>
        <field name="arch" type="xml">
            <form string="Tramo de Renta">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="year"/>
                            <field name="sequence"/>
                            <field name="valid_from"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="limit_from"/>
                            <field name="limit_to" help="0 = sin limite superior"/>
                            <field name="rate" string="Tasa (%)"/>
                            <field name="note" placeholder="Ej: DGT-R-016-2026"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="active == True">
                        <i class="fa fa-exclamation-triangle"/>
                        Este tramo esta <strong>inactivo</strong> y NO se usa en el cálculo de renta.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_income_tax_bracket" model="ir.actions.act_window">
        <field name="name">Tramos Impuesto de Renta</field>
        <field name="res_model">planilla.income.tax.bracket</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"active_test": false}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure los tramos del Impuesto sobre la Renta para asalariados.
            </p>
            <p>
                <strong>Regla importante:</strong> Solo puede haber tramos activos de UN ano fiscal a la vez.
                Para actualizar la tabla anual: desactive todos los tramos del ano anterior
                y active los del ano nuevo. El sistema valida que no haya mezclas de anos.
            </p>
            <p>Fuente: Resolución DGT del Ministerio de Hacienda (públicada cada enero).</p>
        </field>
    </record>
</odoo>
