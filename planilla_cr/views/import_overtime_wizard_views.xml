<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Vista draft: configuración ── -->
    <record id="view_import_overtime_wizard_form" model="ir.ui.view">
        <field name="name">planilla.import.overtime.wizard.form</field>
        <field name="model">planilla.import.overtime.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Horas Extras desde Asistencias">
                <sheet>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft'">
                        <strong>📋 Cómo funciona:</strong>
                        Se analizan las asistencias registradas en Odoo (Check-in / Check-out)
                        del periodo seleccionado. Por cada día donde el empleado trabajó más horas
                        que el umbral configurado, se genera un registro de horas extras pendiente
                        de revisión antes de importar.
                    </div>

                    <!-- Configuración -->
                    <group invisible="state != 'draft'">
                        <group string="Período y Filtros">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="branch_id"/>
                        </group>
                        <group string="Parámetros de Cálculo">
                            <field name="hours_per_day"/>
                            <field name="min_extra_minutes"/>
                            <field name="overtime_type"/>
                        </group>
                    </group>

                    <!-- Vista previa -->
                    <group invisible="state != 'preview'">
                        <group string="Resultado del análisis">
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="overtime_type" readonly="1"/>
                            <field name="hours_per_day" readonly="1"/>
                        </group>
                    </group>
                    <field name="preview_ids" invisible="state != 'preview'">
                        <list editable="top" decoration-muted="already_imported == True">
                            <field name="selected"/>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="hours_worked"/>
                            <field name="hours_extra"/>
                            <field name="overtime_type"/>
                            <field name="already_imported" string="Ya existe"/>
                        </list>
                    </field>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'preview'">
                        Las filas en gris ya tienen un registro de horas extras para esa fecha.
                        Deselecciónelas o serán omitidas automáticamente.
                    </div>
                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_preview" type="object"
                            string="Analizar Asistencias" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_import" type="object"
                            string="Importar Horas Extras Seleccionadas" class="btn-success"
                            invisible="state != 'preview'"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_overtime_wizard" model="ir.actions.act_window">
        <field name="name">Importar Horas Extras desde Asistencias</field>
        <field name="res_model">planilla.import.overtime.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
