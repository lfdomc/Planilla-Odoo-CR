<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_cr_list" model="ir.ui.view">
        <field name="name">planilla.payslip.cr.list</field>
        <field name="model">planilla.payslip.cr</field>
        <field name="arch" type="xml">
            <list string="Boletas de Pago"
                  decoration-success="state=='done'"
                  decoration-warning="state=='confirmed'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="payroll_calendar_id" string="Calendarización" optional="hide"/>
                <field name="date_from" string="Desde"/>
                <field name="date_to" string="Hasta"/>
                <field name="gross_salary" string="Salario Bruto"/>
                <field name="ccss_employee" string="CCSS Obrero" optional="hide"/>
                <field name="income_tax" string="Imp. Renta" optional="hide"/>
                <field name="total_employee_deductions" string="Total Deducciones"/>
                <field name="net_salary" string="Salario Neto"/>
                <field name="salary_payable" string="Salario a Pagar" optional="show"
                       help="Neto menos préstamos y deducciones adicionales — lo que se deposita"/>
                <field name="total_employer_cost" string="Costo Total Patronal" optional="hide"/>
                <field name="cost_per_net_colon" string="₡ Costo/₡ Neto"
                       widget="float" digits="[6,2]" optional="show"
                       help="Por cada ₡1 neto que recibe el empleado, la empresa gasta este monto total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_cr_form" model="ir.ui.view">
        <field name="name">planilla.payslip.cr.form</field>
        <field name="model">planilla.payslip.cr</field>
        <field name="arch" type="xml">
            <form string="Boleta de Pago">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_sync_novedades" type="object"
                            string="Sincronizar Novedades"
                            invisible="state != 'draft'"
                            class="btn-secondary"/>
                    <button name="action_reset_to_draft" type="object" string="Volver a Borrador"
                            invisible="state not in ('cancelled', 'confirmed')"
                            class="btn-warning"/>
                    <button name="action_pay" type="object" string="Marcar como Pagado"
                            invisible="state != 'confirmed'" class="btn-success"/>
                    <button name="action_send_payslip" type="object" string="Enviar por Correo"
                            invisible="state != 'done'"/>
                    <button name="action_print_payslip" type="object" string="Imprimir"
                            invisible="state == 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <!-- Alerta salario variable: empleado con comisiones sin bonos en boleta -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not employee_id or not employee_id.has_variable_income or bono_salarial_amount > 0">
                        <i class="fa fa-exclamation-triangle" title="Advertencia: empleado con salario variable"/>
                        <strong>Empleado con Salario Variable:</strong>
                        Este empleado tiene comisiones o ingresos variables configurados,
                        pero esta boleta no tiene bonos/comisiones registrados en el período.
                        Si corresponde, registre las comisiones en
                        <strong>Novedades → Bonos → tipo "Comisión por Ventas"</strong>
                        y luego sincronice la boleta con el botón ↺.
                    </div>

                    <!-- Encabezado -->
                    <group>
                        <group string="Empleado">
                            <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="payroll_run_id"/>
                            <field name="payroll_calendar_id" readonly="1"/>
                        </group>
                        <group string="Período">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="calculation_method" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- ══ RESUMEN GENERAL ══════════════════════════════════ -->
                        <page string="Ingresos" name="income">
                            <group>
                                <!-- Salario base y proporcionalidad -->
                                <group string="Salario">
                                    <field name="base_salary" readonly="1"/>
                                    <field name="is_proportional"
                                           readonly="state != 'draft'"/>
                                    <field name="days_worked" invisible="not is_proportional"
                                           readonly="state != 'draft'"/>
                                    <field name="days_in_period" readonly="1" invisible="not is_proportional"/>
                                    <field name="proportional_factor" readonly="1"
                                           invisible="not is_proportional" string="Factor proporcional (%)"/>
                                </group>
                                <!-- Otros ingresos del período -->
                                <group string="Ingresos Adicionales">
                                    <field name="overtime_amount" readonly="1"/>
                                    <field name="vacation_amount" readonly="1"/>
                                    <field name="other_income"
                                           readonly="state != 'draft'"/>
                                    <field name="gross_salary" readonly="1" class="fw-bold"/>
                                </group>
                            </group>

                            <!-- Incapacidades del período -->
                            <separator string="Incapacidades del Período"/>
                            <group invisible="disability_days == 0">
                                <group string="Resumen Incapacidades">
                                    <field name="disability_days" readonly="1"/>
                                    <field name="ccss_subsidy_total" readonly="1"/>
                                    <field name="employer_disability_cost" readonly="1"/>
                                </group>
                            </group>
                            <field name="disability_ids" readonly="1"
                                   invisible="disability_days == 0">
                                <list>
                                    <field name="disability_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days"/>
                                    <field name="ccss_subsidy"/>
                                    <field name="employer_cost"/>
                                    <field name="certificate_number"/>
                                </list>
                            </field>
                            <div invisible="disability_days != 0"
                                 style="color:#999;font-size:12px;padding:4px 0;">
                                Sin incapacidades en este período.
                            </div>

                            <!-- Vacaciones del período -->
                            <separator string="Vacaciones del Período"/>
                            <field name="vacation_ids" readonly="1">
                                <list>
                                    <field name="vacation_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days"/>
                                    <field name="total_amount"/>
                                </list>
                            </field>

                            <!-- Licencias Especiales del período -->
                            <separator string="Licencias Especiales del Período"
                                       invisible="leave_cr_ids == []"/>
                            <field name="leave_cr_ids" readonly="1"
                                   invisible="leave_cr_ids == []">
                                <list decoration-success="has_salary == True"
                                      decoration-warning="has_salary == False">
                                    <field name="leave_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days"/>
                                    <field name="working_days" string="Días Hábiles"/>
                                    <field name="has_salary" string="Con Goce" widget="boolean_toggle"/>
                                    <field name="leave_amount" string="Monto"/>
                                </list>
                            </field>

                            <!-- Asistencias (solo si aplica) -->
                            <separator string="Asistencias"
                                       invisible="calculation_method != 'attendance'"/>
                            <group invisible="calculation_method != 'attendance'">
                                <field name="attendance_hours" readonly="1"/>
                                <field name="attendance_details" readonly="1"
                                       string="Detalle por día"/>
                            </group>

                            <!-- Contabilidad -->
                            <separator string="Contabilidad" invisible="not move_id"/>
                            <group invisible="not move_id">
                                <field name="move_id" readonly="1"/>
                            </group>
                        </page>

                        <!-- ══ DEDUCCIONES OBRERO ════════════════════════════════ -->
                        <page string="Deducciones Obrero" name="employee_deductions">
                            <group>
                                <group string="Deducciones Legales">
                                    <field name="ccss_employee" readonly="1"/>
                                    <field name="income_tax" readonly="1"/>
                                    <field name="other_deductions"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group string="Total Obrero">
                                    <field name="total_employee_deductions" readonly="1"
                                           class="fw-bold"/>
                                    <field name="net_salary" readonly="1"
                                           class="fw-bold text-success"/>
                                </group>
                            </group>

                            <!-- Préstamos, adelantos y deducciones adicionales -->
                            <separator string="Préstamos / Adelantos / Deducciones Adicionales"/>
                            <field name="deduction_line_ids">
                                <list editable="bottom">
                                    <field name="deduction_code_id"/>
                                    <field name="description"/>
                                    <field name="line_type"/>
                                    <field name="amount_type"/>
                                    <field name="amount"/>
                                    <field name="deduction_type" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- ══ CARGAS PATRONALES ════════════════════════════════ -->
                        <page string="Cargas Patronales" name="employer_costs">
                            <group>
                                <group string="Cargas Legales">
                                    <field name="ccss_employer" readonly="1"/>
                                    <field name="ins_employer" readonly="1"/>
                                    <field name="aguinaldo_provision" readonly="1"/>
                                    <field name="cesantia_provision" readonly="1"/>
                                    <field name="vacation_provision" readonly="1"/>
                                </group>
                                <group string="Total Patronal">
                                    <field name="total_employer_cost" readonly="1"
                                           class="fw-bold"/>
                                </group>
                            </group>
                        </page>

                        <!-- ══ HORAS EXTRAS ═════════════════════════════════════ -->
                        <page string="Horas Extras" name="overtime">
                            <field name="overtime_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="overtime_type"/>
                                    <field name="hours"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <!-- ══ INCAPACIDADES (detalle completo) ════════════════ -->
                        <page string="Incapacidades" name="disabilities">
                            <group>
                                <group string="Resumen">
                                    <field name="disability_days" readonly="1"/>
                                    <field name="ccss_subsidy_total" readonly="1"/>
                                    <field name="employer_disability_cost" readonly="1"/>
                                </group>
                            </group>
                            <field name="disability_ids">
                                <list>
                                    <field name="disability_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days"/>
                                    <field name="subsidy_percentage"/>
                                    <field name="ccss_subsidy"/>
                                    <field name="employer_cost"/>
                                    <field name="certificate_number"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <!-- ══ VACACIONES (detalle completo) ═══════════════════ -->
                        <page string="Vacaciones" name="vacations">
                            <field name="vacation_ids">
                                <list>
                                    <field name="vacation_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days"/>
                                    <field name="daily_salary"/>
                                    <field name="total_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <!-- ══ LICENCIAS ESPECIALES ══════════════════════════════ -->
                        <page string="Licencias Especiales" name="licencias_cr">
                            <field name="leave_cr_ids" readonly="1">
                                <list decoration-success="has_salary == True"
                                      decoration-warning="has_salary == False">
                                    <field name="leave_type"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="days"/>
                                    <field name="working_days"/>
                                    <field name="has_salary" string="Con Goce" widget="boolean_toggle"/>
                                    <field name="leave_amount" string="Monto"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="leave_cr_ids != []">
                                No hay licencias especiales vinculadas a esta boleta.
                                Las licencias aprobadas se sincronizan automáticamente
                                al generar o recalcular la boleta.
                            </div>
                        </page>

                        <!-- ══ OBSERVACIONES ════════════════════════════════════ -->
                        <page string="Observaciones" name="notes">
                            <field name="notes"
                                   placeholder="Observaciones adicionales del período..."
                                   style="min-height:80px;"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payslip_cr" model="ir.actions.act_window">
        <field name="name">Boletas de Pago</field>
        <field name="res_model">planilla.payslip.cr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
