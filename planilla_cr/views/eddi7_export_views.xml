<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario EDDI-7 -->
    <record id="view_eddi7_export_form" model="ir.ui.view">
        <field name="name">planilla.eddi7.export.form</field>
        <field name="model">planilla.eddi7.export</field>
        <field name="arch" type="xml">
            <form string="Exportacion EDDI-7 CCSS">
                <sheet>
                    <div class="oe_title">
                        <h1>Declaracion Mensual CCSS -- EDDI-7</h1>
                    </div>

                    <group string="Parametros de Exportacion">
                        <group>
                            <field name="company_id"/>
                            <field name="patron_number"
                                   placeholder="Ej: 123456789"
                                   help="9 digitos, sin guiones"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="include_maternity"/>
                        </group>
                    </group>

                    <group string="Resultado" invisible="state == 'draft'">
                        <group>
                            <field name="line_count"/>
                            <field name="total_salaries" widget="monetary"/>
                        </group>
                        <group>
                            <field name="eddi7_filename"/>
                            <field name="eddi7_file" widget="binary"
                                   filename="eddi7_filename"/>
                        </group>
                    </group>

                    <group string="Errores de Validacion"
                           invisible="not validation_errors">
                        <field name="validation_errors" nolabel="1"
                               widget="text" readonly="1"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_generate_eddi7"
                            string="Generar EDDI-7"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'generated'"/>
                    <button name="action_download"
                            string="Descargar Archivo"
                            type="object"
                            class="btn-success"
                            invisible="state == 'draft'"/>
                    <button name="action_generate_eddi7"
                            string="Regenerar"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button special="cancel" string="Cerrar"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Accion para abrir el wizard EDDI-7 -->
    <record id="action_eddi7_export" model="ir.actions.act_window">
        <field name="name">Exportar EDDI-7 CCSS</field>
        <field name="res_model">planilla.eddi7.export</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'medium'}</field>
    </record>

</odoo>
