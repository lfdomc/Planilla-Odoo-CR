<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ins_report_form" model="ir.ui.view">
        <field name="name">planilla.ins.report.form</field>
        <field name="model">planilla.ins.report</field>
        <field name="arch" type="xml">
            <form string="Reporte Planilla INS">
                <sheet>
                    <div class="oe_title">
                        <h2>Planilla INS — Riesgos del Trabajo</h2>
                        <p class="text-muted">
                            Reporte obligatorio para el INS. Presentar antes del día 10 de cada mes
                            via RT-Virtual (rtvirtual.grupoins.com).
                        </p>
                    </div>
                    <group>
                        <group string="Período">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="frequency"/>
                        </group>
                        <group string="Filtros">
                            <field name="company_id"/>
                            <field name="branch_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" type="object"
                            string="Generar PDF" class="btn-primary"/>
                    <button name="action_generate_excel" type="object"
                            string="Descargar Excel" class="btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ins_report_wizard" model="ir.actions.act_window">
        <field name="name">Planilla INS</field>
        <field name="res_model">planilla.ins.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
