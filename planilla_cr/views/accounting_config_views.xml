<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Vista Formulario ── -->
    <record id="view_planilla_accounting_config_form" model="ir.ui.view">
        <field name="name">planilla.accounting.config.form</field>
        <field name="model">planilla.accounting.config</field>
        <field name="arch" type="xml">
            <form string="Configuración Contable de Planilla">
                <header>
                    <button name="action_autocompletar_cuentas"
                            string="⚡ Autocompletar Cuentas CR"
                            type="object"
                            class="btn-primary"
                            help="Completa automáticamente las cuentas usando los códigos estándar del plan de cuentas de Costa Rica (l10n_cr). Solo rellena campos vacíos, no sobreescribe los ya configurados."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Configuración Contable de Planilla CR</h1>
                        <p class="text-muted">
                            Configure las cuentas contables para generar automáticamente los asientos de planilla.
                            El asiento sigue la estructura estándar de Costa Rica.
                        </p>
                    </div>

                    <group string="Opciones Especiales de Planilla">
                        <group>
                            <field name="overtime_fixed_8h"
                                   widget="boolean_toggle"
                                   string="HE: formula fija salario / 30 / 8h"
                                   help="ON = horas extra con salario/30/8h fijo. OFF = usa horas del tipo de horario del empleado."/>
                        </group>
                        <group>
                            <field name="show_vacation_on_payslip"
                                   widget="boolean_toggle"
                                   string="Mostrar saldo de vacaciones en boleta"
                                   help="ON = la boleta PDF muestra los días de vacaciones disponibles del empleado. OFF = no se muestra ese dato."/>
                        <field name="skip_ccss_on_termination"
                                   widget="boolean_toggle"
                                   string="Liquidaciones: no descontar CCSS obrero"
                                   help="ON = no descuenta CCSS en liquidaciones. OFF = descuenta CCSS normalmente."/>
                        </group>
                    </group>
                    <group string="Planilla — Configuración General">
                        <group string="Nuevas Planillas">
                            <field name="default_payroll_calendar_id"
                                   string="Calendarización por Defecto"/>
                        </group>
                        <group string="Asientos Contables">
                            <field name="accounting_entry_mode" widget="radio"/>
                        </group>
                    </group>
                    <group string="Vacaciones">
                        <group string="Método de Acumulación">
                            <field name="vacation_accrual_method" widget="radio"/>
                        </group>
                    </group>
                    <group string="Provisiones Patronales">
                        <group string="Cesantía">
                            <field name="cesantia_prov_mode" widget="radio"/>
                            <field name="cesantia_prov_rate"
                                   invisible="cesantia_prov_mode != 'custom'"
                                   string="Tasa fija (%)"/>
                        </group>
                    </group>
                    <group string="General">
                        <group>
                            <field name="company_id"/>
                            <field name="journal_id" domain="[('company_id', '=', company_id), ('type', 'in', ['general', 'purchase'])]"/>
                        </group>
                        <group string="Cálculo de Impuesto de Renta">
                            <field name="income_tax_base" widget="radio"/>
                            <div class="text-muted" colspan="2" invisible="income_tax_base == 'gross'">
                                <i class="fa fa-exclamation-triangle text-warning"/> La base <b>Bruto menos CCSS</b> no está reconocida expresamente por la DGT. El patrono asume la responsabilidad fiscal de su aplicación.
                            </div>
                        </group>
                    </group>


                    <!-- Representante RRHH para Constancias -->
                    <group string="Datos del Firmante (Constancias Laborales)">
                        <group>
                            <field name="hr_rep_name" placeholder="Lic. Juan Perez Garcia"/>
                            <field name="hr_rep_title" placeholder="Encargado de Recursos Humanos"/>
                        </group>
                        <group>
                            <field name="hr_rep_phone" placeholder="2222-3333"/>
                            <field name="hr_rep_email" placeholder="rrhh@empresa.cr"/>
                        </group>
                        <group>
                            <field name="hr_rep_location" placeholder="San Jose, Costa Rica" colspan="2"/>
                        </group>
                        <div class="alert alert-info" role="alert" colspan="2">
                            <i class="fa fa-info-circle" title="Información"/> Estos datos aparecen al pie de cada Constancia Laboral generada.
                            Si no se configuran, se usara el nombre y datos de la empresa.
                        </div>
                    </group>

                    <!-- Configuracion de Correo de Boletas -->
                    <group string="Correo de Boletas a Empleados">
                        <group string="Servidor y Remitente">
                            <field name="email_payslip_server_id"/>
                            <field name="email_payslip_from" placeholder="planilla@empresa.cr"/>
                            <field name="email_payslip_subject"/>
                            <field name="email_payslip_signature" placeholder="Recursos Humanos - Mundopet"/>
                        </group>
                        <group string="Prueba de Envio">
                            <div colspan="2">
                                <button name="action_test_email" type="object"
                                        string="Enviar correo de prueba a mi email"
                                        class="btn-secondary"/>
                                <div class="text-muted" style="font-size:12px; margin-top:6px;">
                                    Envia un correo de prueba a tu email para verificar
                                    que el servidor esta configurado correctamente.
                                    Si hay una boleta confirmada en el sistema, la adjunta como ejemplo.
                                </div>
                            </div>
                        </group>
                        <group string="Cuerpo del Correo" colspan="2">
                            <field name="email_payslip_body" widget="html" nolabel="1" colspan="2"/>
                            <div class="text-muted" colspan="2" style="font-size:11px;">
                                Variables: <code>{period}</code> = periodo del pago,
                                <code>{company}</code> = nombre de la empresa.
                            </div>
                        </group>
                    </group>

                    <!-- Beneficios Especiales de la Empresa -->
                    <group string="Beneficios Especiales">
                        <group string="Vacaciones Adicionales por Año (1 de enero)">
                            <field name="extra_vacation_days_enabled" widget="boolean_toggle"/>
                            <field name="extra_vacation_days_mode"
                                   invisible="not extra_vacation_days_enabled"
                                   widget="radio" string="Modalidad"/>
                            <field name="extra_vacation_days_amount"
                                   invisible="not extra_vacation_days_enabled"
                                   string="Días base"/>
                            <field name="extra_vacation_last_applied_year"
                                   readonly="1"
                                   invisible="not extra_vacation_days_enabled"
                                   string="Último año aplicado"/>

                            <!-- Ayuda modalidad fija -->
                            <div class="alert alert-info" role="alert" colspan="2"
                                 invisible="not extra_vacation_days_enabled or extra_vacation_days_mode != 'fixed'">
                                <i class="fa fa-info-circle" title="Información"/>
                                <strong>Modalidad fija:</strong>
                                El 1 de enero de cada año se acreditan
                                <strong><field name="extra_vacation_days_amount" nolabel="1" readonly="1"/> días</strong>
                                a <strong>todos</strong> los empleados activos por igual,
                                sin importar su antiguedad.
                                Art. 58 CT: beneficio superior al mínimo legal.
                            </div>

                            <!-- Ayuda modalidad por año laborado -->
                            <div class="alert alert-success" role="alert" colspan="2"
                                 invisible="not extra_vacation_days_enabled or extra_vacation_days_mode != 'per_year'">
                                <i class="fa fa-info-circle" title="Información"/>
                                <strong>Modalidad por año laborado:</strong>
                                El 1 de enero cada empleado recibe
                                <strong><field name="extra_vacation_days_amount" nolabel="1" readonly="1"/> días</strong>
                                por cada <strong>año completo</strong> de servicio.
                                Ejemplo: empleado con 3 anos de antiguedad recibe
                                3 x días base = total de días acreditados.
                                Empleados con menos de 1 año completo no reciben días.
                                Art. 58 CT: beneficio superior al mínimo legal.
                            </div>
                        </group>
                    </group>

                    <notebook>
                        <page string="Cuentas de Gasto (Débitos)" name="expense_accounts">
                            <div class="alert alert-info" role="alert">
                                <strong>Débitos del asiento:</strong> Estas cuentas registran el gasto de planilla en el período.
                                Aparecen en la columna DEBE del asiento contable.
                            </div>
                            <group>
                                <group string="Gastos de Nómina">
                                    <field name="account_salary_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_social_charges_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_vacation_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_aguinaldo_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_preaviso_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_cesantia_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_bono_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"
                                           help="Bonos salariales (productividad, asistencia, antigüedad, comisiones). Afectos CCSS y Renta. Si no se configura, usa Sueldos y Salarios."/>
                                    <field name="account_subsidio_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"
                                           help="Subsidios exentos (transporte hasta ₡74,000/mes, gastos de representación documentados). Si no se configura, usa Sueldos y Salarios."/>
                                    <field name="account_licencia_expense"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"
                                           help="Licencias especiales con goce: duelo 1er grado (3 días), paternidad (8 días), matrimonio (2 días), adopción (3 meses), etc. Ej: 630800. Si no se configura, usa Sueldos y Salarios."/>
                                </group>
                            </group>
                        </page>

                        <page string="Cuentas por Pagar (Créditos)" name="payable_accounts">
                            <div class="alert alert-info" role="alert">
                                <strong>Créditos del asiento:</strong> Estas cuentas registran los pasivos pendientes de pago.
                                Aparecen en la columna HABER del asiento contable.
                            </div>
                            <group>
                                <group string="Obligaciones con CCSS e Impuestos">
                                    <field name="account_ccss_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_ins_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_income_tax_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <!-- FIX v49 Bug 5: cuenta específica para subsidio CCSS por cobrar -->
                                    <field name="account_ccss_subsidy_receivable"
                                           options="{'no_create': True}"
                                           help="Cuenta activo corriente para el derecho de cobro del patrono ante la CCSS por subsidios de incapacidad (días 4+). Si no se configura, el sistema usa CCSS por Pagar como fallback."/>
                                </group>
                                <group string="Provisiónes y Salarios">
                                    <field name="account_aguinaldo_provision"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_cesantia_provision"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_vacation_provision"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_salary_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_loans_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_bank_disbursement"
                                           options="{'no_create': True}"
                                           help="Cuenta Banco/Caja para desembolso de préstamos (FIX B-05)"/>
                                    <field name="account_termination_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"/>
                                    <field name="account_pension_alimentaria_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"
                                           help="Pensiónes alimentarias retenidas pendientes de girar al Juzgado (Ley 8590). Cuenta separada para control judicial. Ej: 230950"/>
                                    <field name="account_embargo_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"
                                           help="Embargos judiciales retenidos pendientes de girar al Juzgado (Art. 172 CT). Cuenta separada para control judicial. Ej: 230960"/>
                                    <field name="account_cobro_empleado_payable"
                                           options="{'no_create': True}" domain="[('company_ids', 'in', company_id)]"
                                           help="Cobros al empleado retenidos (almuerzos, productos, uniformes, parqueo, etc.) pendientes de liquidar con el proveedor. Ej: 230970. Si no se configura usa Salarios por Pagar."/>
                                </group>
                            </group>
                        </page>

                        <page string="Vista Previa del Asiento" name="preview">
                            <div class="o_field_widget" style="padding: 10px;">
                                <table class="table table-sm table-bordered">
                                    <thead style="background:#1F4E79; color:#fff;">
                                        <tr>
                                            <th>Cuenta</th>
                                            <th class="text-end">Debe</th>
                                            <th class="text-end">Haber</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr style="background:#f8f9fa;">
                                            <td colspan="3"><strong>Gastos Administrativos</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Salarios (Gasto)</td>
                                            <td class="text-end">gross_salary</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td>Cargas Sociales (CCSS 26.83% + INS 1%)</td>
                                            <td class="text-end">ccss_patronal + ins</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td>Vacaciones (4.16%)</td>
                                            <td class="text-end">vacation_provisión</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td>Aguinaldo (8.33%)</td>
                                            <td class="text-end">aguinaldo_provisión</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td>Cesantía (5.33%)</td>
                                            <td class="text-end">cesantía_provisión</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td>Bonos e Incentivos Salariales ← 630600 (afectos CCSS/Renta)</td>
                                            <td class="text-end">si aplica</td>
                                            <td></td>
                                        </tr>
                                        <tr>
                                            <td>Subsidios al Personal ← 630700 (exentos CCSS/Renta hasta tope)</td>
                                            <td class="text-end">si aplica</td>
                                            <td></td>
                                        </tr>
                                        <tr style="background:#f8f9fa;">
                                            <td colspan="3"><strong>Pasivos por Planilla</strong></td>
                                        </tr>
                                        <tr>
                                            <td>Deducciónes CCSS por Pagar (Obrera 10.83% + Patronal 26.83%)</td>
                                            <td></td>
                                            <td class="text-end">ccss_obrero + ccss_patronal</td>
                                        </tr>
                                        <tr>
                                            <td>INS por Pagar</td>
                                            <td></td>
                                            <td class="text-end">ins</td>
                                        </tr>
                                        <tr>
                                            <td>Retención Renta por Pagar</td>
                                            <td></td>
                                            <td class="text-end">income_tax</td>
                                        </tr>
                                        <tr>
                                            <td>Provisión Aguinaldo</td>
                                            <td></td>
                                            <td class="text-end">aguinaldo_provisión</td>
                                        </tr>
                                        <tr>
                                            <td>Provisión Cesantía</td>
                                            <td></td>
                                            <td class="text-end">cesantía_provisión</td>
                                        </tr>
                                        <tr>
                                            <td>Provisión Vacaciones</td>
                                            <td></td>
                                            <td class="text-end">vacation_provisión</td>
                                        </tr>
                                        <tr>
                                            <td>Pensión Alimentaria Retenida ← 230950</td>
                                            <td></td>
                                            <td class="text-end">si aplica</td>
                                        </tr>
                                        <tr>
                                            <td>Embargo Judicial Retenido ← 230960</td>
                                            <td></td>
                                            <td class="text-end">si aplica</td>
                                        </tr>
                                        <tr>
                                            <td>Cuotas Préstamos Retenidos ← 230900</td>
                                            <td></td>
                                            <td class="text-end">si aplica</td>
                                        </tr>
                                        <tr>
                                            <td>Salarios por Pagar (Neto real a depositar)</td>
                                            <td></td>
                                            <td class="text-end">salary_payable</td>
                                        </tr>
                                        <tr style="background:#e8f0fe; font-weight:bold;">
                                            <td>TOTAL</td>
                                            <td class="text-end">= Costo Total Empresa</td>
                                            <td class="text-end">= Costo Total Empresa</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Vista Lista ── -->
    <record id="view_planilla_accounting_config_list" model="ir.ui.view">
        <field name="name">planilla.accounting.config.list</field>
        <field name="model">planilla.accounting.config</field>
        <field name="arch" type="xml">
            <list string="Configuración Contable">
                <field name="company_id"/>
                <field name="journal_id" domain="[('company_id', '=', company_id), ('type', 'in', ['general', 'purchase'])]"/>
                <field name="account_salary_expense"/>
                <field name="account_salary_payable"/>
                <field name="account_termination_payable"/>
            </list>
        </field>
    </record>

    <!-- ── Acción servidor que abre el registro existente o lo crea ── -->
    <record id="action_planilla_accounting_config_server" model="ir.actions.server">
        <field name="name">Configuración Contable</field>
        <field name="model_id" ref="model_planilla_accounting_config"/>
        <field name="binding_model_id" ref="model_planilla_accounting_config"/>
        <field name="state">code</field>
        <field name="code">
config = env['planilla.accounting.config'].search([('company_id', '=', env.company.id)], limit=1)
if config:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Configuración Contable de Planilla',
        'res_model': 'planilla.accounting.config',
        'view_mode': 'form',
        'res_id': config.id,
        'target': 'current',
    }
else:
    action = {
        'type': 'ir.actions.act_window',
        'name': 'Configuración Contable de Planilla',
        'res_model': 'planilla.accounting.config',
        'view_mode': 'form',
        'target': 'current',
        'context': {'default_company_id': env.company.id},
    }
        </field>
    </record>
</odoo>
