<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_calendar_list" model="ir.ui.view">
        <field name="name">planilla.calendar.list</field>
        <field name="model">planilla.calendar</field>
        <field name="arch" type="xml">
            <list string="Calendarizaciónes">
                <field name="name"/>
                <field name="frequency"/>
                <field name="payment_day"/>
                <field name="branch_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_payroll_calendar_form" model="ir.ui.view">
        <field name="name">planilla.calendar.form</field>
        <field name="model">planilla.calendar</field>
        <field name="arch" type="xml">
            <form string="Calendarización de Planilla">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                        </group>
                        <group string="Configuración de Pago">
                            <field name="frequency"/>
                            <field name="payment_day"/>
                            <field name="second_payment_day"
                                   invisible="frequency != 'biweekly'"/>
                        </group>
                    </group>
                    <group string="Deducciónes Aplicables">
                        <field name="deduction_code_ids" widget="many2many_tags"/>
                    </group>
                    <field name="note" placeholder="Notas adicionales..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payroll_calendar" model="ir.actions.act_window">
        <field name="name">Calendarizaciónes</field>
        <field name="res_model">planilla.calendar</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
