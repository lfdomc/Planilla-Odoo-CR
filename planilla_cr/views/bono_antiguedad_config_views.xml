<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bono_antiguedad_config_list" model="ir.ui.view">
        <field name="name">planilla.bono.antiguedad.config.list</field>
        <field name="model">planilla.bono.antiguedad.config</field>
        <field name="arch" type="xml">
            <list string="Configuración Bono de Antigüedad" editable="bottom">
                <field name="name"/>
                <field name="years_from" string="Desde (años)"/>
                <field name="years_to"   string="Hasta (años)" optional="show"/>
                <field name="amount_type" string="Cálculo"/>
                <field name="percentage"    string="%" optional="show"/>
                <field name="fixed_amount"  string="Monto (₡)" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bono_antiguedad_config_form" model="ir.ui.view">
        <field name="name">planilla.bono.antiguedad.config.form</field>
        <field name="model">planilla.bono.antiguedad.config</field>
        <field name="arch" type="xml">
            <form string="Bono de Antigüedad — Configuración">
                <sheet>
                    <group>
                        <group string="Empresa y Tramo">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="name"/>
                            <field name="years_from"/>
                            <field name="years_to" help="Dejar en 0 para 'en adelante'"/>
                            <field name="active"/>
                        </group>
                        <group string="Monto">
                            <field name="amount_type" widget="radio"/>
                            <field name="percentage"   invisible="amount_type != 'percentage'"/>
                            <field name="fixed_amount" invisible="amount_type != 'fixed'"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Antigüedad:</strong> Es salarial según el Art. 162 CT — afecta base CCSS y Renta.
                        El bono se crea automáticamente el día del aniversario laboral del empleado
                        con vigencia hasta el último día del mes del aniversario.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bono_antiguedad_config" model="ir.actions.act_window">
        <field name="name">Bono de Antigüedad — Tabla</field>
        <field name="res_model">planilla.bono.antiguedad.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay configuración de bono de antigüedad.
            </p>
            <p>
                Configure los tramos de años y el porcentaje o monto a pagar.
                El sistema creará automáticamente el bono cada aniversario laboral.
            </p>
        </field>
    </record>

    <menuitem id="menu_bono_antiguedad_config"
              name="Bono de Antigüedad (Tabla)"
              action="action_bono_antiguedad_config"
              parent="menu_planilla_cr_config"
              sequence="65"
              groups="planilla_cr.group_planilla_admin"/>

</odoo>
