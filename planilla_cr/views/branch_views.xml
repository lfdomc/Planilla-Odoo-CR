<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_branch_list" model="ir.ui.view">
        <field name="name">planilla.branch.list</field>
        <field name="model">planilla.branch</field>
        <field name="arch" type="xml">
            <list string="Sucursales" decoration-info="is_temporary == True">
                <field name="code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="employee_count"/>
                <field name="is_temporary" string="Temporal" widget="boolean_toggle"/>
                <field name="project_end_date" string="Cierre Estimado" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_branch_form" model="ir.ui.view">
        <field name="name">planilla.branch.form</field>
        <field name="model">planilla.branch</field>
        <field name="arch" type="xml">
            <form string="Sucursal">
                <header>
                    <button name="action_view_employees" type="object"
                            string="Ver Empleados" class="btn-secondary"/>
                    <button name="action_archive_temporary" type="object"
                            string="Cerrar Sucursal Temporal" class="btn-danger"
                            invisible="not is_temporary or not active"
                            confirm="¿Cerrar esta sucursal temporal? Se archivará (no se elimina el historial de nombramientos/boletas que la referencian). Podrá reactivarla desde Archivados si es necesario."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Empleados"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Temporal" bg_color="bg-info"
                            invisible="not is_temporary"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <group string="Sucursal Temporal (obras / proyectos)">
                        <group>
                            <field name="is_temporary" widget="boolean_toggle"/>
                            <field name="project_end_date"
                                   invisible="not is_temporary"/>
                        </group>
                        <group>
                            <div class="text-muted" invisible="not is_temporary">
                                Las sucursales temporales se pueden cerrar
                                (archivar) desde el botón "Cerrar Sucursal
                                Temporal" en el encabezado cuando el
                                proyecto termine. El historial de
                                nombramientos y boletas asociado se
                                conserva.
                            </div>
                        </group>
                    </group>
                    <group string="Coordenadas GPS (validación de asistencia)">
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                Si el módulo de Reconocimiento Facial tiene
                                un kiosco con GPS complementario activado
                                vinculado a esta sucursal, estas
                                coordenadas se usan para validar que las
                                marcaciones ocurran dentro del radio
                                permitido.
                            </div>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_branch_search" model="ir.ui.view">
        <field name="name">planilla.branch.search</field>
        <field name="model">planilla.branch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Temporales" name="temporary"
                        domain="[('is_temporary','=',True)]"/>
                <filter string="Permanentes" name="permanent"
                        domain="[('is_temporary','=',False)]"/>
                <filter string="Archivadas" name="inactive"
                        domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_branch" model="ir.actions.act_window">
        <field name="name">Sucursales</field>
        <field name="res_model">planilla.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
