<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_branch_list" model="ir.ui.view">
        <field name="name">planilla.branch.list</field>
        <field name="model">planilla.branch</field>
        <field name="arch" type="xml">
            <list string="Sucursales">
                <field name="code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="employee_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_branch_form" model="ir.ui.view">
        <field name="name">planilla.branch.form</field>
        <field name="model">planilla.branch</field>
        <field name="arch" type="xml">
            <form string="Sucursal">
                <header>
                    <button name="action_view_employees" type="object"
                            string="Ver Empleados" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Empleados"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_branch" model="ir.actions.act_window">
        <field name="name">Sucursales</field>
        <field name="res_model">planilla.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
