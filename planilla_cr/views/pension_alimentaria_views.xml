<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── FORM ─────────────────────────────────────────────────── -->
    <record id="view_pension_alimentaria_form" model="ir.ui.view">
        <field name="name">planilla.pension.alimentaria.form</field>
        <field name="model">planilla.pension.alimentaria</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Pensión Alimentaria">
                <header>
                    <button name="action_suspend" string="Suspender"
                            type="object" class="btn-warning"
                            invisible="state != 'active'"/>
                    <button name="action_reactivate" string="Reactivar"
                            type="object" class="btn-success"
                            invisible="state != 'suspended'"/>
                    <button name="action_end" string="Terminar"
                            type="object"
                            invisible="state == 'ended'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,suspended,ended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Empleado">
                            <field name="employee_id"/>
                            <field name="branch_id" readonly="1"/>
                        </group>
                        <group string="Período">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Datos Judiciales">
                        <group>
                            <field name="numero_expediente"/>
                            <field name="juzgado"/>
                            <field name="fecha_resolucion"/>
                        </group>
                    </group>
                    <group string="Beneficiario">
                        <group>
                            <field name="beneficiario_nombre"/>
                            <field name="beneficiario_relacion"/>
                            <field name="beneficiario_cuenta"/>
                        </group>
                    </group>
                    <group string="Monto de la Pensión">
                        <group>
                            <field name="calculation_type"/>
                            <field name="fixed_amount"
                                   invisible="calculation_type != 'fixed'"/>
                            <field name="percentage"
                                   invisible="calculation_type != 'percentage'"/>
                        </group>
                        <group>
                            <div class="alert alert-warning" role="alert">
                                <strong>⚠ Prioridad Legal:</strong> La pensión alimentaria
                                tiene prioridad sobre cualquier otra deducción (Ley 8590, Art. 59).
                                Se descuenta antes que embargos y préstamos.
                            </div>
                        </group>
                    </group>
                    <field name="notes" placeholder="Observaciones adicionales..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── LIST ─────────────────────────────────────────────────── -->
    <record id="view_pension_alimentaria_list" model="ir.ui.view">
        <field name="name">planilla.pension.alimentaria.list</field>
        <field name="model">planilla.pension.alimentaria</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Pensiónes Alimentarias"
                  decoration-danger="state=='ended'"
                  decoration-warning="state=='suspended'"
                  decoration-success="state=='active'">
                <field name="employee_id"/>
                <field name="beneficiario_nombre"/>
                <field name="beneficiario_relacion"/>
                <field name="numero_expediente"/>
                <field name="calculation_type"/>
                <field name="fixed_amount" optional="show"/>
                <field name="percentage" optional="show"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-warning="state=='suspended'"
                       decoration-danger="state=='ended'"/>
            </list>
        </field>
    </record>

    <!-- ── ACTION ───────────────────────────────────────────────── -->
    <record id="action_pension_alimentaria" model="ir.actions.act_window">
        <field name="name">Pensiónes Alimentarias</field>
        <field name="res_model">planilla.pension.alimentaria</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="view_pension_alimentaria_search" model="ir.ui.view">
        <field name="name">planilla.pension.alimentaria.search</field>
        <field name="model">planilla.pension.alimentaria</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="employee_id"/>
                <field name="date_start"/>
                <filter string="Activas"    name="active"   domain="[('state','=','active')]"/>
                <filter string="Suspendidas" name="suspended" domain="[('state','=','suspended')]"/>
                <filter string="Finalizadas" name="ended"    domain="[('state','=','ended')]"/>
                <separator/>
                <filter string="▾ Por Empleado" name="by_emp"  context="{'group_by':'employee_id'}"/>
                <filter string="▾ Por Estado"   name="by_state" context="{'group_by':'state'}"/>
                <separator/>
                <filter string="1ra Quincena (1-15)" name="q1"
                        domain="[('date_start', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date_start', '&lt;=', (context_today() + relativedelta(day=15)).strftime('%Y-%m-%d'))]"/>
                <filter string="2da Quincena (16-fin)" name="q2"
                        domain="[('date_start', '&gt;=', (context_today() + relativedelta(day=16)).strftime('%Y-%m-%d')),
                                 ('date_start', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Este mes" name="this_month"
                        domain="[('date_start', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date_start', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Mes pasado" name="last_month"
                        domain="[('date_start', '&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')),
                                 ('date_start', '&lt;=', (context_today() + relativedelta(months=-1, day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="▾ Por Mes"      name="by_month" context="{'group_by':'date_start:month'}"/>
                <filter string="▾ Por Quincena" name="by_week"  context="{'group_by':'date_start:week'}"/>
            </search>
        </field>
    </record>
</odoo>
