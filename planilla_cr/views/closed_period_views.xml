<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_closed_period_tree" model="ir.ui.view">
        <field name="name">planilla.closed.period.tree</field>
        <field name="model">planilla.closed.period</field>
        <field name="arch" type="xml">
            <list string="Períodos Cerrados" decoration-danger="True">
                <field name="name"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="closed_by"/>
                <field name="closed_date"/>
            </list>
        </field>
    </record>

    <record id="view_closed_period_form" model="ir.ui.view">
        <field name="name">planilla.closed.period.form</field>
        <field name="model">planilla.closed.period</field>
        <field name="arch" type="xml">
            <form string="Período Cerrado">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Cierre Planilla Marzo 2026"/></h1>
                    </div>
                    <group>
                        <group string="Alcance">
                            <field name="company_id"/>
                            <field name="branch_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Información de Cierre">
                            <field name="closed_by" readonly="1"/>
                            <field name="closed_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notas opcionales sobre este cierre..."/>
                    </group>
                    <div class="alert alert-warning" role="alert">
                        <strong>Atencion:</strong> Una vez creado un período cerrado,
                        no se podran confirmar ni crear boletas en ese rango de fechas.
                        Solo el Administrador puede eliminar períodos cerrados.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_closed_period" model="ir.actions.act_window">
        <field name="name">Períodos Cerrados</field>
        <field name="res_model">planilla.closed.period</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
