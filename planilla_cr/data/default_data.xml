<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ═══════════════════════════════════════════
         SUCURSALES
    ═══════════════════════════════════════════ -->
    <record id="branch_principal" model="planilla.branch">
        <field name="code">PRINCIPAL</field>
        <field name="name">Principal</field>
        <field name="active">True</field>
    </record>

    <!-- ═══════════════════════════════════════════
         ESTADOS DE EMPLEADO
    ═══════════════════════════════════════════ -->
    <record id="employee_status_activo" model="planilla.employee.status">
        <field name="code">ACT</field>
        <field name="name">Activo</field>
        <field name="is_active_payroll">True</field>
        <field name="active">True</field>
    </record>

    <record id="employee_status_vacaciones" model="planilla.employee.status">
        <field name="code">VAC</field>
        <field name="name">Vacaciones</field>
        <field name="is_active_payroll">True</field>
        <field name="active">True</field>
    </record>

    <record id="employee_status_incapacitado" model="planilla.employee.status">
        <field name="code">INC</field>
        <field name="name">Incapacitado</field>
        <field name="is_active_payroll">True</field>
        <field name="active">True</field>
    </record>

    <record id="employee_status_licencia" model="planilla.employee.status">
        <field name="code">LSG</field>
        <field name="name">Licencia Sin Goce</field>
        <field name="is_active_payroll">False</field>
        <field name="active">True</field>
    </record>

    <record id="employee_status_suspension" model="planilla.employee.status">
        <field name="code">SUS</field>
        <field name="name">Suspendido</field>
        <field name="is_active_payroll">False</field>
        <field name="active">True</field>
    </record>

    <record id="employee_status_periodo_prueba" model="planilla.employee.status">
        <field name="code">PPR</field>
        <field name="name">Período de Prueba</field>
        <field name="is_active_payroll">True</field>
        <field name="active">True</field>
    </record>

    <record id="employee_status_renunciante" model="planilla.employee.status">
        <field name="code">REN</field>
        <field name="name">Renunciante</field>
        <field name="is_active_payroll">False</field>
        <field name="active">True</field>
    </record>

    <record id="employee_status_despedido" model="planilla.employee.status">
        <field name="code">DES</field>
        <field name="name">Despedido</field>
        <field name="is_active_payroll">False</field>
        <field name="active">True</field>
    </record>

    <!-- ═══════════════════════════════════════════
         TIPOS DE EMPLEADO
    ═══════════════════════════════════════════ -->
    <record id="employee_type_indefinido" model="planilla.employee.type">
        <field name="code">IND</field>
        <field name="name">Empleado Indefinido</field>
        <field name="contract_type">indefinido</field>
        <field name="apply_ccss">True</field>
        <field name="apply_ins">True</field>
        <field name="apply_income_tax">True</field>
        <field name="active">True</field>
    </record>

    <record id="employee_type_plazo_fijo" model="planilla.employee.type">
        <field name="code">PLF</field>
        <field name="name">Empleado Plazo Fijo</field>
        <field name="contract_type">fijo</field>
        <field name="apply_ccss">True</field>
        <field name="apply_ins">True</field>
        <field name="apply_income_tax">True</field>
        <field name="active">True</field>
    </record>

    <record id="employee_type_servicios_prof" model="planilla.employee.type">
        <field name="code">SRV</field>
        <field name="name">Servicios Profesionales</field>
        <field name="contract_type">servicios</field>
        <field name="apply_ccss">False</field>
        <field name="apply_ins">False</field>
        <field name="apply_income_tax">True</field>
        <field name="active">True</field>
    </record>

    <record id="employee_type_practicante" model="planilla.employee.type">
        <field name="code">PRC</field>
        <field name="name">Practicante</field>
        <field name="contract_type">practicante</field>
        <field name="apply_ccss">True</field>
        <field name="apply_ins">True</field>
        <field name="apply_income_tax">False</field>
        <field name="active">True</field>
    </record>

    <record id="employee_type_tiempo_parcial" model="planilla.employee.type">
        <field name="code">TPA</field>
        <field name="name">Tiempo Parcial</field>
        <field name="contract_type">fijo</field>
        <field name="apply_ccss">True</field>
        <field name="apply_ins">True</field>
        <field name="apply_income_tax">True</field>
        <field name="active">True</field>
    </record>

    <!-- ═══════════════════════════════════════════
         TIPOS DE HORARIO
         Base legal: Arts. 135-141 Código de Trabajo CR
         Jornada diurna máx: 8h/día, 48h/sem
         Jornada nocturna máx: 6h/día, 36h/sem
         Jornada mixta máx: 7h/día, 42h/sem
         Jornada acumulada: Art. 136 bis CT (4x10h o 3x12h)
    ═══════════════════════════════════════════ -->

    <!-- ── Jornadas estándar ─────────────────────────────────── -->
    <record id="schedule_type_completo" model="planilla.schedule.type">
        <field name="code">COMP</field>
        <field name="name">Jornada Completa (8 horas - Lun a Vie)</field>
        <field name="hours_per_day">8.0</field>
        <field name="hours_per_week">40.0</field>
        <field name="days_per_week">5</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Jornada diurna ordinaria. Art. 136 CT: máximo 8 horas diarias y 48 semanales. Factor HE: 1.5x.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_diurna_6dias" model="planilla.schedule.type">
        <field name="code">COMP6</field>
        <field name="name">Jornada Completa (8 horas - Lun a Sáb)</field>
        <field name="hours_per_day">8.0</field>
        <field name="hours_per_week">48.0</field>
        <field name="days_per_week">6</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Jornada diurna ordinaria 6 días. Art. 136 CT: máximo 48 horas semanales. Factor HE: 1.5x.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_mixta" model="planilla.schedule.type">
        <field name="code">MIXT</field>
        <field name="name">Jornada Mixta (7 horas)</field>
        <field name="hours_per_day">7.0</field>
        <field name="hours_per_week">42.0</field>
        <field name="days_per_week">6</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Jornada mixta. Art. 138 CT: combina horario diurno y nocturno. Máximo 7 horas diarias y 42 semanales.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_nocturna" model="planilla.schedule.type">
        <field name="code">NOCT</field>
        <field name="name">Jornada Nocturna (6 horas)</field>
        <field name="hours_per_day">6.0</field>
        <field name="hours_per_week">36.0</field>
        <field name="days_per_week">6</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Jornada nocturna. Art. 137 CT: horario entre las 19:00 y las 05:00. Máximo 6 horas diarias y 36 semanales.</field>
        <field name="active">True</field>
    </record>

    <!-- ── Jornadas acumuladas (Art. 136 bis CT) ─────────────── -->
    <record id="schedule_type_acumulada_4x10" model="planilla.schedule.type">
        <field name="code">ACU4</field>
        <field name="name">Jornada Acumulada 4x10 (10 horas - 4 días)</field>
        <field name="hours_per_day">10.0</field>
        <field name="hours_per_week">40.0</field>
        <field name="days_per_week">4</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Jornada acumulada 4x10. Art. 136 bis CT: 4 días de 10 horas con 3 días libres. Requiere acuerdo escrito entre patrono y trabajador.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_acumulada_3x12" model="planilla.schedule.type">
        <field name="code">ACU3</field>
        <field name="name">Jornada Acumulada 3x12 (12 horas - 3 días)</field>
        <field name="hours_per_day">12.0</field>
        <field name="hours_per_week">36.0</field>
        <field name="days_per_week">3</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Jornada acumulada 3x12. Art. 136 bis CT: 3 días de 12 horas con 4 días libres. Frecuente en salud, seguridad y servicios continuos.</field>
        <field name="active">True</field>
    </record>

    <!-- ── Tiempo parcial ────────────────────────────────────── -->
    <record id="schedule_type_medio_tiempo" model="planilla.schedule.type">
        <field name="code">MEDI</field>
        <field name="name">Medio Tiempo (4 horas)</field>
        <field name="hours_per_day">4.0</field>
        <field name="hours_per_week">20.0</field>
        <field name="days_per_week">5</field>
        <field name="overtime_factor">1.5</field>
        <field name="is_part_time">True</field>
        <field name="description">Jornada a tiempo parcial. Art. 136 CT: menos del 50% de la jornada ordinaria. Proporcional en salario, vacaciones y prestaciones.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_tres_cuartos" model="planilla.schedule.type">
        <field name="code">TRCR</field>
        <field name="name">Tres Cuartos (6 horas)</field>
        <field name="hours_per_day">6.0</field>
        <field name="hours_per_week">30.0</field>
        <field name="days_per_week">5</field>
        <field name="overtime_factor">1.5</field>
        <field name="is_part_time">True</field>
        <field name="description">Jornada parcial de 6 horas diurnas. Proporcional en salario, vacaciones y prestaciones según CT.</field>
        <field name="active">True</field>
    </record>

    <!-- ── Horarios especiales ───────────────────────────────── -->
    <record id="schedule_type_confianza" model="planilla.schedule.type">
        <field name="code">CONF</field>
        <field name="name">Horario de Confianza</field>
        <field name="hours_per_day">8.0</field>
        <field name="hours_per_week">40.0</field>
        <field name="days_per_week">5</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Puestos de confianza o dirección. Art. 143 CT: exentos del límite de jornada ordinaria. Aplica a gerentes, directores y personal de alta dirección.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_guardias_24" model="planilla.schedule.type">
        <field name="code">GRD24</field>
        <field name="name">Guardias / Turnos 24 horas</field>
        <field name="hours_per_day">12.0</field>
        <field name="hours_per_week">42.0</field>
        <field name="days_per_week">3</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Personal de vigilancia y guardias de seguridad. Turnos de 24 horas con descanso. Verificar convenio colectivo o contrato individual aplicable.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_rotativo" model="planilla.schedule.type">
        <field name="code">ROTA</field>
        <field name="name">Turno Rotativo (Mañana / Tarde / Noche)</field>
        <field name="hours_per_day">8.0</field>
        <field name="hours_per_week">40.0</field>
        <field name="days_per_week">5</field>
        <field name="overtime_factor">1.5</field>
        <field name="description">Turno rotativo en tres jornadas. El factor nocturno aplica según el horario real de cada turno (Art. 137 CT). Común en manufactura, salud y call centers.</field>
        <field name="active">True</field>
    </record>

    <record id="schedule_type_fines_semana" model="planilla.schedule.type">
        <field name="code">FDSM</field>
        <field name="name">Fines de Semana (Sáb y Dom)</field>
        <field name="hours_per_day">8.0</field>
        <field name="hours_per_week">16.0</field>
        <field name="days_per_week">2</field>
        <field name="overtime_factor">2.0</field>
        <field name="description">Trabajo exclusivo en fines de semana. Factor HE 2.0x por ser días de descanso obligatorio (Art. 152 CT). Proporcional en prestaciones.</field>
        <field name="active">True</field>
    </record>

    <!-- ═══════════════════════════════════════════
         CALENDARIZACIONES DE PAGO
    ═══════════════════════════════════════════ -->
    <record id="payroll_calendar_mensual" model="planilla.calendar">
        <field name="name">Mensual</field>
        <field name="frequency">monthly</field>
        <field name="payment_day">30</field>
        <field name="active">True</field>
    </record>

    <record id="payroll_calendar_quincenal" model="planilla.calendar">
        <field name="name">Quincenal</field>
        <field name="frequency">biweekly</field>
        <field name="payment_day">15</field>
        <field name="second_payment_day">30</field>
        <field name="active">True</field>
    </record>

    <record id="payroll_calendar_semanal" model="planilla.calendar">
        <field name="name">Semanal</field>
        <field name="frequency">weekly</field>
        <field name="payment_day">5</field>
        <field name="active">True</field>
    </record>

</odoo>
