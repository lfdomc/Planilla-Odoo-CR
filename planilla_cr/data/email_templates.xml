<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Plantilla: Boleta pagada al empleado -->
    <record id="email_template_payslip_paid" model="mail.template">
        <field name="name">Planilla CR — Boleta de Pago</field>
        <field name="model_id" ref="planilla_cr.model_planilla_payslip_cr"/>
        <field name="subject">Su boleta de pago está disponible — {{ object.date_from }} al {{ object.date_to }}</field>
        <field name="email_to">{{ object.employee_id.work_email }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;">
    <div style="background:#1F4E79;color:white;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">Su Boleta de Pago está disponible</h2>
        <p style="margin:6px 0 0;opacity:.9;font-size:13px;">{{ object.company_id.name }}</p>
    </div>
    <div style="background:#F8FAFC;padding:20px;border:1px solid #E2E8F0;border-top:none;border-radius:0 0 6px 6px;">
        <p>Estimado/a <strong>{{ object.employee_id.name }}</strong>,</p>
        <p>Su boleta de pago correspondiente al período <strong>{{ object.date_from }}</strong> al <strong>{{ object.date_to }}</strong> ha sido procesada.</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#1F4E79;color:white;">
                <th style="padding:8px 12px;text-align:left;">Concepto</th>
                <th style="padding:8px 12px;text-align:right;">Monto</th>
            </tr>
            <tr style="background:#F0F4F8;">
                <td style="padding:7px 12px;">Salario Bruto</td>
                <td style="padding:7px 12px;text-align:right;">₡ {{ '%.2f'|format(object.gross_salary) }}</td>
            </tr>
            <tr>
                <td style="padding:7px 12px;">Total Deducciones</td>
                <td style="padding:7px 12px;text-align:right;color:#E74C3C;">- ₡ {{ '%.2f'|format(object.total_employee_deductions) }}</td>
            </tr>
            <tr style="background:#E8F8EF;font-weight:bold;">
                <td style="padding:8px 12px;border-top:2px solid #27AE60;">Salario Neto a Recibir</td>
                <td style="padding:8px 12px;text-align:right;color:#27AE60;border-top:2px solid #27AE60;">₡ {{ '%.2f'|format(object.net_salary) }}</td>
            </tr>
        </table>
        <p style="font-size:12px;color:#666;">Si tiene alguna consulta sobre su boleta, comuníquese con el departamento de Recursos Humanos.</p>
    </div>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Plantilla: Préstamo saldado -->
    <record id="email_template_loan_paid" model="mail.template">
        <field name="name">Planilla CR — Préstamo Saldado</field>
        <field name="model_id" ref="planilla_cr.model_planilla_employee_loan"/>
        <field name="subject">Su préstamo ha sido saldado completamente — {{ object.employee_id.company_id.name }}</field>
        <field name="email_to">{{ object.employee_id.work_email }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;">
    <div style="background:#27AE60;color:white;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">✅ Su préstamo ha sido saldado</h2>
        <p style="margin:6px 0 0;opacity:.9;font-size:13px;">{{ object.employee_id.company_id.name }}</p>
    </div>
    <div style="background:#F8FAFC;padding:20px;border:1px solid #E2E8F0;border-top:none;border-radius:0 0 6px 6px;">
        <p>Estimado/a <strong>{{ object.employee_id.name }}</strong>,</p>
        <p>Nos complace informarle que su préstamo ha sido completamente cancelado.</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#27AE60;color:white;">
                <th style="padding:8px 12px;text-align:left;">Detalle</th>
                <th style="padding:8px 12px;text-align:right;">Valor</th>
            </tr>
            <tr><td style="padding:7px 12px;">Monto Total</td><td style="padding:7px 12px;text-align:right;">₡ {{ '%.2f'|format(object.amount_total) }}</td></tr>
            <tr style="background:#F0F4F8;"><td style="padding:7px 12px;">Cuotas Descontadas</td><td style="padding:7px 12px;text-align:right;">{{ object.installments }}</td></tr>
            <tr style="font-weight:bold;background:#E8F8EF;"><td style="padding:8px 12px;border-top:2px solid #27AE60;">Saldo Pendiente</td><td style="padding:8px 12px;text-align:right;color:#27AE60;border-top:2px solid #27AE60;">₡ 0.00</td></tr>
        </table>
        <p style="font-size:12px;color:#666;">A partir del próximo período no se realizarán más descuentos por este concepto.</p>
    </div>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Plantilla: Aniversario laboral para RRHH -->
    <record id="email_template_anniversary" model="mail.template">
        <field name="name">Planilla CR — Aniversario Laboral</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="subject">🎂 Aniversario laboral: {{ object.name }} — {{ object.entry_date }}</field>
        <field name="email_to">{{ object.company_id.email or '' }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:20px;">
    <div style="background:#8E44AD;color:white;padding:16px 20px;border-radius:6px 6px 0 0;">
        <h2 style="margin:0;font-size:18px;">🎂 Aniversario Laboral</h2>
        <p style="margin:6px 0 0;opacity:.9;font-size:13px;">Recordatorio de RRHH — {{ object.company_id.name }}</p>
    </div>
    <div style="background:#F8FAFC;padding:20px;border:1px solid #E2E8F0;border-top:none;border-radius:0 0 6px 6px;">
        <p>El empleado <strong>{{ object.name }}</strong> cumple hoy su aniversario laboral.</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#8E44AD;color:white;">
                <th style="padding:8px 12px;text-align:left;">Detalle</th>
                <th style="padding:8px 12px;text-align:right;"></th>
            </tr>
            <tr><td style="padding:7px 12px;">Fecha de Ingreso</td><td style="padding:7px 12px;text-align:right;">{{ object.entry_date }}</td></tr>
            <tr style="background:#F0F4F8;"><td style="padding:7px 12px;">Años de Servicio</td><td style="padding:7px 12px;text-align:right;font-weight:bold;">{{ ((datetime.date.today() - object.entry_date).days // 365) }} año(s)</td></tr>
            <tr><td style="padding:7px 12px;">Sucursal</td><td style="padding:7px 12px;text-align:right;">{{ object.branch_id.name if object.branch_id else '—' }}</td></tr>
        </table>
        <div style="background:#F3E5F5;padding:12px;border-radius:4px;border-left:4px solid #8E44AD;">
            <strong>Acción requerida:</strong> Verificar el cálculo actualizado de cesantía
            y ajustar si corresponde según el nuevo año de antigüedad.
        </div>
    </div>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
