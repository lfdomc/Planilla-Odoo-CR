    <!-- FIX BUG-N06 v52: Feriados faltantes 2026 -->

    <!-- 1 de octubre: Día de la Cultura — PAGO OBLIGATORIO -->
    <!-- Art. 148 CT + Ley 8442 Art. 1: feriado de pago obligatorio. -->
    <!-- Trabajar este día devenga doble salario sin excepción. -->
    <record id="holiday_cr_2026_10_01" model="planilla.public.holiday">
        <field name="name">Día de la Cultura</field>
        <field name="date">2026-10-12</field>
        <field name="type">national</field>
        <field name="is_paid">True</field>
        <field name="note">Art. 148 CT + Ley 8442: feriado de pago OBLIGATORIO. Trabajar este día devuelve doble salario.</field>
    </record>

    <!-- 1 de diciembre: Dia de la Abolicion del Ejercito — NO OBLIGATORIO -->
    <!-- Ley No. 9803 (La Gaceta No.159, 2 julio 2020), texto oficial: -->
    <!-- "Se declara el 1 de diciembre de cada ano como Dia de la -->
    <!-- Abolicion del Ejercito" y reforma el Art. 148 CT para incluirlo -->
    <!-- expresamente como feriado de pago NO obligatorio, junto con el -->
    <!-- 2 de agosto (los dos feriados no obligatorios originales del -->
    <!-- articulo; el 31 de agosto se agrego despues via Ley 10050). -->
    <!-- FIX: el registro previo de este feriado tenia la fecha -->
    <!-- EQUIVOCADA (2 de diciembre en vez de 1 de diciembre) y ademas -->
    <!-- desaparecio por error en una edicion anterior de este archivo, -->
    <!-- dejando solo sus comentarios sin el record real, se corrige -->
    <!-- y se restaura aqui con la fecha y la ley correctas. -->
    <record id="holiday_cr_2026_12_01" model="planilla.public.holiday">
        <field name="name">Día de la Abolición del Ejército</field>
        <field name="date">2026-12-01</field>
        <field name="type">optional</field>
        <field name="is_paid">False</field>
        <field name="generates_double_pay">True</field>
        <field name="note">Ley No. 9803 (Art. 148 CT): feriado NO obligatorio. SI genera pago doble si se trabaja para empleados con salario mensual/quincenal (se agrega un salario sencillo para completar el doble); horas extra ese dia se pagan a tiempo y medio doble (valor triple).</field>
    </record>
    <!-- 31 de agosto: Dia de la Persona Negra y la Cultura Afrocostarricense — NO OBLIGATORIO -->
    <!-- Ley 10050 (aprobada 22 nov 2021): incorporo esta fecha al Art. 148 CT como -->
    <!-- feriado de pago NO obligatorio, junto con el 2 de agosto y el 1 de diciembre. -->
    <!-- Personas con salario mensual/quincenal: el dia ya viene incluido en el sueldo -->
    <!-- (no genera pago adicional si no se trabaja). Si se labora, se agrega un pago -->
    <!-- sencillo para completar el equivalente a doble. Personas con salario semanal -->
    <!-- en actividad NO comercial: sin obligacion de pago si no se trabaja. -->
    <record id="holiday_cr_2026_08_31" model="planilla.public.holiday">
        <field name="name">Día de la Persona Negra y la Cultura Afrocostarricense</field>
        <field name="date">2026-08-31</field>
        <field name="type">optional</field>
        <field name="is_paid">False</field>
        <field name="generates_double_pay">True</field>
        <field name="note">Ley 10050 (Art. 148 CT): feriado NO obligatorio (el dia libre sin trabajar no esta garantizado para todas las modalidades salariales), pero SI genera pago doble si se trabaja para empleados con salario mensual/quincenal -- confirmado con multiples fuentes legales actuales (MTSS, La Nacion, AG Legal, ATC Auditores). Si se trabaja, se agrega un salario sencillo para completar el pago doble.</field>
    </record>
</odoo>
