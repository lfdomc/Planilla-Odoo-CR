    <!-- FIX: el 2 de agosto tenia is_paid sin especificar (heredaba el
         default=True, "pago obligatorio"), pero es uno de los 3
         feriados NO obligatorios reales del Art. 148 CT (junto con el
         31 de agosto y el 1 de diciembre), confirmado con multiples
         fuentes legales actuales. SI genera pago doble al trabajarlo
         para salario mensual/quincenal, igual que el 31 de agosto. -->
    <record id="holiday_cr_2026_08_02" model="planilla.public.holiday">
        <field name="name">Virgen de los Ángeles</field>
        <field name="date">2026-08-02</field>
        <field name="type">optional</field>
        <field name="is_paid">False</field>
        <field name="generates_double_pay">True</field>
        <field name="note">Art. 148 CT: feriado NO obligatorio (uno de los 3 junto con 31 de agosto y 1 de diciembre). SI genera pago doble si se trabaja para salario mensual/quincenal.</field>
    </record>
