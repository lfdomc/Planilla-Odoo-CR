    <!-- FIX BUG-N06 v52: Feriados faltantes 2026 -->

    <!-- 1 de octubre: Día de la Cultura — PAGO OBLIGATORIO -->
    <!-- Art. 148 CT + Ley 8442 Art. 1: feriado de pago obligatorio. -->
    <!-- Trabajar este día devenga doble salario sin excepción. -->
    <record id="holiday_cr_2026_10_01" model="planilla.public.holiday">
        <field name="name">Día de la Cultura</field>
        <field name="date">2026-10-12</field>
        <field name="type">national</field>
        <field name="is_paid">True</field>
        <field name="note">Art. 148 CT + Ley 8442: feriado de pago OBLIGATORIO. Trabajar este día devuelve doble salario.</field>
    </record>

    <!-- 2 de diciembre: Abolición del Ejército — NO OBLIGATORIO (trasladable) -->
    <!-- Ley 8886: declarado feriado pero clasificado como NO obligatorio. -->
    <!-- El patrono puede: a) darlo como libre sin pago extra, -->
    <!--                   b) trasladarlo al lunes siguiente, -->
    <!--                   c) pactarlo con el trabajador. -->
    <!-- Si el empleado trabaja este día NO aplica pago doble automático. -->
    <record id="holiday_cr_2026_12_02" model="planilla.public.holiday">
        <field name="name">Abolición del Ejército</field>
        <field name="date">2026-12-02</field>
        <field name="type">optional</field>
        <field name="is_paid">False</field>
        <field name="note">Ley 8886: feriado NO obligatorio (trasladable). No genera pago doble. Consultar con su contador el tratamiento aplicable.</field>
    </record>
</odoo>
