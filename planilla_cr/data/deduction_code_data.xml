<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- CCSS Obrero (10.83%) -->
    <record id="deduction_ccss_employee" model="planilla.deduction.code">
        <field name="name">CCSS - Seguro Social (Obrero)</field>
        <field name="code">CCSS_OBR</field>
        <field name="deduction_type">employee</field>
        <field name="calculation_type">percentage</field>
        <field name="employee_percentage">10.83</field>
        <field name="employer_percentage">0.0</field>
        <field name="is_ccss">True</field>
        <field name="description">Cuota obrera CCSS: 5.5% SEM + 2.5% IVM + 1% IMAS + 0.5% Banco Popular + 0.17% Asignaciones Familiares + 1.0% FODESAF</field>
    </record>

    <!-- CCSS Patronal (26.83%) -->
    <record id="deduction_ccss_employer" model="planilla.deduction.code">
        <field name="name">CCSS - Seguro Social (Patronal)</field>
        <field name="code">CCSS_PAT</field>
        <field name="deduction_type">employer</field>
        <field name="calculation_type">percentage</field>
        <field name="employee_percentage">0.0</field>
        <field name="employer_percentage">26.83</field>
        <field name="is_ccss">True</field>
        <field name="description">Cuota patronal CCSS: 9.25% SEM + 3.84% IVM + 5.0% Asignaciones Familiares + 0.5% IMAS + 0.25% Banco Popular + 3.0% Pensiones Complementarias + 1.5% Desempleo + 2.83% otros</field>
    </record>

    <!-- INS Patronal — Tasas por Clase de Riesgo -->
    <record id="deduction_ins_employer" model="planilla.deduction.code">
        <field name="name">INS - Riesgos Laborales (Patronal)</field>
        <field name="code">INS_PAT</field>
        <field name="deduction_type">employer</field>
        <field name="calculation_type">percentage</field>
        <field name="employee_percentage">0.0</field>
        <field name="employer_percentage">1.49</field>
        <field name="is_ins">True</field>
        <field name="ins_rate_i">0.87</field>
        <field name="ins_rate_ii">1.49</field>
        <field name="ins_rate_iii">2.47</field>
        <field name="ins_rate_iv">4.13</field>
        <field name="ins_rate_v">6.88</field>
        <field name="ins_valid_from">2026-01-01</field>
        <field name="description">Seguro de riesgos laborales INS. Tasas por clase: I=0.87%, II=1.49%, III=2.47%, IV=4.13%, V=6.88%. Actualizar cuando INS emita nuevas tarifas.</field>
    </record>

    <!-- Impuesto de Renta -->
    <record id="deduction_income_tax" model="planilla.deduction.code">
        <field name="name">Impuesto sobre la Renta (Salarios)</field>
        <field name="code">RENTA</field>
        <field name="deduction_type">employee</field>
        <field name="calculation_type">table</field>
        <field name="employee_percentage">0.0</field>
        <field name="is_income_tax">True</field>
        <field name="description">Tabla progresiva MH: Exento hasta ₡929,000; 10% hasta ₡1,362,000; 15% hasta ₡2,414,000; 20% hasta ₡4,830,000; 25% en adelante</field>
    </record>

    <!-- Aguinaldo (provisión) -->
    <record id="deduction_aguinaldo" model="planilla.deduction.code">
        <field name="name">Provisión Aguinaldo</field>
        <field name="code">AGUINALDO</field>
        <field name="deduction_type">employer</field>
        <field name="calculation_type">percentage</field>
        <field name="employer_percentage">8.33</field>
        <field name="description">Provisión mensual aguinaldo: 1/12 del salario ordinario anual</field>
    </record>

    <!-- Cesantía (provisión) -->
    <record id="deduction_cesantia" model="planilla.deduction.code">
        <field name="name">Provisión Cesantía</field>
        <field name="code">CESANTIA</field>
        <field name="deduction_type">employer</field>
        <field name="calculation_type">percentage</field>
        <field name="employer_percentage">5.33</field>
        <field name="description">Provisión de auxilio de cesantía según Código de Trabajo CR</field>
    </record>

    <!-- Vacaciones (provisión) -->
    <record id="deduction_vacaciones" model="planilla.deduction.code">
        <field name="name">Provisión Vacaciones</field>
        <field name="code">VACACIONES</field>
        <field name="deduction_type">employer</field>
        <field name="calculation_type">percentage</field>
        <field name="employer_percentage">4.16</field>
        <field name="description">Provisión mensual de vacaciones: 12 días hábiles por año trabajado</field>
    </record>

    <!-- Préstamo / Adelanto de Salario (descuento automático) -->
    <record id="deduction_prestamo" model="planilla.deduction.code">
        <field name="name">Préstamo / Adelanto de Salario</field>
        <field name="code">PRESTAMO</field>
        <field name="deduction_type">employee</field>
        <field name="calculation_type">fixed</field>
        <field name="description">Descuento de cuotas de préstamos o adelantos de salario. Se aplica automáticamente según el plan de cuotas.</field>
    </record>
</odoo>
