<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!--
        Datos iniciales de Tipos de Cobro al Empleado.
        noupdate="1" → no se sobrescriben si el administrador los modifica.

        El código de deducción COBRO_EMP se crea aquí. Si ya existe
        en la base de datos, Odoo lo re-usa gracias al external ID.
    -->

    <!-- Código de deducción genérico para cobros al empleado -->
    <record id="deduction_code_cobro_empleado" model="planilla.deduction.code">
        <field name="name">Cobro al Empleado</field>
        <field name="code">COBRO_EMP</field>
        <field name="deduction_type">employee</field>
        <field name="description">Cobros varios al empleado: almuerzo, productos, uniformes, etc.</field>
    </record>

    <!-- ── Tipos de Cobro Predefinidos ───────────────────────────────── -->

    <!-- 1. Almuerzo Comedor — monto fijo por período -->
    <record id="charge_type_almuerzo_fijo" model="planilla.charge.type">
        <field name="name">Almuerzo Comedor (Fijo Mensual)</field>
        <field name="code">ALMUERZO_FIJO</field>
        <field name="charge_mode">fixed</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">período</field>
        <field name="subsidy_pct">0</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">10</field>
        <field name="description">Plan de almuerzo con monto fijo por período (quincenal/mensual).
Establecer el precio según el acuerdo patrono-empleado.</field>
    </record>

    <!-- 2. Almuerzo por días asistidos — cobro variable -->
    <record id="charge_type_almuerzo_dias" model="planilla.charge.type">
        <field name="name">Almuerzo Comedor (Por Días)</field>
        <field name="code">ALMUERZO_DIAS</field>
        <field name="charge_mode">per_unit</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">días</field>
        <field name="subsidy_pct">0</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">20</field>
        <field name="description">Cobro por comedor según días asistidos en el período.
Ingresar precio por día y cantidad de días al registrar el cobro.</field>
    </record>

    <!-- 3. Almuerzo con subsidio patronal -->
    <record id="charge_type_almuerzo_subsidiado" model="planilla.charge.type">
        <field name="name">Almuerzo Subsidiado (Empresa y Empleado)</field>
        <field name="code">ALMUERZO_SUBS</field>
        <field name="charge_mode">per_unit</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">días</field>
        <field name="subsidy_pct">50</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">30</field>
        <field name="description">La empresa subsidia el 50% del costo del almuerzo.
El empleado paga la otra mitad vía deducción en boleta.
Ajustar el % de subsidio según la política de la empresa.</field>
    </record>

    <!-- 4. Productos / Mercadería -->
    <record id="charge_type_productos" model="planilla.charge.type">
        <field name="name">Productos / Mercadería</field>
        <field name="code">PRODUCTOS</field>
        <field name="charge_mode">per_unit</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">unidades</field>
        <field name="subsidy_pct">0</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">40</field>
        <field name="description">Cobro por productos de la empresa adquiridos por el empleado
(tienda, bodega, inventario). Precio por unidad configurable por cobro.</field>
    </record>

    <!-- 5. Uniforme / Equipo de Trabajo -->
    <record id="charge_type_uniforme" model="planilla.charge.type">
        <field name="name">Uniforme / Equipo de Trabajo</field>
        <field name="code">UNIFORME</field>
        <field name="charge_mode">fixed</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">kit</field>
        <field name="subsidy_pct">0</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">50</field>
        <field name="description">Cobro por uniformes, equipo de protección u herramientas
entregadas al empleado. Monto fijo único o por período.</field>
    </record>

    <!-- 6. Parqueo / Estacionamiento -->
    <record id="charge_type_parqueo" model="planilla.charge.type">
        <field name="name">Parqueo / Estacionamiento</field>
        <field name="code">PARQUEO</field>
        <field name="charge_mode">fixed</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">período</field>
        <field name="subsidy_pct">0</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">60</field>
        <field name="description">Cobro por uso de parqueo de la empresa. Monto fijo por período.</field>
    </record>

    <!-- 7. Seguro Colectivo Voluntario -->
    <record id="charge_type_seguro" model="planilla.charge.type">
        <field name="name">Seguro Colectivo Voluntario</field>
        <field name="code">SEGURO_COLECT</field>
        <field name="charge_mode">fixed</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">período</field>
        <field name="subsidy_pct">0</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">70</field>
        <field name="description">Prima de seguro colectivo de vida, médico o dental
contratado por el empleado vía empresa. Monto fijo por período.</field>
    </record>

    <!-- 8. Cobro Genérico / Otro -->
    <record id="charge_type_otro" model="planilla.charge.type">
        <field name="name">Otro Cobro al Empleado</field>
        <field name="code">OTRO_COBRO</field>
        <field name="charge_mode">fixed</field>
        <field name="default_unit_price">0</field>
        <field name="unit_label">unidad</field>
        <field name="subsidy_pct">0</field>
        <field name="affects_ccss">False</field>
        <field name="deduction_code_id" ref="deduction_code_cobro_empleado"/>
        <field name="sequence">99</field>
        <field name="description">Tipo genérico para cobros que no encajan en las categorías anteriores.
Especificar el detalle en el campo de observaciones del cobro.</field>
    </record>

</odoo>
