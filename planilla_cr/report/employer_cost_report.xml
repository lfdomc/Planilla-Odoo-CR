<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_employer_cost_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="data" t-value="wizard._build_report_data()"/>
                <div class="page">
                    <meta charset="UTF-8"/>
                    <style>
                        body{font-family:Arial,sans-serif;font-size:10px;color:#333}
                        .hdr{background:#1F4E79;color:white;padding:10px 16px;border-radius:4px 4px 0 0;margin-bottom:14px}
                        .hdr h4{margin:0 0 3px;font-size:13px} .hdr p{margin:0;font-size:10px;opacity:.9}
                        table{width:100%;border-collapse:collapse;margin-bottom:10px}
                        th{background:#1F4E79;color:white;padding:5px 7px;font-size:9px;text-align:right}
                        th:first-child{text-align:left}
                        td{padding:4px 7px;border-bottom:1px solid #E8EDF2;font-size:9px;text-align:right}
                        td:first-child{text-align:left}
                        .grp td{background:#BDD7EE;font-weight:bold;border-top:1px solid #1F4E79}
                        .detail td{background:#F8FAFC;padding-left:14px}
                        .total-row td{background:#D9E1F2;font-weight:bold;border-top:2px solid #1F4E79;font-size:10px}
                        .kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px}
                        .kpi{background:#F0F4F8;padding:7px 10px;border-radius:3px;text-align:center}
                        .kpi-l{font-size:8px;text-transform:uppercase;color:#666;font-weight:bold}
                        .kpi-v{font-size:13px;font-weight:bold;color:#1F4E79}
                        .footer{margin-top:16px;font-size:8px;color:#888;border-top:1px solid #ddd;padding-top:6px}
                    </style>

                    <div class="hdr">
                        <h4>Reporte de Costos Patronales Consolidado</h4>
                        <p>
                            <t t-out="wizard.company_id.name"/> |
                            Período: <t t-out="str(wizard.date_from)"/> al <t t-out="str(wizard.date_to)"/> |
                            Sucursal: <t t-out="wizard.branch_id.name if wizard.branch_id else 'Todas'"/> |
                            Agrupado por: <t t-out="dict(wizard._fields['group_by'].selection).get(wizard.group_by, '')"/>
                        </p>
                    </div>

                    <!-- KPIs resumen -->
                    <div class="kpi-grid">
                        <div class="kpi">
                            <div class="kpi-l">Salario Bruto Total</div>
                            <div class="kpi-v">₡ <t t-out="'{:,.0f}'.format(data['totals']['gross'])"/></div>
                        </div>
                        <div class="kpi">
                            <div class="kpi-l">CCSS + INS Patronal</div>
                            <div class="kpi-v">₡ <t t-out="'{:,.0f}'.format(data['totals']['ccss_patronal'] + data['totals']['ins'])"/></div>
                        </div>
                        <div class="kpi">
                            <div class="kpi-l">Provisiones (Agu+Ces+Vac)</div>
                            <div class="kpi-v">₡ <t t-out="'{:,.0f}'.format(data['totals']['aguinaldo'] + data['totals']['cesantia'] + data['totals']['vacaciones'])"/></div>
                        </div>
                        <div class="kpi" style="background:#FDE8E8">
                            <div class="kpi-l">COSTO TOTAL EMPRESA</div>
                            <div class="kpi-v" style="color:#C0392B">₡ <t t-out="'{:,.0f}'.format(data['totals']['total_cost'])"/></div>
                        </div>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th style="width:22%">Grupo / Empleado</th>
                                <th>Bruto (₡)</th>
                                <th>CCSS Pat.</th>
                                <th>INS</th>
                                <th>Aguinaldo</th>
                                <th>Cesantía</th>
                                <th>Vacaciones</th>
                                <th style="background:#C0392B">COSTO TOTAL (₡)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['groups']" t-as="grp">
                                <tr class="grp">
                                    <td><t t-out="grp['label']"/></td>
                                    <td>₡ <t t-out="'{:,.0f}'.format(grp['gross'])"/></td>
                                    <td>₡ <t t-out="'{:,.0f}'.format(grp['ccss_patronal'])"/></td>
                                    <td>₡ <t t-out="'{:,.0f}'.format(grp['ins'])"/></td>
                                    <td>₡ <t t-out="'{:,.0f}'.format(grp['aguinaldo'])"/></td>
                                    <td>₡ <t t-out="'{:,.0f}'.format(grp['cesantia'])"/></td>
                                    <td>₡ <t t-out="'{:,.0f}'.format(grp['vacaciones'])"/></td>
                                    <td style="color:#C0392B;font-weight:bold">₡ <t t-out="'{:,.0f}'.format(grp['total_cost'])"/></td>
                                </tr>
                                <t t-if="wizard.group_by == 'branch'">
                                    <t t-foreach="grp['detail_rows']" t-as="d">
                                        <tr class="detail">
                                            <td>↳ <t t-out="d['employee']"/> <span style="color:#888;font-size:8px">(<t t-out="d['month']"/>)</span></td>
                                            <td><t t-out="'{:,.0f}'.format(d['gross'])"/></td>
                                            <td><t t-out="'{:,.0f}'.format(d['ccss_patronal'])"/></td>
                                            <td><t t-out="'{:,.0f}'.format(d['ins'])"/></td>
                                            <td><t t-out="'{:,.0f}'.format(d['aguinaldo'])"/></td>
                                            <td><t t-out="'{:,.0f}'.format(d['cesantia'])"/></td>
                                            <td><t t-out="'{:,.0f}'.format(d['vacaciones'])"/></td>
                                            <td style="color:#C0392B"><t t-out="'{:,.0f}'.format(d['total_cost'])"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                            <tr class="total-row">
                                <td>TOTAL GENERAL</td>
                                <td>₡ <t t-out="'{:,.0f}'.format(data['totals']['gross'])"/></td>
                                <td>₡ <t t-out="'{:,.0f}'.format(data['totals']['ccss_patronal'])"/></td>
                                <td>₡ <t t-out="'{:,.0f}'.format(data['totals']['ins'])"/></td>
                                <td>₡ <t t-out="'{:,.0f}'.format(data['totals']['aguinaldo'])"/></td>
                                <td>₡ <t t-out="'{:,.0f}'.format(data['totals']['cesantia'])"/></td>
                                <td>₡ <t t-out="'{:,.0f}'.format(data['totals']['vacaciones'])"/></td>
                                <td style="color:#C0392B;font-size:11px">₡ <t t-out="'{:,.0f}'.format(data['totals']['total_cost'])"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="footer">
                        Costos patronales: CCSS patronal + INS + provisiones de aguinaldo, cesantía y vacaciones.
                        Solo boletas en estado PAGADO. Generado por Planilla CR — Odoo 19.
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_employer_cost" model="ir.actions.report">
        <field name="name">Costos Patronales Consolidado</field>
        <field name="model">planilla.employer.cost.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_employer_cost_template</field>
        <field name="print_report_name">'CostosPatronales_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
</odoo>
