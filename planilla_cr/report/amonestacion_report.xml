<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="report_amonestacion_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc">
        <t t-set="doc" t-value="doc.sudo()"/>
        <t t-set="company" t-value="doc.company_id.sudo()"/>
        <t t-set="emp" t-value="doc.employee_id.sudo()"/>
        <t t-set="meses_es" t-value="{             1:'enero', 2:'febrero', 3:'marzo', 4:'abril', 5:'mayo', 6:'junio',             7:'julio', 8:'agosto', 9:'septiembre', 10:'octubre', 11:'noviembre', 12:'diciembre'         }"/>
        <t t-set="mes_texto" t-value="meses_es.get(doc.date.month, '')"/>
        <t t-set="cfg" t-value="doc.env['planilla.accounting.config'].sudo().search([('company_id','=',company.id)], limit=1)"/>
        <t t-set="location" t-value="doc.location or (cfg.hr_rep_location if cfg else '') or (company.city or 'Costa Rica')"/>
        <t t-set="firmante_nombre" t-value="doc.signed_by_name or (cfg.hr_rep_name if cfg else '') or company.name"/>
        <t t-set="firmante_titulo" t-value="doc.signed_by_title or (cfg.hr_rep_title if cfg else '') or 'Representante Legal'"/>

        <t t-call="web.external_layout">
            <main>
            <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; padding: 10px 20px; line-height: 1.7;">

                <!-- Encabezado: fecha + destinatario apilados -->
                <p style="margin-bottom: 16px;">
                    <strong><t t-out="location"/>,
                    <t t-out="doc.date.strftime('%d')"/> de <t t-out="mes_texto"/>
                    de <t t-out="doc.date.strftime('%Y')"/></strong>
                </p>
                <p style="margin-bottom: 4px;">Estimado(a) señor(a):</p>
                <p style="margin-bottom: 4px;"><strong><t t-out="emp.name"/></strong></p>
                <t t-if="emp.identification_id">
                    <p style="margin-bottom: 16px;">Cédula: <t t-out="emp.identification_id"/></p>
                </t>

                <p style="margin-bottom: 14px;">
                    <strong>Asunto: <t t-out="doc.subject"/></strong>
                </p>

                <!-- Cuerpo -->
                <p style="text-align: justify;">
                    Por este medio se le comunica formalmente una amonestación escrita,
                    con fundamento en el <strong><t t-out="doc.legal_basis or 'Artículo 71, inciso b) del Código de Trabajo'"/></strong>
                    y la jurisprudencia nacional, debido a:
                </p>

                <!-- Hechos específicos -->
                <t t-if="doc.specific_incidents">
                    <div style="margin: 12px 0 12px 20px; padding: 10px; border-left: 3px solid #1F4E79; background: #f8f9fa;">
                        <strong>Hechos específicos:</strong><br/>
                        <t t-out="doc.specific_incidents"/>
                    </div>
                </t>

                <!-- Cuerpo adicional -->
                <t t-if="doc.body">
                    <p style="text-align: justify; margin-top: 10px;">
                        <t t-out="doc.body"/>
                    </p>
                </t>

                <!-- Advertencia legal Art. 81 -->
                <p style="text-align: justify; margin-top: 10px;">
                    Se le recuerda que, conforme al artículo 81, inciso i) del Código de Trabajo,
                    el patrono está facultado para rescindir el contrato de trabajo sin responsabilidad
                    patronal en caso de incurrir en faltas repetidas de puntualidad u obligaciones contractuales,
                    una vez que el trabajador haya sido debidamente amonestado por escrito, como ocurre en este caso.
                </p>

                <!-- Consecuencias -->
                <p style="text-align: justify; margin-top: 10px;">
                    <t t-out="doc.consequences or 'De persistir la situación, se tomarán medidas disciplinarias más severas, incluyendo la posibilidad de suspensión o despido, conforme a derecho.'"/>
                </p>

                <p style="margin-top: 10px;">Atentamente,</p>

                <!-- Firma -->
                <div style="margin-top: 50px; margin-bottom: 30px;">
                    <div style="border-top: 1px solid #000; width: 280px; padding-top: 6px;">
                        <strong><t t-out="firmante_nombre"/></strong><br/>
                        <t t-out="firmante_titulo"/>
                    </div>
                </div>

                <!-- Recibido por el trabajador — sin cuadro, solo lineas -->
                <div style="margin-top: 40px;">
                    <p style="margin: 0 0 20px 0; font-size: 11px; border-top: 1px solid #000; padding-top: 6px;">
                        <strong>RECIBIDO POR EL TRABAJADOR</strong>
                        <span style="font-size: 10px; color: #666; margin-left: 8px;">
                            (La firma no implica aceptación de los hechos, sino únicamente la recepción del documento.)
                        </span>
                    </p>
                    <p style="margin-bottom: 40px;">
                        Nombre y apellidos: _______________________________________    
                        Cédula: ______________________
                    </p>
                    <p>
                        <span style="border-top: 1px solid #000; padding-top: 4px; display: inline-block; width: 260px;">
                            Firma
                        </span>
                                
                        Fecha: ______________________
                    </p>
                </div>

                <!-- Espacio para adjuntos -->
                <div style="margin-top: 30px; border-top: 1px dashed #ccc; padding-top: 10px;">
                    <p style="font-size: 11px; color: #888; margin: 0;">
                        Adjuntar pruebas y evidencias al dorso de este documento.
                    </p>
                </div>

                <p style="font-size: 9px; color: #aaa; margin-top: 20px;">
                    Planilla CR v5.28 | Odoo 19 | Legislación Costa Rica
                </p>
                <div class="page_break"/>
            </div>
            </main>
        </t>
        </t>
    </t></template>

    <record id="action_report_amonestacion" model="ir.actions.report">
        <field name="name">Amonestación Escrita</field>
        <field name="model">planilla.amonestacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_amonestacion_document</field>
        <field name="report_file">planilla_cr.report_amonestacion_document</field>
        <field name="binding_model_id" ref="model_planilla_amonestacion"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">'Amonestacion_%s' % (object.employee_id.name or '').replace(' ', '_')</field>
    </record>
</odoo>
