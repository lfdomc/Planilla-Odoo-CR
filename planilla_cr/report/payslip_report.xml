<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="report_payslip_cr_document">
        <t t-call="web.html_container"><t t-set="company" t-value="docs[0].company_id if docs else env.company"/>
        <t t-call="web.external_layout">
            <main>
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; max-width: 520px; margin: 0 auto;">

                    <!-- ENCABEZADO EMPRESA -->
                    <t t-set="freq_label" t-value="                         'Quincenal' if doc.effective_frequency == 'biweekly' else                         'Semanal' if doc.effective_frequency == 'weekly' else                         'Bimensual' if doc.effective_frequency == 'bimonthly' else                         'Mensual'                     "/>
                    <div style="text-align:center; border:1px solid #000; padding:8px 12px 6px 12px; margin-bottom:0;">
                        <div style="font-weight:bold; font-size:13px; text-transform:uppercase;">
                            <t t-out="doc.company_id.name"/>
                        </div>
                        <t t-if="doc.branch_id">
                            <div style="font-size:11px;"><t t-out="doc.branch_id.name"/></div>
                        </t>
                        <div style="font-size:11px;">
                            Comprobante de pago PLANILLA <t t-out="freq_label"/> DEL
                            <t t-out="doc.date_from.strftime('%d/%m/%Y')"/>
                            AL
                            <t t-out="doc.date_to.strftime('%d/%m/%Y')"/>
                        </div>
                    </div>

                    <!-- DATOS EMPLEADO -->
                    <table style="width:100%; border:1px solid #000; border-top:none; border-collapse:collapse; font-size:12px;">
                        <tr>
                            <td style="padding:3px 8px; border-bottom:1px solid #ddd;">
                                <span style="font-weight:bold;">Empleado:</span>
                                <t t-out="doc.employee_id.name"/>
                            </td>
                            <td style="padding:3px 8px; border-bottom:1px solid #ddd; text-align:right; font-size:11px;">
                                Ced: <t t-out="doc.employee_id.identification_id or ''"/>
                            </td>
                        </tr>
                        <t t-if="doc.employee_id.job_id">
                        <tr>
                            <td colspan="2" style="padding:2px 8px; border-bottom:1px solid #ddd; font-size:11px; color:#555;">
                                Puesto: <t t-out="doc.employee_id.job_id.name"/>
                            </td>
                        </tr>
                        </t>
                        <t t-if="doc.calculation_method == 'attendance'">
                        <tr>
                            <td colspan="2" style="padding:2px 8px; border-bottom:1px solid #ddd; font-size:11px; color:#555;">
                                Horas trabajadas en el período: <strong><t t-out="doc.attendance_hours"/> h</strong>
                            </td>
                        </tr>
                        </t>
                    </table>

                    <!-- TABLA PRINCIPAL -->
                    <table style="width:100%; border:1px solid #000; border-top:none; border-collapse:collapse; font-size:12px;">

                        <!-- ENCABEZADO INGRESOS -->
                        <tr style="background-color:#000; color:#fff;">
                            <td style="padding:3px 8px; font-weight:bold;">Ingresos</td>
                            <td style="padding:3px 8px; text-align:right; font-weight:bold;">
                                ₡ <t t-out="'{:,.0f}'.format(doc.gross_salary)"/>
                            </td>
                        </tr>

                        <!-- Salario base - ocultar si hay incapacidad/maternidad total -->
                        <t t-if="doc.base_salary &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Salario:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.0f}'.format(doc.base_salary)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- Horas extras -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Horas Extras:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.overtime_amount &gt; 0">
                                    ₡ <t t-out="'{:,.0f}'.format(doc.overtime_amount)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <!-- Vacaciones pagadas -->
                        <t t-if="doc.vacation_amount &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Vacaciones:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.0f}'.format(doc.vacation_amount)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- Subsidio CCSS: distinguir maternidad de incapacidad ordinaria -->
                        <t t-if="doc.ccss_subsidy_total &gt; 0 and doc.base_salary == 0">
                            <t t-set="mat_dis" t-value="doc.disability_ids.filtered(lambda d: d.disability_type == 'maternity' and d.state in ('confirmed','paid'))"/>
                            <t t-if="mat_dis">
                            <tr>
                                <td style="padding:2px 8px 2px 20px; font-style:italic; color:#555;">
                                    Subsidio Maternidad (CCSS):
                                </td>
                                <td style="padding:2px 8px; text-align:right;">
                                    ₡ <t t-out="'{:,.0f}'.format(doc.ccss_subsidy_total)"/>
                                </td>
                            </tr>
                            </t>
                            <t t-else="">
                            <tr>
                                <td style="padding:2px 8px 2px 20px; font-style:italic; color:#555;">
                                    Subsidio Incapacidad (CCSS):
                                </td>
                                <td style="padding:2px 8px; text-align:right;">
                                    ₡ <t t-out="'{:,.0f}'.format(doc.ccss_subsidy_total)"/>
                                </td>
                            </tr>
                            </t>
                        </t>

                        <!-- Licencias con goce -->
                        <t t-foreach="doc.leave_cr_ids" t-as="lic">
                            <t t-if="lic.has_salary or lic.has_salary_override">
                            <tr>
                                <td style="padding:2px 8px 2px 20px;">
                                    Licencia <t t-out="dict(lic._fields['leave_type'].selection).get(lic.leave_type, lic.leave_type)"/>
                                    (<t t-out="lic.working_days if lic.working_days &gt; 0 else lic.days"/> dia(s)):
                                </td>
                                <td style="padding:2px 8px; text-align:right;">
                                    ₡ <t t-out="'{:,.0f}'.format(lic.leave_amount)"/>
                                </td>
                            </tr>
                            </t>
                        </t>

                        <!-- Bonos salariales -->
                        <t t-if="doc.bono_salarial_amount &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Bonos / Incentivos:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.0f}'.format(doc.bono_salarial_amount)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- Otros ingresos -->
                        <t t-if="doc.other_income &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Otros:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.0f}'.format(doc.other_income)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- SEPARADOR -->
                        <tr><td colspan="2" style="border-top:1px solid #ccc; padding:0;"/></tr>

                        <!-- ENCABEZADO EGRESOS -->
                        <tr style="background-color:#000; color:#fff;">
                            <td style="padding:3px 8px; font-weight:bold;">Egresos</td>
                            <td style="padding:3px 8px; text-align:right; font-weight:bold;">
                                ₡ <t t-out="'{:,.0f}'.format(doc.total_employee_deductions)"/>
                            </td>
                        </tr>

                        <!-- CCSS obrero -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">CCSS (10.83%):</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.ccss_employee &gt; 0">
                                    ₡ <t t-out="'{:,.0f}'.format(doc.ccss_employee)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <!-- Incapacidades: NO mostrar como egreso del empleado.
                             El costo patronal es información del patrono, no del colaborador. -->

                        <!-- Permisos sin goce -->
                        <t t-set="sin_goce_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category in ('ausencia', 'licencia_sin_goce'))"/>
                        <t t-set="sin_goce_total" t-value="sum(sin_goce_lines.mapped('amount'))"/>
                        <t t-if="sin_goce_total &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Permisos sin goce:</td>
                            <td style="padding:2px 8px; text-align:right; color:#c00000;">
                                ₡ <t t-out="'{:,.0f}'.format(sin_goce_total)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- Licencias sin goce desde leave_cr -->
                        <t t-foreach="doc.leave_cr_ids" t-as="lic">
                            <t t-if="not lic.has_salary and not lic.has_salary_override and lic.leave_amount &gt; 0">
                            <tr>
                                <td style="padding:2px 8px 2px 20px;">
                                    Sin goce (<t t-out="dict(lic._fields['leave_type'].selection).get(lic.leave_type, lic.leave_type)"/>):
                                </td>
                                <td style="padding:2px 8px; text-align:right; color:#c00000;">
                                    ₡ <t t-out="'{:,.0f}'.format(lic.leave_amount)"/>
                                </td>
                            </tr>
                            </t>
                        </t>

                        <!-- Impuesto de Renta -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Imp. Renta:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.income_tax &gt; 0">
                                    ₡ <t t-out="'{:,.0f}'.format(doc.income_tax)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <!-- Pensión alimentaria -->
                        <t t-set="pension_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category == 'pension_alimentaria')"/>
                        <t t-set="pension_total" t-value="sum(pension_lines.mapped('amount'))"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Pensión Alimentaria:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="pension_total &gt; 0">
                                    ₡ <t t-out="'{:,.0f}'.format(pension_total)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <!-- Embargo judicial -->
                        <t t-set="embargo_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category == 'embargo')"/>
                        <t t-set="embargo_total" t-value="sum(embargo_lines.mapped('amount'))"/>
                        <t t-if="embargo_total &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Embargo Judicial:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.0f}'.format(embargo_total)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- Préstamos -->
                        <t t-set="loan_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category == 'loan')"/>
                        <t t-set="loan_total" t-value="sum(loan_lines.mapped('amount'))"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Préstamos:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="loan_total &gt; 0">
                                    ₡ <t t-out="'{:,.0f}'.format(loan_total)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <!-- Cobros / Facturas -->
                        <t t-set="cobro_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category not in ('loan','pension_alimentaria','embargo','rop','ausencia','licencia_con_goce','vacation','bonus'))"/>
                        <t t-set="cobro_total" t-value="sum(cobro_lines.filtered(lambda l: l.deduction_category not in ('maternity','paternity')).mapped('amount'))"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Facturas / Cobros:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="cobro_total &gt; 0">
                                    ₡ <t t-out="'{:,.0f}'.format(cobro_total)"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                        </tr>

                        <!-- Días / Horas sin goce -->
                        <t t-set="ausencia_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category in ('ausencia','licencia_sin_goce'))"/>
                        <t t-set="ausencia_total" t-value="sum(ausencia_lines.mapped('amount'))"/>
                        <t t-if="ausencia_total &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Días / Horas sin goce:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.0f}'.format(ausencia_total)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- Ahorros / Sindicales / Seguros -->
                        <t t-set="otros_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category in ('ahorro','sindical','cooperativa','seguro','pension_vol'))"/>
                        <t t-foreach="otros_lines" t-as="ol">
                        <tr>
                            <td style="padding:2px 8px 2px 20px;"><t t-out="ol.deduction_code_id.name"/>:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.0f}'.format(ol.amount)"/>
                            </td>
                        </tr>
                        </t>

                        <!-- DESGLOSE PATRONO vs CCSS/INS para incapacidades -->
                        <t t-if="doc.disability_days_in_period &gt; 0">
                        <tr><td colspan="2" style="border-top:1px solid #ccc; padding:0; margin:4px 0;"/></tr>
                        <tr style="background-color:#f5f5f5;">
                            <td colspan="2" style="padding:3px 8px; font-size:10px; font-weight:bold; color:#555; text-transform:uppercase; letter-spacing:0.5px;">
                                Desglose de Pago
                            </td>
                        </tr>
                        <!-- Pago del Patrono -->
                        <t t-if="doc.neto_por_patrono &gt; 0">
                        <tr>
                            <td style="padding:2px 8px 2px 20px; font-size:11px;">
                                ① Pago del Patrono:
                            </td>
                            <td style="padding:2px 8px; text-align:right; font-size:11px;">
                                ₡ <t t-out="'{:,.2f}'.format(doc.neto_por_patrono)"/>
                            </td>
                        </tr>
                        </t>
                        <!-- Subsidio CCSS/INS -->
                        <t t-if="doc.neto_por_ccss &gt; 0">
                        <t t-set="ins_dis_only" t-value="doc.disability_ids.filtered(lambda d: d.disability_type == 'ins' and d.state in ('confirmed','paid'))"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px; font-size:11px;">
                                ② Subsidio
                                <t t-if="ins_dis_only"> INS</t>
                                <t t-else=""> CCSS</t>:
                            </td>
                            <td style="padding:2px 8px; text-align:right; font-size:11px;">
                                ₡ <t t-out="'{:,.2f}'.format(doc.neto_por_ccss)"/>
                            </td>
                        </tr>
                        </t>
                        </t>

                        <!-- SEPARADOR FINAL -->
                        <tr><td colspan="2" style="border-top:2px solid #000; padding:0;"/></tr>

                        <!-- NETO A PAGAR -->
                        <tr style="font-size:13px; font-weight:bold;">
                            <td style="padding:5px 8px;">Neto a Pagar</td>
                            <td style="padding:5px 8px; text-align:right;">
                                ₡ <t t-out="'{:,.2f}'.format(doc.net_salary)"/>
                            </td>
                        </tr>

                    </table>

                    <!-- FIRMAS -->
                    <div style="display:table; width:100%; margin-top:40px; font-size:11px;">
                        <div style="display:table-cell; width:48%; text-align:center; padding-top:30px; border-top:1px solid #000;">
                            Firma Patrono
                        </div>
                        <div style="display:table-cell; width:4%;"/>
                        <div style="display:table-cell; width:48%; text-align:center; padding-top:30px; border-top:1px solid #000;">
                            <t t-out="doc.employee_id.name"/>
                        </div>
                    </div>

                    <!-- NOTAS -->
                    <t t-if="doc.notes">
                        <div style="margin-top:8px; font-size:10px; color:#444; border-top:1px solid #ddd; padding-top:4px;">
                            <strong>Observaciones:</strong> <t t-out="doc.notes"/>
                        </div>
                    </t>

                    <div class="page_break"/>
                </div>
            </t>
            </main>
        </t>
    </t></template>

    <record id="action_report_payslip_cr" model="ir.actions.report">
        <field name="name">Boleta de Pago</field>
        <field name="model">planilla.payslip.cr</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_payslip_cr_document</field>
        <field name="report_file">planilla_cr.report_payslip_cr_document</field>
        <field name="binding_model_id" ref="model_planilla_payslip_cr"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
</odoo>
