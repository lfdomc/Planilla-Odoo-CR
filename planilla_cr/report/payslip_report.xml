<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="report_payslip_cr_document">
        <t t-call="web.html_container"><t t-set="company" t-value="docs[0].company_id if docs else env.company"/>
        <t t-call="web.external_layout">
            <main>
            <t t-foreach="docs" t-as="doc">
                <t t-set="freq_label" t-value="
                    'Quincenal' if doc.effective_frequency == 'biweekly' else
                    'Semanal' if doc.effective_frequency == 'weekly' else
                    'Bimensual' if doc.effective_frequency == 'bimonthly' else
                    'Mensual'
                "/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; max-width: 480px; margin: 0 auto;">

                    <!-- ENCABEZADO -->
                    <div style="text-align:center; border:1px solid #000; padding:6px 10px 5px; border-bottom:none;">
                        <div style="font-weight:bold; font-size:13px; text-transform:uppercase;">
                            <t t-out="doc.company_id.name"/>
                        </div>
                        <t t-if="doc.branch_id">
                            <div style="font-size:11px;"><t t-out="doc.branch_id.name"/></div>
                        </t>
                        <div style="font-size:11px;">
                            Comprobante de pago PLANILLA <t t-out="freq_label"/> DEL
                            <t t-out="doc.date_from.strftime('%d/%m/%Y')"/> AL
                            <t t-out="doc.date_to.strftime('%d/%m/%Y')"/>
                        </div>
                        <div style="font-size:11px; color:#555;">
                            No: <t t-out="doc.name or ''"/>
                        </div>
                    </div>

                    <!-- TABLA PRINCIPAL -->
                    <table style="width:100%; border:1px solid #000; border-collapse:collapse; font-size:12px;">

                        <!-- EMPLEADO -->
                        <tr>
                            <td colspan="3" style="padding:3px 8px; border-bottom:1px solid #ddd;">
                                <span style="font-weight:bold;">Empleado:</span>
                                <t t-out="doc.employee_id.name"/>
                                <t t-if="doc.employee_id.identification_id">
                                    <span style="font-size:11px; color:#555;">
                                        &#160;&#160;Ced: <t t-out="doc.employee_id.identification_id"/>
                                    </span>
                                </t>
                            </td>
                        </tr>
                        <t t-if="doc.employee_id.job_id">
                        <tr>
                            <td colspan="3" style="padding:1px 8px 3px; font-size:11px; color:#555; border-bottom:1px solid #ddd;">
                                Puesto: <t t-out="doc.employee_id.job_id.name"/>
                                &#160;&#160;|&#160;&#160;
                                Dias laborados: <t t-out="str(doc.dias_laborados_periodo)"/>
                                <t t-set="_cfg" t-value="doc.env['planilla.accounting.config'].sudo().search([('company_id','=',doc.company_id.id)],limit=1)"/>
                                <t t-if="not _cfg or _cfg.show_vacation_on_payslip">
                                &#160;&#160;|&#160;&#160;
                                Saldo vacac.: <t t-out="'{:.1f}'.format(doc.employee_id.vacation_days_available or 0)"/> dias
                                </t>
                            </td>
                        </tr>
                        </t>

                        <!-- CABECERA COLUMNAS -->
                        <tr style="background:#f0f0f0; font-size:10px; color:#555;">
                            <td style="padding:2px 8px; font-weight:bold; width:55%;">Concepto</td>
                            <td style="padding:2px 8px; text-align:right; width:22%;">Monto (&#8353;)</td>
                            <td style="padding:2px 8px; text-align:right; width:23%;">Total (&#8353;)</td>
                        </tr>

                        <!-- ====== INGRESOS ====== -->
                        <tr style="background:#000; color:#fff;">
                            <td style="padding:3px 8px; font-weight:bold;">Ingresos</td>
                            <td style="padding:3px 8px; text-align:right;"/>
                            <td style="padding:3px 8px; text-align:right; font-weight:bold;">
                                &#8353; <t t-out="'{:,.0f}'.format(doc.gross_salary)"/>
                            </td>
                        </tr>

                        <!-- Salario -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Salario:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.base_salary &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.base_salary)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Horas Feriado -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">
                                Horas Feriado<t t-if="doc.overtime_holiday_hours &gt; 0">
                                    <span style="font-size:10px; color:#666;"> (<t t-out="'{:.2f}'.format(doc.overtime_holiday_hours)"/> h)</span>
                                </t>:
                            </td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-set="feriado_lines" t-value="doc.overtime_ids.filtered(lambda o: o.overtime_type == 'holiday' and o.state in ('approved','paid'))"/>
                                <t t-set="feriado_monto" t-value="sum(o.amount for o in feriado_lines)"/>
                                <t t-if="feriado_monto &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(feriado_monto)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Horas Extras (no feriado) -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">
                                Horas Extras<t t-if="doc.overtime_hours_total &gt; doc.overtime_holiday_hours">
                                    <span style="font-size:10px; color:#666;"> (<t t-out="'{:.2f}'.format(doc.overtime_hours_total - doc.overtime_holiday_hours)"/> h)</span>
                                </t>:
                            </td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-set="he_lines" t-value="doc.overtime_ids.filtered(lambda o: o.overtime_type != 'holiday' and o.state in ('approved','paid'))"/>
                                <t t-set="he_monto" t-value="sum(o.amount for o in he_lines)"/>
                                <t t-if="he_monto &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(he_monto)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Vacaciones pagadas -->
                        <t t-set="vac_lines_paid" t-value="doc.vacation_ids.filtered(lambda v: v.state in ('approved','paid'))"/>
                        <t t-set="vac_dias_total" t-value="sum(v.days for v in vac_lines_paid)"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">
                                Vacaciones<t t-if="vac_dias_total &gt; 0">
                                    <span style="font-size:10px; color:#666;"> (<t t-out="'%.2f' % vac_dias_total"/> d)</span>
                                </t>:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.vacation_amount &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.vacation_amount)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Bonos / Incentivos -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Bonos / Incentivos:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-set="_total_bonos" t-value="(doc.bono_salarial_amount or 0) + (doc.amount_bonos_exentos or 0)"/>
                                <t t-if="_total_bonos &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(_total_bonos)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Otros ingresos -->
                        <t t-set="otros_ingresos_lic" t-value="doc.deduction_line_ids.filtered(lambda l: l.line_type == 'income' and l.deduction_category not in ('bonus',))"/>
                        <t t-set="otros_ingresos_total" t-value="sum(l.amount for l in otros_ingresos_lic)"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Otros:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="otros_ingresos_total &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(otros_ingresos_total)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- ====== EGRESOS ====== -->
                        <tr style="background:#000; color:#fff;">
                            <td style="padding:3px 8px; font-weight:bold;">Egresos</td>
                            <td style="padding:3px 8px; text-align:right;"/>
                            <td style="padding:3px 8px; text-align:right; font-weight:bold;">
                                &#8353; <t t-out="'{:,.0f}'.format(doc.total_employee_deductions)"/>
                            </td>
                        </tr>

                        <!-- CCSS Obrero -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">CCSS:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.ccss_employee &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.ccss_employee)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Incapacidad CCSS (dias de incapacidad del periodo) -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">
                                Incapacidad CCSS<t t-if="doc.disability_days_in_period &gt; 0">
                                    <span style="font-size:10px; color:#666;"> (<t t-out="str(doc.disability_days_in_period)"/> dias)</span>
                                </t>:
                            </td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-set="incap_normal" t-value="doc.disability_ids.filtered(lambda d: d.disability_type not in ('maternity','ins') and d.state in ('confirmed','paid'))"/>
                                <t t-if="incap_normal and doc.disability_days_in_period &gt; 0">
                                    <t t-set="dias_sin_sueldo" t-value="doc.disability_days_in_period"/>
                                    &#8353; <t t-out="'{:,.0f}'.format(round(doc.employee_id.base_salary / 30 * dias_sin_sueldo, 0))"/>
                                </t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Incapacidad INS -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">
                                Incapacidad INS<t t-if="ins_dis">
                                    <t t-set="ins_dias" t-value="sum(d.days for d in ins_dis)"/>
                                    <span style="font-size:10px; color:#666;"> (<t t-out="str(ins_dias)"/> d)</span>
                                </t>:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-set="ins_dis" t-value="doc.disability_ids.filtered(lambda d: d.disability_type == 'ins' and d.state in ('confirmed','paid'))"/>
                                <t t-if="ins_dis">&#8353; <t t-out="'{:,.0f}'.format(doc.ins_subsidy_total)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Ahorro (Sindicato/Cooperativa/Ahorro) -->
                        <t t-set="ahorro_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category in ('ahorro','sindical','cooperativa','seguro'))"/>
                        <t t-set="ahorro_total" t-value="sum(l.amount for l in ahorro_lines)"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Ahorro / Sindical:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="ahorro_total &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(ahorro_total)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Dias y Horas sin goce (separados) -->
                        <t t-set="sg_dias_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.line_type == 'deduction' and l.deduction_category in ('licencia_sin_goce','ausencia') and (not l.leave_cr_id or l.leave_cr_id.leave_unit != 'hour'))"/>
                        <t t-set="sg_horas_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.line_type == 'deduction' and l.deduction_category == 'licencia_sin_goce' and l.leave_cr_id and l.leave_cr_id.leave_unit == 'hour')"/>
                        <t t-set="sg_dias_total" t-value="sum(l.amount for l in sg_dias_lines)"/>
                        <t t-set="sg_horas_total" t-value="sum(l.amount for l in sg_horas_lines)"/>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">
                                Dias sin goce<t t-if="sg_dias_lines">
                                    <t t-set="sg_dias_count" t-value="sum(l.leave_cr_id.days if l.leave_cr_id else 1 for l in sg_dias_lines)"/>
                                    <span style="font-size:10px; color:#666;"> (<t t-out="'%.0f' % sg_dias_count"/> d)</span>
                                </t>:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="sg_dias_total &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(sg_dias_total)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">
                                Horas sin goce<t t-if="sg_horas_lines">
                                    <t t-set="sg_horas_count" t-value="sum(l.leave_cr_id.hours if l.leave_cr_id and l.leave_cr_id.hours else 1 for l in sg_horas_lines)"/>
                                    <span style="font-size:10px; color:#666;"> (<t t-out="'%.2f' % sg_horas_count"/> h)</span>
                                </t>:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="sg_horas_total &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(sg_horas_total)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Licencias con goce -->
                        <t t-set="cg_lines" t-value="doc.deduction_line_ids.filtered(lambda l: l.deduction_category == 'licencia_con_goce')"/>
                        <t t-set="cg_total" t-value="sum(l.amount for l in cg_lines)"/>
                        <tr t-if="cg_total &gt; 0">
                            <td style="padding:2px 8px 2px 20px;">
                                Licencia con Goce<t t-if="cg_lines">
                                    <t t-set="cg_dias" t-value="sum(l.leave_cr_id.days if l.leave_cr_id else 1 for l in cg_lines)"/>
                                    <span style="font-size:10px; color:#666;"> (<t t-out="'%.0f' % cg_dias"/> d)</span>
                                </t>:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                &#8353; <t t-out="'{{:,.0f}}'.format(cg_total)"/>
                            </td>
                            <td/>
                        </tr>

                        <!-- Imp. Renta -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Imp. Renta:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.income_tax &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.income_tax)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Pension Alimentaria -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Pension Alimentaria:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.amount_pension_alimentaria &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.amount_pension_alimentaria)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Embargo -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Embargo Judicial:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.amount_embargo &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.amount_embargo)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Prestamos -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Prestamos:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.amount_loans &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.amount_loans)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- Facturas / Cobros -->
                        <tr>
                            <td style="padding:2px 8px 2px 20px;">Facturas / Compras:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                <t t-if="doc.amount_cobros_empleado &gt; 0">&#8353; <t t-out="'{:,.0f}'.format(doc.amount_cobros_empleado)"/></t>
                                <t t-else="">-</t>
                            </td>
                            <td/>
                        </tr>

                        <!-- ====== DEPOSITO DEL PATRON ====== -->
                        <tr><td colspan="3" style="border-top:1px solid #aaa; padding:0;"/></tr>

                        <!-- Opcion A: neto total en italica ANTES del bloque oscuro, solo cuando hay subsidio -->
                        <t t-if="doc.ccss_subsidy_total &gt; 0">
                        <t t-set="mat_s2" t-value="doc.disability_ids.filtered(lambda d: d.disability_type == 'maternity' and d.state in ('confirmed','paid'))"/>
                        <tr style="font-size:10.5px; color:#555; font-style:italic;">
                            <td style="padding:2px 8px;">Neto total del periodo:</td>
                            <td style="padding:2px 8px; text-align:right;">
                                &#8353; <t t-out="'{:,.2f}'.format(doc.net_salary)"/>
                            </td>
                            <td style="padding:2px 8px; font-size:9.5px; color:#888;">
                                (patrono + CCSS)
                            </td>
                        </tr>
                        </t>

                        <tr style="background:#444; color:#fff;">
                            <td style="padding:3px 8px; font-weight:bold;">Deposito del Patron</td>
                            <td style="padding:3px 8px; text-align:right;"/>
                            <td style="padding:3px 8px; text-align:right; font-weight:bold;">
                                &#8353; <t t-out="'{:,.2f}'.format(doc.deposito_patrono)"/>
                                <t t-if="doc.ccss_subsidy_total &gt; 0">
                                    <span style="font-weight:normal; font-size:9.5px; opacity:0.85;">
                                        &#160;<t t-set="pct_patron" t-value="round(doc.deposito_patrono / doc.net_salary * 100) if doc.net_salary else 0"/>
                                        (<t t-out="str(pct_patron)"/>% del neto)
                                    </span>
                                </t>
                            </td>
                        </tr>

                        <!-- Nota subsidio: solo tipo, sin montos -->
                        <t t-if="doc.ccss_subsidy_total &gt; 0">
                        <t t-set="mat_s" t-value="doc.disability_ids.filtered(lambda d: d.disability_type == 'maternity' and d.state in ('confirmed','paid'))"/>
                        <tr>
                            <td colspan="3" style="padding:2px 8px; font-size:9.5px; font-style:italic; color:#666;">
                                <t t-if="mat_s">
                                    * La CCSS deposita el 50% restante directamente a su cuenta (maternidad Art. 94 CT).
                                </t>
                                <t t-else="">
                                    * La CCSS deposita el resto directamente a su cuenta (incapacidad Art. 79 CT).
                                </t>
                            </td>
                        </tr>
                        </t>

                        <!-- ====== DETALLE DEL PERIODO (condicional) ====== -->
                        <t t-if="doc.overtime_hours_total &gt; 0 or doc.disability_days_in_period &gt; 0 or doc.vacation_amount &gt; 0">
                        <tr><td colspan="3" style="border-top:1px dashed #ccc; padding:0;"/></tr>
                        <tr>
                            <td colspan="3" style="padding:2px 8px; font-size:10px; font-weight:bold; color:#1F4E79; text-transform:uppercase; letter-spacing:0.4px;">
                                Detalle del Periodo
                            </td>
                        </tr>
                        <t t-if="doc.overtime_hours_total &gt; 0">
                        <tr>
                            <td style="padding:1px 8px 1px 20px; font-size:11px; color:#555;">Horas extras trabajadas:</td>
                            <td style="padding:1px 8px; text-align:right; font-size:11px; color:#555;"><t t-out="'{:.2f}'.format(doc.overtime_hours_total)"/> h</td>
                            <td/>
                        </tr>
                        </t>
                        <t t-if="doc.overtime_holiday_hours &gt; 0">
                        <tr>
                            <td style="padding:1px 8px 1px 20px; font-size:11px; color:#555;">Feriados trabajados:</td>
                            <td style="padding:1px 8px; text-align:right; font-size:11px; color:#555;">
                                <t t-set="hol_ot2" t-value="doc.overtime_ids.filtered(lambda o: o.overtime_type == 'holiday' and o.state in ('approved','paid'))"/>
                                <t t-out="str(len(hol_ot2))"/> dia(s) (<t t-out="'{:.2f}'.format(doc.overtime_holiday_hours)"/> h)
                            </td>
                            <td/>
                        </tr>
                        </t>
                        <t t-if="doc.disability_days_in_period &gt; 0">
                        <tr>
                            <td style="padding:1px 8px 1px 20px; font-size:11px; color:#555;">
                                Dias de incapacidad:<t t-set="mat_det2" t-value="doc.disability_ids.filtered(lambda d: d.disability_type == 'maternity' and d.state in ('confirmed','paid'))"/>
                                <t t-if="mat_det2"><span style="font-size:10px; color:#888;"> (maternidad)</span></t>
                            </td>
                            <td style="padding:1px 8px; text-align:right; font-size:11px; color:#555;"><t t-out="str(doc.disability_days_in_period)"/> dias</td>
                            <td/>
                        </tr>
                        </t>
                        <t t-if="doc.vacation_amount &gt; 0">
                        <tr>
                            <td style="padding:1px 8px 1px 20px; font-size:11px; color:#555;">Vacaciones tomadas:</td>
                            <td style="padding:1px 8px; text-align:right; font-size:11px; color:#555;">
                                <t t-set="vac_d" t-value="sum(v.days for v in doc.vacation_ids if v.state in ('approved','paid'))"/>
                                <t t-out="str(vac_d)"/> dias
                            </td>
                            <td/>
                        </tr>
                        </t>
                        </t>

                    </table>

                    <!-- FIRMAS -->
                    <div style="display:table; width:100%; margin-top:40px; font-size:11px;">
                        <div style="display:table-cell; width:48%; text-align:center; padding-top:30px; border-top:1px solid #000;">
                            Firma Patrono
                        </div>
                        <div style="display:table-cell; width:4%;"/>
                        <div style="display:table-cell; width:48%; text-align:center; padding-top:30px; border-top:1px solid #000;">
                            <t t-out="doc.employee_id.name"/>
                        </div>
                    </div>

                    <div class="page_break"/>
                </div>
            </t>
            </main>
        </t>
        </t>
    </template>

    <record id="action_report_payslip_cr" model="ir.actions.report">
        <field name="name">Boleta de Pago</field>
        <field name="model">planilla.payslip.cr</field>
        <field name="report_type">qweb-pdf</field>
