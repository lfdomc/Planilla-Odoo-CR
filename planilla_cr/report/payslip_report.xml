<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_cr_document">
        <t t-call="web.external_layout">
            <main>
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">
                    <div class="row mb-4">
                        <div class="col-6">
                            <h2 style="color:#1F4E79;">BOLETA DE PAGO</h2>
                            <p><strong>Empresa:</strong> <t t-out="doc.company_id.name"/></p>
                            <t t-if="doc.branch_id">
                                <p><strong>Sucursal:</strong> <t t-out="doc.branch_id.name"/></p>
                            </t>
                        </div>
                        <div class="col-6 text-end">
                            <p><strong>Referencia:</strong> <t t-out="doc.name"/></p>
                            <p><strong>Período:</strong> <t t-out="doc.date_from"/> — <t t-out="doc.date_to"/></p>
                        </div>
                    </div>
                    <div class="row mb-3 p-2" style="background:#f0f4f8; border-radius:5px;">
                        <div class="col-6">
                            <p class="mb-1"><strong>Colaborador:</strong> <t t-out="doc.employee_id.name"/></p>
                            <p class="mb-1"><strong>Puesto:</strong> <t t-out="doc.employee_id.job_id.name or ''"/></p>
                            <t t-if="doc.employee_id.employee_type_id">
                                <p class="mb-1"><strong>Tipo:</strong> <t t-out="doc.employee_id.employee_type_id.name"/></p>
                            </t>
                        </div>
                        <div class="col-6">
                            <p class="mb-1"><strong>Identificación:</strong> <t t-out="doc.employee_id.identification_id or ''"/></p>
                            <t t-if="doc.employee_id.ccss_number">
                                <p class="mb-1"><strong>CCSS:</strong> <t t-out="doc.employee_id.ccss_number"/></p>
                            </t>
                            <p class="mb-1"><strong>Fecha Ingreso:</strong> <t t-out="doc.employee_id.entry_date or ''"/></p>
                            <p class="mb-1"><strong>Método de pago:</strong>
                                <t t-if="doc.calculation_method == 'attendance'">Por Horas Trabajadas</t>
                                <t t-else="">Salario Fijo</t>
                            </p>
                        </div>
                    </div>

                    <!-- Resumen asistencias si aplica -->
                    <t t-if="doc.calculation_method == 'attendance'">
                        <div class="row mb-2 p-2" style="background:#fff8e1; border-radius:4px; border-left:4px solid #ffc107;">
                            <div class="col-12">
                                <strong>Horas trabajadas en el período: <t t-out="doc.attendance_hours"/> horas</strong>
                            </div>
                        </div>
                    </t>
                    <table class="table table-bordered table-sm mt-3">
                        <thead style="background-color:#1F4E79; color:#fff;">
                            <tr>
                                <th colspan="2" class="text-center">INGRESOS</th>
                                <th colspan="2" class="text-center">DEDUCCIONES OBRERO</th>
                            </tr>
                            <tr>
                                <th>Concepto</th><th class="text-end">Monto (&#8353;)</th>
                                <th>Concepto</th><th class="text-end">Monto (&#8353;)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Salario Base</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.base_salary)"/></td>
                                <td>CCSS Obrero (10.83%)</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.ccss_employee)"/></td>
                            </tr>
                            <tr t-if="doc.overtime_amount > 0">
                                <td>Horas Extras</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.overtime_amount)"/></td>
                                <td>Impuesto de Renta</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.income_tax)"/></td>
                            </tr>
                            <tr t-if="doc.ccss_subsidy_total > 0">
                                <td>Subsidio CCSS (Incapacidad)</td>
                                <td class="text-end text-success"><t t-out="'{:,.2f}'.format(doc.ccss_subsidy_total)"/></td>
                            </tr>
                            <tr t-if="doc.vacation_amount > 0">
                                <td>Vacaciones</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.vacation_amount)"/></td>
                                <td></td><td></td>
                            </tr>
                            <tr t-if="doc.other_income > 0">
                                <td>Otros Ingresos</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.other_income)"/></td>
                                <td></td><td></td>
                            </tr>
                            <t t-foreach="doc.deduction_line_ids" t-as="line">
                                <tr>
                                    <td></td><td></td>
                                    <td><t t-out="line.deduction_code_id.name"/></td>
                                    <td class="text-end"><t t-out="'{:,.2f}'.format(line.amount)"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold" style="background-color:#e8f0fe;">
                                <td>TOTAL BRUTO</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.gross_salary)"/></td>
                                <td>TOTAL DEDUCCIONES</td>
                                <td class="text-end"><t t-out="'{:,.2f}'.format(doc.total_employee_deductions)"/></td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="row mt-3">
                        <div class="col-6 ms-auto">
                            <table class="table table-bordered">
                                <tr style="background-color:#d4edda;">
                                    <td><strong>SALARIO NETO A RECIBIR</strong></td>
                                    <td class="text-end fw-bold">
                                        <t t-out="doc.currency_id.symbol or '&#8353;'"/>
                                        <t t-out="'{:,.2f}'.format(doc.net_salary)"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12">
                            <h6 style="color:#1F4E79;">CARGAS PATRONALES (Referencia)</h6>
                            <table class="table table-sm table-bordered">
                                <thead style="background-color:#f0f4f8;">
                                    <tr>
                                        <th>Concepto</th><th class="text-end">Monto</th>
                                        <th>Concepto</th><th class="text-end">Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>CCSS Patronal (26.83%)</td>
                                        <td class="text-end"><t t-out="'{:,.2f}'.format(doc.ccss_employer)"/></td>
                                        <td>INS Riesgos (~1%)</td>
                                        <td class="text-end"><t t-out="'{:,.2f}'.format(doc.ins_employer)"/></td>
                                    </tr>
                                    <tr>
                                        <td>Provision Aguinaldo (8.33%)</td>
                                        <td class="text-end"><t t-out="'{:,.2f}'.format(doc.aguinaldo_provision)"/></td>
                                        <td>Provision Cesantia (5.33%)</td>
                                        <td class="text-end"><t t-out="'{:,.2f}'.format(doc.cesantia_provision)"/></td>
                                    </tr>
                                    <tr>
                                        <td>Provision Vacaciones (4.16%)</td>
                                        <td class="text-end"><t t-out="'{:,.2f}'.format(doc.vacation_provision)"/></td>
                                        <td><strong>COSTO TOTAL EMPRESA</strong></td>
                                        <td class="text-end fw-bold"><t t-out="'{:,.2f}'.format(doc.total_employer_cost)"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row mt-5">
                        <div class="col-5 text-center">
                            <div style="border-top:1px solid #000; margin-top:50px; padding-top:5px;">
                                <p>Firma Patrono / Representante Legal</p>
                            </div>
                        </div>
                        <div class="col-5 offset-2 text-center">
                            <div style="border-top:1px solid #000; margin-top:50px; padding-top:5px;">
                                <p>Firma Colaborador: <t t-out="doc.employee_id.name"/></p>
                            </div>
                        </div>
                    </div>
                    <t t-if="doc.notes">
                        <div class="mt-3" style="border-top:1px solid #ddd; padding-top:8px;">
                            <strong style="font-size:11px;">Observaciones:</strong>
                            <p style="font-size:11px; color:#444; margin:4px 0 0 0;">
                                <t t-out="doc.notes"/>
                            </p>
                        </div>
                    </t>
                    <p class="text-center mt-3" style="font-size:10px; color:#888;">
                        Desarrollado por Ing. Luis Fernando Morua Calderon | Planilla CR para Odoo 19
                    </p>
                    <div class="page_break"/>
                </div>
            </t>
            </main>
        </t>
    </template>

    <record id="action_report_payslip_cr" model="ir.actions.report">
        <field name="name">Boleta de Pago</field>
        <field name="model">planilla.payslip.cr</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_payslip_cr_document</field>
        <field name="report_file">planilla_cr.report_payslip_cr_document</field>
        <field name="binding_model_id" ref="model_planilla_payslip_cr"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
