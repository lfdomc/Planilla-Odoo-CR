<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_aguinaldo_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <h2 style="color:#1F4E79;margin-bottom:4px">
            Cálculo de Aguinaldo — Art. 228 Código de Trabajo CR
          </h2>
          <p style="margin:0 0 12px;color:#666;font-size:12px">
            Año: <strong t-esc="docs.year"/> |
            Base: <strong t-esc="docs.salary_basis"/> |
            Generado: <strong t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
          </p>
          <table class="table table-sm table-bordered" style="font-size:11px">
            <thead style="background:#1F4E79;color:white">
              <tr>
                <th>Empleado</th>
                <th class="text-center">Sucursal</th>
                <th class="text-right">Boletas</th>
                <th class="text-right">Meses</th>
                <th class="text-right">Salarios Ordinarios</th>
                <th class="text-right">Aguinaldo Jun-Nov</th>
                <th class="text-right" style="background:#0D47A1">Acum. Inicial</th>
                <th class="text-right" style="background:#0D47A1">Provisionado dic→hoy</th>
                <th class="text-right" style="background:#1565C0">Total Acumulado</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="docs.result_ids" t-as="line">
                <tr>
                  <td t-esc="line.employee_id.name"/>
                  <td class="text-center" t-esc="line.branch or ''"/>
                  <td class="text-right" t-esc="line.slip_count"/>
                  <td class="text-right" t-esc="'%.1f' % (line.months_worked or 0)"/>
                  <td class="text-right"><t t-esc="'{:,.0f}'.format(line.total_ordinary or 0)"/></td>
                  <td class="text-right"><t t-esc="'{:,.0f}'.format(line.aguinaldo_amount or 0)"/></td>
                  <td class="text-right" style="background:#EBF5FB"><t t-esc="'{:,.0f}'.format(line.initial_amount or 0)"/></td>
                  <td class="text-right" style="background:#EBF5FB"><t t-esc="'{:,.0f}'.format(line.provision_acumulada or 0)"/></td>
                  <td class="text-right" style="background:#D6EAF8;font-weight:bold"><t t-esc="'{:,.0f}'.format(line.total_acumulado or 0)"/></td>
                </tr>
              </t>
            </tbody>
            <tfoot style="background:#D9E1F2;font-weight:bold">
              <tr>
                <td colspan="5" class="text-right">TOTAL</td>
                <td class="text-right"><t t-esc="'{:,.0f}'.format(docs.total_aguinaldo or 0)"/></td>
                <td/><td/>
                <td class="text-right" style="background:#1F4E79;color:white">
                  <t t-esc="'{:,.0f}'.format(sum(docs.result_ids.mapped('total_acumulado')))"/>
                </td>
              </tr>
            </tfoot>
          </table>
          <p style="font-size:10px;color:#888;margin-top:16px">
            * Acum. Inicial = monto pre-implementación al corte del 31 de marzo.<br/>
            * Provisionado dic→hoy = suma de provisiones en boletas desde 1 dic anterior.<br/>
            * Total Acumulado = Acum. Inicial + Provisionado (sin doble conteo).
          </p>
        </div>
      </t>
    </t>
  </template>
</odoo>