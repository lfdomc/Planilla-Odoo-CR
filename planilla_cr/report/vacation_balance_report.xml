<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_vacation_balance_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <div class="page">
                    <meta charset="UTF-8"/>
                    <style>
                        body { font-family: Arial, sans-serif; font-size: 10px; color: #333; }
                        .header-box { background:#1F4E79; color:white; padding:10px 16px; border-radius:4px; margin-bottom:14px; }
                        .header-box h4 { margin:0 0 3px 0; font-size:13px; }
                        .header-box p  { margin:0; font-size:10px; opacity:.9; }
                        .summary { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:14px; }
                        .kpi { background:#F0F4F8; padding:8px 10px; border-radius:4px; text-align:center; }
                        .kpi-label { font-size:8px; text-transform:uppercase; color:#666; font-weight:bold; }
                        .kpi-val   { font-size:16px; font-weight:bold; color:#1F4E79; }
                        table { width:100%; border-collapse:collapse; }
                        th { background:#1F4E79; color:white; padding:6px 8px; text-align:left; font-size:9px; }
                        td { padding:5px 8px; border-bottom:1px solid #E8EDF2; font-size:10px; }
                        tr:nth-child(even) td { background:#F8FAFC; }
                        .neg { color:#E74C3C; font-weight:bold; }
                        .pos { color:#27AE60; }
                        .zero{ color:#888; }
                        .alert-neg { background:#FDE8E8; }
                        .footer { margin-top:20px; font-size:8px; color:#888; border-top:1px solid #ddd; padding-top:6px; }
                    </style>

                    <div class="header-box">
                        <h4>Reporte de Saldo de Vacaciones por Empleado</h4>
                        <p>
                            Empresa: <t t-out="wizard.company_id.name"/> |
                            Sucursal: <t t-out="wizard.branch_id.name if wizard.branch_id else 'Todas'"/> |
                            Generado: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                        </p>
                    </div>

                    <t t-set="rows" t-value="wizard._get_vacation_report_data()"/>

                    <!-- KPIs resumen -->
                    <div class="summary">
                        <div class="kpi">
                            <div class="kpi-label">Total Empleados</div>
                            <div class="kpi-val"><t t-out="len(rows)"/></div>
                        </div>
                        <div class="kpi">
                            <div class="kpi-label">Días Acumulados Total</div>
                            <div class="kpi-val"><t t-out="'{:.1f}'.format(sum(r['accrued'] for r in rows))"/></div>
                        </div>
                        <div class="kpi">
                            <div class="kpi-label">Días Tomados Total</div>
                            <div class="kpi-val"><t t-out="'{:.1f}'.format(sum(r['taken'] for r in rows))"/></div>
                        </div>
                        <div class="kpi" style="background:#FDE8E8;">
                            <div class="kpi-label">Empleados Saldo Negativo</div>
                            <div class="kpi-val" style="color:#E74C3C;"><t t-out="sum(1 for r in rows if r['available'] &lt; 0)"/></div>
                        </div>
                    </div>

                    <table>
                        <thead>
                            <tr>
                                <th>Empleado</th>
                                <th>Sucursal</th>
                                <th>Fecha Ingreso</th>
                                <th style="text-align:right;">Antigüedad (años)</th>
                                <th style="text-align:right;">Días Acumulados</th>
                                <th style="text-align:right;">Días Tomados</th>
                                <th style="text-align:right;">Saldo Disponible</th>
                                <th style="text-align:right;">Provisión (₡)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="rows" t-as="r">
                                <tr t-att-class="'alert-neg' if r['available'] &lt; 0 else ''">
                                    <td><t t-out="r['name']"/></td>
                                    <td><t t-out="r['branch']"/></td>
                                    <td><t t-out="r['entry_date']"/></td>
                                    <td style="text-align:right;"><t t-out="r['years']"/></td>
                                    <td style="text-align:right;" class="pos"><t t-out="'{:.1f}'.format(r['accrued'])"/></td>
                                    <td style="text-align:right;"><t t-out="'{:.1f}'.format(r['taken'])"/></td>
                                    <td style="text-align:right;"
                                        t-att-class="'neg' if r['available'] &lt; 0 else ('zero' if r['available'] == 0 else 'pos')">
                                        <t t-out="'{:.1f}'.format(r['available'])"/>
                                    </td>
                                    <td style="text-align:right;">₡ <t t-out="'{:,.0f}'.format(r['provision'])"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="footer">
                        Basado en Art. 153 CT CR: 12 días hábiles por año trabajado (proporcional por semanas).
                        Filas en rojo indican saldo negativo — el empleado ha tomado más días de los acumulados.
                        Reporte generado por Planilla CR para Odoo 19.
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_vacation_balance" model="ir.actions.report">
        <field name="name">Saldo de Vacaciones</field>
        <field name="model">planilla.vacation.balance.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_vacation_balance_template</field>
        <field name="print_report_name">'Saldo_Vacaciones_%s' % time.strftime('%Y-%m')</field>
    </record>
</odoo>
