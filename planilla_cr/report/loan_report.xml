<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_loan_amortization_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <meta charset="UTF-8"/>
                    <style>
                        body { font-family: Arial, sans-serif; font-size: 11px; color: #333; }
                        .header-box { background: #1F4E79; color: white; padding: 12px 16px; border-radius: 4px; margin-bottom: 16px; }
                        .header-box h4 { margin: 0 0 4px 0; font-size: 14px; }
                        .header-box p  { margin: 0; font-size: 11px; opacity: 0.9; }
                        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }
                        .info-block { background: #F0F4F8; padding: 8px 12px; border-radius: 4px; }
                        .info-label { font-size: 9px; text-transform: uppercase; color: #666; font-weight: bold; }
                        .info-value { font-size: 13px; font-weight: bold; color: #1F4E79; }
                        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
                        th { background: #1F4E79; color: white; padding: 7px 10px; text-align: left; font-size: 10px; }
                        td { padding: 6px 10px; border-bottom: 1px solid #E8EDF2; font-size: 11px; }
                        tr:nth-child(even) td { background: #F8FAFC; }
                        .paid   { color: #27AE60; font-weight: bold; }
                        .pending{ color: #E67E22; }
                        .total-row td { background: #D9E1F2 !important; font-weight: bold; border-top: 2px solid #1F4E79; }
                        .badge-paid    { background:#27AE60; color:white; padding:2px 6px; border-radius:3px; font-size:9px; }
                        .badge-pending { background:#F39C12; color:white; padding:2px 6px; border-radius:3px; font-size:9px; }
                        .badge-active  { background:#2E75B6; color:white; padding:2px 6px; border-radius:3px; font-size:9px; }
                        .footer-note { margin-top: 24px; font-size: 9px; color: #888; border-top: 1px solid #ddd; padding-top: 8px; }
                    </style>

                    <!-- Encabezado -->
                    <div class="header-box">
                        <h4>Tabla de Amortizacion -- Prestamo / Adelanto Salarial</h4>
                        <p><t t-out="doc.employee_id.company_id.name"/> | Generado: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></p>
                    </div>

                    <!-- Info del prestamo -->
                    <div class="info-grid">
                        <div class="info-block">
                            <div class="info-label">Empleado</div>
                            <div class="info-value"><t t-out="doc.employee_id.name"/></div>
                        </div>
                        <div class="info-block">
                            <div class="info-label">Estado</div>
                            <div class="info-value">
                                <t t-if="doc.state == 'paid'"><span class="badge-paid">PAGADO</span></t>
                                <t t-elif="doc.state == 'active'"><span class="badge-active">ACTIVO</span></t>
                                <t t-elif="doc.state == 'approved'"><span class="badge-pending">APROBADO</span></t>
                                <t t-else=""><t t-out="doc.state"/></t>
                            </div>
                        </div>
                        <div class="info-block">
                            <div class="info-label">Monto Total</div>
                            <div class="info-value">CRC <t t-out="'{:,.2f}'.format(doc.amount_total)"/></div>
                        </div>
                        <div class="info-block">
                            <div class="info-label">Cuota Mensual</div>
                            <div class="info-value">CRC <t t-out="'{:,.2f}'.format(doc.installment_amount)"/></div>
                        </div>
                        <div class="info-block">
                            <div class="info-label">Saldo Pendiente</div>
                            <div class="info-value" style="color:#E74C3C;">CRC <t t-out="'{:,.2f}'.format(doc.amount_pending)"/></div>
                        </div>
                        <div class="info-block">
                            <div class="info-label">Primer Descuento</div>
                            <div class="info-value"><t t-out="doc.date_first_deduction.strftime('%d/%m/%Y') if doc.date_first_deduction else '--'"/></div>
                        </div>
                    </div>

                    <t t-if="doc.description">
                        <div style="background:#FFF3CD; padding:8px 12px; border-radius:4px; margin-bottom:12px; font-size:11px;">
                            <strong>Descripcion:</strong> <t t-out="doc.description"/>
                        </div>
                    </t>

                    <!-- Tabla de cuotas -->
                    <table>
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Fecha de Descuento</th>
                                <th style="text-align:right;">Monto Cuota (CRC)</th>
                                <th style="text-align:right;">Saldo Despues (CRC)</th>
                                <th style="text-align:center;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="running_balance" t-value="doc.amount_total"/>
                            <t t-foreach="doc.installment_ids.sorted(key=lambda i: i.sequence)" t-as="inst">
                                <t t-set="running_balance" t-value="running_balance - inst.amount"/>
                                <tr>
                                    <td><t t-out="inst.sequence"/></td>
                                    <td><t t-out="inst.due_date.strftime('%d/%m/%Y') if inst.due_date else '--'"/></td>
                                    <td style="text-align:right;">CRC <t t-out="'{:,.2f}'.format(inst.amount)"/></td>
                                    <td style="text-align:right;">CRC <t t-out="'{:,.2f}'.format(max(running_balance, 0))"/></td>
                                    <td style="text-align:center;">
                                        <t t-if="inst.state == 'deducted'">
                                            <span class="badge-paid"><i class="fa fa-check" title="Check"/> Descontado</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge-pending">Pendiente</span>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                            <tr class="total-row">
                                <td colspan="2">TOTAL</td>
                                <td style="text-align:right;">CRC <t t-out="'{:,.2f}'.format(doc.amount_total)"/></td>
                                <td style="text-align:right;">CRC <t t-out="'{:,.2f}'.format(doc.amount_pending)"/></td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="footer-note">
                        Los descuentos se realizan mensualmente en la boleta de pago del empleado.
                        Saldo pendiente al <t t-out="datetime.date.today().strftime('%d/%m/%Y')"/>:
                        <strong>CRC <t t-out="'{:,.2f}'.format(doc.amount_pending)"/></strong> en
                        <t t-out="len(doc.installment_ids.filtered(lambda i: i.state == 'pending'))"/> cuota(s) pendiente(s).
                        Desarrollado por Planilla CR para Odoo 19.
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_loan_amortization" model="ir.actions.report">
        <field name="name">Tabla de Amortizacion</field>
        <field name="model">planilla.employee.loan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_loan_amortization_template</field>
        <field name="report_file">planilla_cr.report_loan_amortization_template</field>
        <field name="print_report_name">'Amortizacion_%s_%s' % (object.employee_id.name, object.name)</field>
        <field name="binding_model_id" ref="planilla_cr.model_planilla_employee_loan"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
