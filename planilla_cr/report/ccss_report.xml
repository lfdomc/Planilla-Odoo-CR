<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_ccss_template">
        <t t-call="web.html_container">
            <meta charset="UTF-8"/>
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="doc.company_id"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="data" t-value="doc.get_report_data()"/>

                    <div style="text-align:center; margin-bottom:16px;">
                        <h2 style="color:#1A5276; margin:0;">PLANILLA CCSS - CUOTAS DE PATRONO</h2>
                        <h3 style="margin:4px 0;"><t t-esc="data['company'].name"/></h3>
                        <p style="margin:2px 0; font-size:12px;">
                            Período: <t t-esc="data['date_from']"/> al <t t-esc="data['date_to']"/>
                        </p>
                        <p style="margin:2px 0; font-size:11px; color:#555;">
                            Tasa Obrero: <t t-esc="'%.2f' % data['tasa_obrero']"/>% |
                            Tasa Patronal: <t t-esc="'%.2f' % data['tasa_patronal']"/>%
                        </p>
                    </div>

                    <table class="table table-sm table-bordered" style="font-size:10px; width:100%;">
                        <thead style="background-color:#2E86C1; color:white;">
                            <tr>
                                <th style="width:4%;">#</th>
                                <th style="width:12%;">Cédula</th>
                                <th style="width:30%;">Nombre</th>
                                <th style="width:14%; text-align:right;">Salario Bruto</th>
                                <th style="width:14%; text-align:right;">Cuota Obrero 10.83%</th>
                                <th style="width:14%; text-align:right;">Cuota Patronal 26.83%</th>
                                <th style="width:12%; text-align:right;">Total Cuota</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['rows']" t-as="r">
                                <tr t-attf-style="background-color: #{r_index % 2 == 0 and '#EBF5FB' or '#FFFFFF'};">
                                    <td style="text-align:center;"><t t-esc="r_index + 1"/></td>
                                    <td style="text-align:center;"><t t-esc="r['cedula']"/></td>
                                    <td><t t-esc="r['nombre']"/></td>
                                    <td style="text-align:right;"><t t-esc="'%.2f' % r['salario_bruto']"/></td>
                                    <td style="text-align:right;"><t t-esc="'%.2f' % r['cuota_obrero']"/></td>
                                    <td style="text-align:right;"><t t-esc="'%.2f' % r['cuota_patronal']"/></td>
                                    <td style="text-align:right;"><t t-esc="'%.2f' % r['total_cuota']"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot style="background-color:#1A5276; color:white; font-weight:bold;">
                            <tr>
                                <td colspan="3" style="text-align:right;">TOTALES</td>
                                <td style="text-align:right;"><t t-esc="'%.2f' % data['total_bruto']"/></td>
                                <td style="text-align:right;"><t t-esc="'%.2f' % data['total_obrero']"/></td>
                                <td style="text-align:right;"><t t-esc="'%.2f' % data['total_patronal']"/></td>
                                <td style="text-align:right;"><t t-esc="'%.2f' % data['total_cuota']"/></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Resumen -->
                    <div style="margin-top:20px; border:1px solid #2E86C1; border-radius:6px; padding:12px;">
                        <h4 style="color:#1A5276; margin:0 0 8px 0;">Resumen de Cuotas</h4>
                        <table style="width:100%; font-size:11px;">
                            <tr>
                                <td style="width:50%; padding:4px;">
                                    <strong>Total Salarios Brutos:</strong>
                                </td>
                                <td style="text-align:right; padding:4px;">
                                    <t t-esc="'%.2f' % data['total_bruto']"/>
                                </td>
                                <td style="width:50%; padding:4px;">
                                    <strong>Total Cuota Obrero (10.83%):</strong>
                                </td>
                                <td style="text-align:right; padding:4px;">
                                    <t t-esc="'%.2f' % data['total_obrero']"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:4px;">
                                    <strong>Total Cuota Patronal (26.83%):</strong>
                                </td>
                                <td style="text-align:right; padding:4px;">
                                    <t t-esc="'%.2f' % data['total_patronal']"/>
                                </td>
                                <td style="padding:4px; background-color:#D6EAF8;">
                                    <strong>TOTAL A PAGAR CCSS:</strong>
                                </td>
                                <td style="text-align:right; padding:4px; background-color:#D6EAF8; font-weight:bold; font-size:13px;">
                                    <t t-esc="'%.2f' % data['total_cuota']"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <p style="font-size:9px; color:#888; margin-top:16px; text-align:center;">
                        Presentar planilla CCSS antes del dia 15 de cada mes en SICERE (sicere.ccss.sa.cr)
                    </p>
                </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_ccss" model="ir.actions.report">
        <field name="name">Planilla CCSS - Patrono</field>
        <field name="model">planilla.ccss.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_ccss_template</field>
        <field name="report_file">planilla_cr.report_ccss_template</field>
        <field name="binding_model_id" ref="base.model_res_company"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

</odoo>
