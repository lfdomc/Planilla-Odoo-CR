<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_overtime_consolidated_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="data" t-value="wizard._get_data()"/>
                <div class="page">
                    <style>
                        body{font-family:Arial,sans-serif;font-size:10px}
                        .hdr{background:#1F4E79;color:white;padding:10px 14px;border-radius:4px 4px 0 0;margin-bottom:12px}
                        .hdr h4{margin:0 0 3px;font-size:13px} .hdr p{margin:0;font-size:9px;opacity:.9}
                        table{width:100%;border-collapse:collapse;margin-bottom:8px}
                        th{background:#1F4E79;color:white;padding:4px 6px;font-size:9px;text-align:right}
                        th:first-child{text-align:left}
                        td{padding:3px 6px;border-bottom:1px solid #E8EDF2;font-size:9px;text-align:right}
                        td:first-child{text-align:left}
                        .grp td{background:#BDD7EE;font-weight:bold;border-top:1px solid #1F4E79}
                        .total-row td{background:#D9E1F2;font-weight:bold;border-top:2px solid #1F4E79}
                        .kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px}
                        .kpi{background:#F0F4F8;padding:6px 10px;border-radius:3px;text-align:center}
                        .kpi-l{font-size:8px;text-transform:uppercase;color:#666;font-weight:bold}
                        .kpi-v{font-size:13px;font-weight:bold;color:#1F4E79}
                    </style>
                    <div class="hdr">
                        <h4>Reporte Consolidado de Horas Extras</h4>
                        <p><t t-out="wizard.company_id.name"/> | Periodo: <t t-out="str(wizard.date_from)"/> al <t t-out="str(wizard.date_to)"/></p>
                    </div>
                    <div class="kpi-grid">
                        <div class="kpi">
                            <div class="kpi-l">Total Horas</div>
                            <div class="kpi-v"><t t-out="'{:.1f}'.format(data['totals']['hours'])"/> h</div>
                        </div>
                        <div class="kpi">
                            <div class="kpi-l">Simples</div>
                            <div class="kpi-v"><t t-out="'{:.1f}'.format(data['totals']['simple'])"/> h</div>
                        </div>
                        <div class="kpi">
                            <div class="kpi-l">Dobles</div>
                            <div class="kpi-v"><t t-out="'{:.1f}'.format(data['totals']['double'])"/> h</div>
                        </div>
                        <div class="kpi" style="background:#FDE8E8">
                            <div class="kpi-l">Monto Total (CRC)</div>
                            <div class="kpi-v" style="color:#C0392B">CRC <t t-out="'{:,.0f}'.format(data['totals']['amount'])"/></div>
                        </div>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th style="width:28%">Empleado</th>
                                <th style="width:18%">Sucursal</th>
                                <th>Tipo</th><th>Fecha</th><th>Horas</th>
                                <th style="color:#FFCC00">Monto (CRC)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['groups']" t-as="grp">
                                <tr class="grp">
                                    <td colspan="4"><t t-out="grp['label']"/></td>
                                    <td><t t-out="'{:.1f}'.format(grp['hours'])"/> h</td>
                                    <td>CRC <t t-out="'{:,.0f}'.format(grp['amount'])"/></td>
                                </tr>
                                <t t-foreach="grp['rows']" t-as="r">
                                    <tr>
                                        <td style="padding-left:12px">  <t t-out="r['employee']"/></td>
                                        <td><t t-out="r['branch']"/></td>
                                        <td><t t-out="r['type']"/></td>
                                        <td><t t-out="r['date']"/></td>
                                        <td><t t-out="'{:.1f}'.format(r['hours'])"/></td>
                                        <td>CRC <t t-out="'{:,.0f}'.format(r['amount'])"/></td>
                                    </tr>
                                </t>
                            </t>
                            <tr class="total-row">
                                <td colspan="4">TOTAL GENERAL</td>
                                <td><t t-out="'{:.1f}'.format(data['totals']['hours'])"/> h</td>
                                <td>CRC <t t-out="'{:,.0f}'.format(data['totals']['amount'])"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_overtime_consolidated" model="ir.actions.report">
        <field name="name">Horas Extras Consolidado</field>
        <field name="model">planilla.overtime.consolidated.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_overtime_consolidated_template</field>
        <field name="print_report_name">'HorasExtras_%s_%s' % (object.date_from, object.date_to)</field>
    </record>
</odoo>
