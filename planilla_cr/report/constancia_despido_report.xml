<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ================================================================
         CONSTANCIA LABORAL
         Base legal CR:
           - Art. 29 Reglamento Interior de Trabajo
           - Practica estandar MTSS / Poder Judicial
           Contenido requerido: nombre, cédula, cargo, salario, fecha ingreso,
           estado (activo), nombre empresa, cédula jurídica, firma patronal.
    ================================================================ -->
        <template id="report_constancia_laboral_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc">
        <t t-set="doc" t-value="doc.sudo()"/>
        <t t-set="company" t-value="doc.company_id.sudo()"/>

        <!-- Cargar config RRHH de la empresa -->
        <t t-set="cfg" t-value="doc.env['planilla.accounting.config'].sudo().search([('company_id','=',company.id)], limit=1)"/>
        <t t-set="rep_name" t-value="cfg.hr_rep_name if cfg and cfg.hr_rep_name else '[CONFIGURAR: Planilla - Config. Contable - Nombre Representante RRHH]'"/>
        <t t-set="rep_title" t-value="cfg.hr_rep_title if cfg and cfg.hr_rep_title else 'Representante Legal'"/>
        <t t-set="rep_phone" t-value="cfg.hr_rep_phone if cfg and cfg.hr_rep_phone else ''"/>
        <t t-set="rep_email" t-value="cfg.hr_rep_email if cfg and cfg.hr_rep_email else ''"/>
        <t t-set="rep_location" t-value="cfg.hr_rep_location if cfg and cfg.hr_rep_location else (company.city or 'Costa Rica')"/>

        <!-- Salario bruto mensual (base_salary es siempre mensual) -->
        <t t-set="sal_bruto" t-value="doc.base_salary or 0.0"/>
        <!-- Salario neto estimado: bruto - CCSS obrero 10.83% -->
        <t t-set="sal_neto" t-value="round(sal_bruto * (1 - 0.1083), 2)"/>

        <!-- Calendarización para texto de frecuencia -->
        <t t-set="frec_texto" t-value="             'quincenal' if doc.payroll_calendar_id and doc.payroll_calendar_id.frequency == 'biweekly' else             'semanal'   if doc.payroll_calendar_id and doc.payroll_calendar_id.frequency == 'weekly'   else             'mensual'         "/>
        <!-- Fecha en palabras (dia, mes, año) en espanol -->
        <t t-set="hoy" t-value="datetime.date.today()"/>
        <t t-set="meses_es" t-value="{             1:'enero', 2:'febrero', 3:'marzo', 4:'abril', 5:'mayo', 6:'junio',             7:'julio', 8:'agosto', 9:'septiembre', 10:'octubre', 11:'noviembre', 12:'diciembre'         }"/>
        <t t-set="mes_texto" t-value="meses_es.get(hoy.month, hoy.strftime('%B'))"/>

        <t t-call="web.external_layout">
            <main>
            <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; padding: 20px; line-height: 1.8;">

                <!-- A QUIÉN INTERESE -->
                <div style="margin-bottom: 30px;">
                    <p style="font-weight:bold; font-size:13px;">A QUIÉN INTERESE</p>
                </div>

                <!-- Cuerpo principal -->
                <div style="text-align:justify; font-size:12px; line-height:2.0;">
                    <p>
                        El suscrito <strong><t t-out="rep_name"/></strong>
                        en su calidad de <t t-out="rep_title"/>
                        de la firma <strong><t t-out="company.name"/></strong>
                        <t t-if="company.vat">
                            con cédula jurídica número <strong><t t-out="company.vat"/></strong>
                        </t>
                        hace constar que el (la) señor(a)
                        <strong><t t-out="doc.name"/></strong>
                        portador(a) de la cédula de identidad número
                        <strong><t t-out="doc.identification_id or 'No registrada'"/></strong>,
                        presta servicios a esta empresa
                        <t t-if="doc.entry_date">
                            desde el
                            <strong><t t-out="doc.entry_date.strftime('%d/%m/%Y')"/></strong>
                        </t>
                        <t t-if="doc.job_id">
                            , como <strong><t t-out="doc.job_id.name"/></strong>
                        </t>
                        , devengando un ingreso bruto mensual de
                        <strong>
                            <t t-out="doc.currency_id.symbol or 'CRC'"/>
                            <t t-out="'{:,.2f}'.format(sal_bruto)"/>
                        </strong>
                        y un salario neto (deducción de cargas sociales) aproximado de
                        <strong>
                            <t t-out="doc.currency_id.symbol or 'CRC'"/>
                            <t t-out="'{:,.2f}'.format(sal_neto)"/>
                        </strong>
                        <t t-if="frec_texto == 'quincenal'">
                            , pagadero en forma quincenal
                            (<t t-out="doc.currency_id.symbol or 'CRC'"/>
                            <t t-out="'{:,.2f}'.format(sal_bruto / 2)"/> por quincena)
                        </t>
                        <t t-set="pensiones_activas" t-value="doc.env['planilla.pension.alimentaria'].sudo().search([('employee_id','=',doc.id),('state','=','active')])"/>
                        <t t-set="embargos_activos" t-value="doc.env['planilla.embargo'].sudo().search([('employee_id','=',doc.id),('state','=','active')])"/>

                        <t t-if="not pensiones_activas and not embargos_activos">
                            , el cual se encuentra libre de todo embargo.
                        </t>
                        <t t-else="">
                            .
                        </t>
                    </p>

                    <!-- Detalle de pensiónes alimentarias activas -->
                    <t t-if="pensiones_activas">
                    <p>
                        Tiene registrada(s) <strong><t t-out="len(pensiones_activas)"/></strong>
                        pensión(es) alimentaria(s) activa(s):
                    </p>
                    <t t-foreach="pensiones_activas" t-as="pen">
                    <p style="margin-left:20px;">
                        - Expediente No. <strong><t t-out="pen.numero_expediente or 'N/D'"/></strong>:
                        <t t-if="pen.calculation_type == 'percentage'">
                            <strong><t t-out="'{:.1f}'.format(pen.percentage)"/>%</strong> del salario bruto
                            (aprox. <t t-out="doc.currency_id.symbol or 'CRC'"/>
                            <t t-out="'{:,.2f}'.format(round((doc.base_salary or 0) * pen.percentage / 100, 2))"/>
                            mensual)
                        </t>
                        <t t-else="">
                            <strong><t t-out="doc.currency_id.symbol or 'CRC'"/>
                            <t t-out="'{:,.2f}'.format(pen.fixed_amount or 0)"/></strong> fijos
                        </t>
                    </p>
                    </t>
                    </t>

                    <!-- Detalle de embargos judiciales activos -->
                    <t t-if="embargos_activos">
                    <p>
                        Tiene registrado(s) <strong><t t-out="len(embargos_activos)"/></strong>
                        embargo(s) judicial(es) activo(s):
                    </p>
                    <t t-foreach="embargos_activos" t-as="emb">
                    <p style="margin-left:20px;">
                        - Embargo judicial:
                        <t t-if="emb.calculation_type == 'percentage'">
                            <strong><t t-out="'{:.1f}'.format(emb.percentage)"/>%</strong> del salario neto disponible
                            (máximo 25% según Art. 172 CT)
                        </t>
                        <t t-else="">
                            <strong><t t-out="doc.currency_id.symbol or 'CRC'"/>
                            <t t-out="'{:,.2f}'.format(emb.fixed_amount or 0)"/></strong> fijos
                        </t>
                    </p>
                    </t>
                    </t>

                    <p style="margin-top: 24px;">
                        Dada en
                        <t t-if="rep_location">
                            <t t-out="rep_location"/>
                        </t>
                        <t t-else="">
                            <t t-out="company.city or 'Costa Rica'"/>
                        </t>
                        ; a los <strong><t t-out="hoy.strftime('%d')"/></strong> días
                        del mes de <strong><t t-out="mes_texto"/></strong>
                        del <strong><t t-out="hoy.strftime('%Y')"/></strong>,
                        a solicitud del interesado.
                    </p>
                </div>

                <!-- Firma -->
                <div style="margin-top: 60px;">
                    <div style="border-top: 1px solid #000; width: 300px; padding-top: 8px; margin-top: 50px;">
                        <p style="margin:0; font-weight:bold;"><t t-out="rep_name"/></p>
                        <p style="margin:0;"><t t-out="rep_title"/></p>
                        <t t-if="rep_phone">
                            <p style="margin:0;">Tel: <t t-out="rep_phone"/></p>
                        </t>
                        <t t-if="rep_email">
                            <p style="margin:0;">Email: <t t-out="rep_email"/></p>
                        </t>
                    </div>
                </div>

                <p style="font-size:9px; color:#aaa; margin-top: 30px;">
                    Planilla CR v5.28 | Odoo 19 | Legislación Costa Rica
                </p>
                <div class="page_break"/>
            </div>
            </main>
        </t>
        </t>
    </t></template>

<record id="action_report_constancia_laboral" model="ir.actions.report">
        <field name="name">Constancia Laboral</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_constancia_laboral_document</field>
        <field name="report_file">planilla_cr.report_constancia_laboral_document</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">'Constancia_Laboral_%s' % (object.name or '').replace(' ', '_')</field>
    </record>


    <!-- ================================================================
         CARTA DE PREAVISO / DESPIDO
         Base legal CR:
           - Art. 28 CT: preaviso según tiempo laborado
           - Art. 29 CT: cesantía (solo despido injustificado)
           - Art. 81 CT: causas justas de despido
           - Art. 83 CT: renuncia voluntaria
         Tipos: despido_justif | despido_injust | renuncia | mutuo_acuerdo
    ================================================================ -->
    <template id="report_carta_despido_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc">
        <t t-set="doc"     t-value="doc.sudo()"/>
        <t t-set="company" t-value="doc.company_id.sudo()"/>
        <t t-set="emp"     t-value="doc.employee_id.sudo()"/>
        <t t-set="cfg"     t-value="doc.env['planilla.accounting.config'].sudo().search([('company_id','=',company.id)], limit=1)"/>
        <t t-set="firmante_nombre" t-value="(cfg.hr_rep_name  if cfg else '') or company.name"/>
        <t t-set="firmante_titulo" t-value="(cfg.hr_rep_title if cfg else '') or 'Representante Legal'"/>
        <t t-set="location"        t-value="(cfg.hr_rep_location if cfg else '') or (company.city or 'Costa Rica')"/>
        <t t-set="meses_es" t-value="{1:'enero',2:'febrero',3:'marzo',4:'abril',5:'mayo',6:'junio',7:'julio',8:'agosto',9:'septiembre',10:'octubre',11:'noviembre',12:'diciembre'}"/>
        <t t-set="fecha_hoy" t-value="doc.termination_date or datetime.date.today()"/>
        <t t-set="mes_texto" t-value="meses_es.get(fecha_hoy.month, '')"/>
        <t t-call="web.external_layout">
            <main>
            <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; padding: 30px 40px; line-height: 1.9; max-width: 680px; margin: 0 auto;">

                <!-- Estimado + Lugar + Fecha (alineado derecha como el machote sin resp.) -->
                <p style="margin-bottom: 20px;">
                    <strong>Estimado(a) Senor(a).
                    <t t-out="location"/>,
                    <t t-out="fecha_hoy.strftime('%d')"/> de <t t-out="mes_texto"/>
                    de <t t-out="fecha_hoy.strftime('%Y')"/></strong>
                </p>

                <!-- Destinatario -->
                <p style="margin-bottom: 2px;"><strong><t t-out="emp.name"/></strong></p>
                <t t-if="emp.identification_id">
                    <p style="margin-bottom: 2px;">
                        Cedula identidad <t t-out="emp.identification_id"/>
                    </p>
                </t>
                <t t-if="emp.job_id">
                    <p style="margin-bottom: 2px;"><t t-out="emp.job_id.name"/></p>
                </t>
                <p style="margin-bottom: 20px;">Presente.</p>

                <!-- ====== DESPIDO SIN RESPONSABILIDAD (justa causa Art. 81) ====== -->
                <t t-if="doc.termination_reason == 'despido_justif'">
                    <p style="text-align: justify; margin-bottom: 14px;">
                        Por medio de la presente, y conforme lo establecido en el Codigo de
                        Trabajo de la Republica de Costa Rica, le comunicamos que la empresa ha
                        decidido dar por terminado su contrato de trabajo a partir del
                        <strong><t t-out="fecha_hoy.strftime('%d')"/> de <t t-out="mes_texto"/>
                        de <t t-out="fecha_hoy.strftime('%Y')"/></strong>,
                        <strong>sin responsabilidad para la misma</strong>,
                        <t t-if="doc.note">
                            debido a: <t t-out="doc.note"/>
                        </t>
                        <t t-else="">
                            debido a incumplimientos graves de sus obligaciones laborales.
                        </t>
                    </p>
                    <p style="text-align: justify; margin-bottom: 14px;">
                        De acuerdo con el <strong>articulo 81 del Codigo de Trabajo</strong>,
                        las causas descritas facultan al patrono para rescindir la relacion laboral
                        sin responsabilidad patronal. A traves de esta notificacion, se le informa
                        que el vinculo laboral queda definitivamente rescindido, y que no se le
                        reconocera indemnizacion alguna ni otros beneficios adicionales.
                    </p>
                    <p style="text-align: justify; margin-bottom: 14px;">
                        Se le invita a coordinar la entrega de los bienes y equipos de la empresa
                        que pudieran estar bajo su responsabilidad. Ademas, se le informara sobre
                        el calculo y entrega de su liquidacion final, la cual incluira los pagos
                        pendientes hasta la fecha de su salida, conforme a lo dispuesto por la ley.
                    </p>
                    <p style="text-align: justify; margin-bottom: 20px;">
                        Le agradecemos el tiempo que estuvo laborando en nuestra empresa y
                        lamentamos que este asunto haya tenido que llegar a esta conclusion.
                    </p>
                </t>

                <!-- ====== DESPIDO CON RESPONSABILIDAD (Art. 85 / preaviso Art. 28) ====== -->
                <t t-elif="doc.termination_reason == 'despido_injust'">
                    <p style="text-align: justify; margin-bottom: 14px;">
                        Por este medio le informo que de conformidad con lo dispuesto en el
                        <strong>articulo 85 inciso d) del Codigo de Trabajo</strong>,
                        la empresa ha decidido dar por terminado el contrato laboral mantenido
                        con su persona <strong><u>con responsabilidad patronal</u></strong>
                        a partir del dia
                        <strong><t t-out="fecha_hoy.strftime('%d')"/> de <t t-out="mes_texto"/>
                        de <t t-out="fecha_hoy.strftime('%Y')"/></strong>,
                        siendo este su ultimo dia de trabajo.
                    </p>
                    <t t-if="doc.note">
                        <p style="text-align: justify; margin-bottom: 14px;">
                            El motivo de la decision se debe a: <t t-out="doc.note"/>
                        </p>
                    </t>
                    <t t-else="">
                        <p style="text-align: justify; margin-bottom: 14px;">
                            El motivo de la decision se debe al cierre de las operaciones
                            definitivas de la empresa.
                        </p>
                    </t>
                    <p style="text-align: justify; margin-bottom: 20px;">
                        Se le agradecen los servicios prestados y para efectos del retiro de
                        todos los extremos laborales de su liquidacion se le solicita
                        presentarse en las instalaciones de la empresa para coordinar la entrega
                        conforme a lo dispuesto por la ley.
                    </p>
                </t>

                <!-- ====== RENUNCIA VOLUNTARIA (Art. 83) ====== -->
                <t t-elif="doc.termination_reason == 'renuncia'">
                    <p style="text-align: justify; margin-bottom: 14px;">
                        Por medio de la presente, el (la) senor(a)
                        <strong><t t-out="emp.name"/></strong>
                        comunica formalmente su renuncia voluntaria al puesto de
                        <strong><t t-out="emp.job_id.name or 'colaborador(a)'"/></strong>
                        en la empresa
                        <strong><t t-out="company.name"/></strong>,
                        con fundamento en el <strong>Articulo 83 del Codigo de Trabajo</strong>,
                        con efectividad a partir del
                        <strong><t t-out="fecha_hoy.strftime('%d')"/> de <t t-out="mes_texto"/>
                        de <t t-out="fecha_hoy.strftime('%Y')"/></strong>.
                    </p>
                    <t t-if="doc.note">
                        <p style="text-align: justify; margin-bottom: 14px;">
                            <t t-out="doc.note"/>
                        </p>
                    </t>
                    <p style="text-align: justify; margin-bottom: 20px;">
                        Se agradece el tiempo y dedicacion brindados a la empresa durante
                        la relacion laboral.
                    </p>
                </t>

                <!-- ====== OTRO MOTIVO ====== -->
                <t t-else="">
                    <p style="text-align: justify; margin-bottom: 14px;">
                        Por medio de la presente, le comunicamos que la empresa ha decidido
                        dar por terminada la relacion laboral con su persona a partir del
                        <strong><t t-out="fecha_hoy.strftime('%d')"/> de <t t-out="mes_texto"/>
                        de <t t-out="fecha_hoy.strftime('%Y')"/></strong>,
                        conforme lo dispuesto en el Codigo de Trabajo de Costa Rica.
                    </p>
                    <t t-if="doc.note">
                        <p style="text-align: justify; margin-bottom: 14px;">
                            <t t-out="doc.note"/>
                        </p>
                    </t>
                </t>

                <p style="margin-bottom: 40px;">Atentamente.</p>

                <!-- Firma patrono -->
                <div style="margin-bottom: 50px;">
                    <div style="border-top: 1px solid #000; width: 300px; padding-top: 6px; margin-bottom: 4px;"/>
                    <strong><t t-out="firmante_nombre"/></strong><br/>
                    <t t-out="firmante_titulo"/><br/>
                    <t t-out="company.name"/>
                </div>

                <!-- Recibido -->
                <div style="margin-top: 20px; border-top: 1px solid #ccc; padding-top: 16px;">
                    <p style="margin-bottom: 24px;">
                        Fecha de recibido: ___________________________________
                    </p>
                    <p style="margin-bottom: 24px;">
                        Nombre de colaborador: ___________________________________
                    </p>
                    <p style="margin-bottom: 10px;">
                        Firma de colaborador: ___________________________________
                    </p>
                    <p style="margin-top: 20px; font-size: 11px; color: #555;">
                        Cc / Expediente personal. Ministerio de Trabajo C.R.
                    </p>
                </div>

            </div>
            </main>
        </t>
        </t>
        </t>
    </template>


    <record id="action_report_carta_despido" model="ir.actions.report">
        <field name="name">Carta de Despido / Renuncia</field>
        <field name="model">planilla.termination</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">planilla_cr.report_carta_despido_document</field>
        <field name="report_file">planilla_cr.report_carta_despido_document</field>
        <field name="binding_model_id" ref="model_planilla_termination"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">'Carta_%s' % (object.name or 'Despido').replace(' ', '_')</field>
    </record>

</odoo>
