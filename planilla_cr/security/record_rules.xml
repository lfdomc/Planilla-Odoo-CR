    <!-- ══════════════════════════════════════════════════════════
         CONFIGURACIÓN CONTABLE — planilla.accounting.config
         Solo admin puede ver config de otras compañías
         ══════════════════════════════════════════════════════════ -->
    <record id="rule_accounting_config_company" model="ir.rule">
        <field name="name">Config Contable: solo compañía activa</field>
        <field name="model_id" ref="model_planilla_accounting_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('planilla_cr.group_planilla_operador'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
