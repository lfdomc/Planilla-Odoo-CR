<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        BUG #12 FIX v50 — Reglas de registro por company_id (multi-empresa)
        Previene que usuarios vean datos salariales de otras compañías.
        Las ir.rule filtran a nivel de dominio ORM — no se pueden evadir por URL.
        Aplica a los modelos con información sensible de nómina.
    -->

    <!-- ══════════════════════════════════════════════════════════
         BOLETAS DE PAGO — planilla.payslip.cr
         ══════════════════════════════════════════════════════════ -->
    <record id="rule_payslip_company" model="ir.rule">
        <field name="name">Boletas: solo compañía activa</field>
        <field name="model_id" ref="model_planilla_payslip_cr"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('planilla_cr.group_planilla_operador'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         PLANILLAS (RUNS) — planilla.run.cr
         ══════════════════════════════════════════════════════════ -->
    <record id="rule_payroll_run_company" model="ir.rule">
        <field name="name">Planillas: solo compañía activa</field>
        <field name="model_id" ref="model_planilla_run_cr"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('planilla_cr.group_planilla_operador'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         PRÉSTAMOS — planilla.employee.loan
         Usa branch_id.company_id como pivot (loans no tienen company_id directo)
         ══════════════════════════════════════════════════════════ -->
    <record id="rule_loan_company" model="ir.rule">
        <field name="name">Préstamos: solo compañía activa</field>
        <field name="model_id" ref="model_planilla_employee_loan"/>
        <field name="domain_force">
            ['|',
             ('employee_id.company_id', 'in', company_ids),
             ('employee_id.company_id', '=', False)]
        </field>
        <field name="groups" eval="[(4, ref('planilla_cr.group_planilla_operador'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         PENSIÓN ALIMENTARIA — planilla.pension.alimentaria
         ══════════════════════════════════════════════════════════ -->
