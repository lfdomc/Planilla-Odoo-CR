<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_planilla_operador" model="res.groups">
        <field name="name">Planilla CR / Operador</field>
        <field name="comment">Puede crear boletas en borrador y registrar novedades. No puede confirmar ni pagar.</field>
    </record>

    <record id="group_planilla_aprobador" model="res.groups">
        <field name="name">Planilla CR / Aprobador</field>
        <field name="implied_ids" eval="[(4, ref('group_planilla_operador'))]"/>
        <field name="comment">Puede confirmar boletas, aprobar novedades y ejecutar pagos de planilla.</field>
    </record>

    <record id="group_planilla_admin" model="res.groups">
        <field name="name">Planilla CR / Administrador</field>
        <field name="implied_ids" eval="[(4, ref('group_planilla_aprobador'))]"/>
        <field name="comment">Acceso total: configuracion contable, periodos cerrados y administracion de roles.</field>
    </record>

    <record id="group_sp_enabled" model="res.groups">
        <field name="name">Planilla CR / Servicios Profesionales</field>
    </record>

</odoo>
