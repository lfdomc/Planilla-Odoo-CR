<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employer_cost_report_form" model="ir.ui.view">
        <field name="name">planilla.employer.cost.report.form</field>
        <field name="model">planilla.employer.cost.report</field>
        <field name="arch" type="xml">
            <form string="Reporte de Costos Patronales">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>📊 Costos Patronales:</strong>
                        Muestra CCSS patronal, INS, aguinaldo, cesantía y vacaciones provisión.
                        Solo boletas en estado <strong>PAGADO</strong>.
                    </div>
                    <group>
                        <group string="Filtros">
                            <field name="company_id"/>
                            <field name="branch_id"/>
                        </group>
                        <group string="Período">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="group_by"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pdf" type="object"
                            string="📄 Generar PDF" class="btn-primary"/>
                    <button name="action_export_excel" type="object"
                            string="📥 Exportar Excel" class="btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_employer_cost_report_wizard" model="ir.actions.act_window">
        <field name="name">Costos Patronales Consolidado</field>
        <field name="res_model">planilla.employer.cost.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
