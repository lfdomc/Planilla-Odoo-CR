<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_test_email_wizard_form" model="ir.ui.view">
        <field name="name">planilla.test.email.wizard.form</field>
        <field name="model">planilla.test.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Correo de Prueba">
                <group>
                    <field name="recipient" placeholder="correo@destinatario.com"/>
                    <field name="config_id" invisible="1"/>
                </group>
                <div class="text-muted" style="font-size:12px; margin: 4px 0 8px 0;">
                    Se enviara un correo con el asunto y cuerpo configurados.
                    Si hay una boleta confirmada se adjunta como ejemplo.
                </div>
                <footer>
                    <button name="action_send" type="object"
                            string="Enviar Correo de Prueba" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>