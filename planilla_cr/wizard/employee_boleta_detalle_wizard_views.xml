<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_boleta_detalle_wizard" model="ir.ui.view">
    <field name="name">planilla.employee.boleta.detalle.wizard.form</field>
    <field name="model">planilla.employee.boleta.detalle.wizard</field>
    <field name="arch" type="xml">
      <form string="Detalle Completo de Boletas por Empleado">
        <sheet>
          <div class="alert alert-info" role="alert">
            <i class="fa fa-info-circle"/>
            Genera un Excel con TODA la informacion de las boletas en el
            rango indicado: ingresos, deducciones, cargas patronales,
            incapacidades y provisiones -- los mismos datos de las
            pestañas de la boleta en pantalla, pero en una sola hoja
            para auditar boleta por boleta sin abrir cada una
            manualmente. Deje "Empleado" vacio para incluir a todos.
          </div>
          <group>
            <group>
              <field name="company_id"/>
              <field name="employee_id"/>
              <field name="branch_id"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="incluir_borradores"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_generate" type="object"
                  string="Generar Detalle" class="btn-primary"/>
          <button special="cancel" string="Cancelar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_employee_boleta_detalle_wizard" model="ir.actions.act_window">
    <field name="name">Detalle Completo de Boletas por Empleado</field>
    <field name="res_model">planilla.employee.boleta.detalle.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
