<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_aguinaldo_auditoria_wizard" model="ir.ui.view">
    <field name="name">planilla.aguinaldo.auditoria.wizard.form</field>
    <field name="model">planilla.aguinaldo.auditoria.wizard</field>
    <field name="arch" type="xml">
      <form string="Auditoria de Aguinaldo: Odoo vs Excel Empresa">
        <sheet>
          <div class="alert alert-info" role="alert">
            <i class="fa fa-info-circle"/>
            Compara, empleado por empleado, el calculo real de Odoo
            (metodo centralizado, el mismo que usan el Wizard de
            Aguinaldo, la Liquidacion, y el Simulador) contra el Excel
            real de la empresa que usted cargue -- para confirmar que
            coincidan, o encontrar exactamente donde hay diferencias.
            El Excel cargado NUNCA se modifica, solo se lee para
            comparar.
          </div>
          <group>
            <group>
              <field name="company_id"/>
              <field name="year" string="Año del Aguinaldo"/>
              <field name="hasta_columna" string="Excel Actualizado Hasta"/>
            </group>
            <group>
              <field name="excel_file" filename="excel_filename"
                     string="Excel de la Empresa"/>
              <field name="excel_filename" invisible="1"/>
              <field name="sheet_name" string="Nombre de la Hoja"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_generate" type="object"
                  string="Generar Auditoria" class="btn-primary"/>
          <button special="cancel" string="Cancelar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_aguinaldo_auditoria_wizard" model="ir.actions.act_window">
    <field name="name">Auditoria de Aguinaldo (Odoo vs Excel)</field>
    <field name="res_model">planilla.aguinaldo.auditoria.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
