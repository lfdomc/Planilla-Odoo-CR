<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_acciones_personal_wizard" model="ir.ui.view">
    <field name="name">planilla.acciones.personal.wizard.form</field>
    <field name="model">planilla.acciones.personal.wizard</field>
    <field name="arch" type="xml">
      <form string="Acciones de Personal Consolidadas">
        <sheet>
          <div class="alert alert-info" role="alert">
            <i class="fa fa-info-circle"/>
            Genera un Excel con TODAS las novedades del rango indicado:
            incapacidades (CCSS/INS/Maternidad), permisos/licencias,
            bonos, vacaciones pagadas, pensiones alimentarias y
            embargos -- en una sola hoja ordenada por empleado, para
            auditar de un vistazo que le paso a cada persona sin abrir
            cada submenu por separado. Deje "Empleado" vacio para
            incluir a todos.
          </div>
          <group>
            <group>
              <field name="company_id"/>
              <field name="employee_id"/>
              <field name="branch_id"/>
            </group>
            <group>
              <field name="date_from"/>
              <field name="date_to"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_generate" type="object"
                  string="Generar Reporte" class="btn-primary"/>
          <button special="cancel" string="Cancelar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_acciones_personal_wizard" model="ir.actions.act_window">
    <field name="name">Acciones de Personal Consolidadas</field>
    <field name="res_model">planilla.acciones.personal.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
