<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_diagnostico_sistema_wizard" model="ir.ui.view">
    <field name="name">planilla.diagnostico.sistema.wizard.form</field>
    <field name="model">planilla.diagnostico.sistema.wizard</field>
    <field name="arch" type="xml">
      <form string="Diagnostico Integral del Sistema">
        <sheet>
          <div class="alert alert-info" role="alert">
            <i class="fa fa-stethoscope"/>
            Genera UN SOLO Excel que combina: Auditoria de Aguinaldo
            (si adjunta el Excel de la empresa), Detalle Mensual de
            Aguinaldo, Detalle Completo de Boletas y Acciones de
            Personal -- con una portada de Resumen Ejecutivo al
            inicio. Cada hoja reusa el mismo reporte individual, asi
            que los numeros coinciden exactamente con los reportes
            separados.
          </div>
          <group>
            <group string="Aguinaldo">
              <field name="company_id"/>
              <field name="year"/>
              <field name="excel_empresa" filename="excel_empresa_filename"/>
              <field name="excel_empresa_filename" invisible="1"/>
              <field name="hasta_columna" invisible="not excel_empresa"/>
            </group>
            <group string="Acciones de Personal / Boletas">
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="incluir_detalle_boletas"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_generate" type="object"
                  string="Generar Diagnostico" class="btn-primary"/>
          <button special="cancel" string="Cancelar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_diagnostico_sistema_wizard" model="ir.actions.act_window">
    <field name="name">Diagnostico Integral del Sistema</field>
    <field name="res_model">planilla.diagnostico.sistema.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
