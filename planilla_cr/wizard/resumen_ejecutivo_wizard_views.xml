<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_resumen_ejecutivo_wizard" model="ir.ui.view">
    <field name="name">planilla.resumen.ejecutivo.wizard.form</field>
    <field name="model">planilla.resumen.ejecutivo.wizard</field>
    <field name="arch" type="xml">
      <form string="Resumen Ejecutivo de Planilla">
        <sheet>
          <div class="alert alert-info" role="alert">
            Genera un resumen ejecutivo en Excel con ingresos y rebajos
            por empleado, subtotales por departamento y totales generales,
            con el mismo formato del reporte oficial de Mundopet.
          </div>
          <group>
            <group>
              <field name="company_id"/>
              <field name="payroll_run_id" options="{'no_create': True}"/>
            </group>
            <group>
              <field name="elaborado_por" string="Elaborado por"/>
              <field name="include_draft" string="Incluir boletas en borrador"/>
            </group>
          </group>
          <div invisible="not include_draft"
               style="background:#FFF3CD; padding:8px 12px; border-radius:4px;
                      border-left:4px solid #FFC107; margin:4px 0;">
            <i class="fa fa-exclamation-triangle"/> Incluye boletas en borrador.
            Use solo para revisión interna antes de confirmar la planilla.
          </div>
        </sheet>
        <footer>
          <button name="action_generate" type="object"
                  string="Generar Excel" class="btn-primary"/>
          <button special="cancel" string="Cancelar" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_resumen_ejecutivo_wizard" model="ir.actions.act_window">
    <field name="name">Resumen Ejecutivo</field>
    <field name="res_model">planilla.resumen.ejecutivo.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
