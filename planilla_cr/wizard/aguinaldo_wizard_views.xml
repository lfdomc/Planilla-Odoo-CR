<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aguinaldo_wizard_form" model="ir.ui.view">
        <field name="name">planilla.aguinaldo.wizard.form</field>
        <field name="model">planilla.aguinaldo.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte Decimo Mes (Aguinaldo)">
                <sheet>
                    <div style="background:#1F4E79; color:white; border-radius:6px; padding:12px; margin-bottom:16px;">
                        <h3 style="margin:0; color:white;"><i class="fa fa-star" title="Star"/> Cálculo de Aguinaldo -- Art. 228 Código de Trabajo CR</h3>
                        <small>Calcula el aguinaldo real de cada empleado basado en los salarios
                        ordinarios recibidos en el período junio-noviembre.</small>
                    </div>

                    <group>
                        <group>
                            <field name="year"/>
                            <field name="branch_id"/>
                            <field name="salary_basis"/>
                        </group>
                        <group invisible="not computed">
                            <field name="total_aguinaldo"/>
                        </group>
                    </group>
                    <div invisible="salary_basis == 'base'"
                         style="background:#d4edda; border-radius:4px; padding:8px; font-size:12px; color:#155724; margin-bottom:8px;">
                        <i class="fa fa-check" title="Check"/> <strong>Salario Bruto recomendado</strong> -- Art. 228 CT incluye horas extras
                        y vacaciones pagadas en el período junio-noviembre como parte del salario ordinario.
                    </div>
                    <div invisible="salary_basis == 'gross'"
                         style="background:#fff3cd; border-radius:4px; padding:8px; font-size:12px; color:#856404; margin-bottom:8px;">
                        <i class="fa fa-exclamation-triangle" title="Exclamation Triangle"/> <strong>Solo Salario Base</strong> -- No incluye horas extras ni vacaciones.
                        Uselo solo si los componentes adicionales no son parte del salario ordinario en su empresa.
                    </div>

                    <div class="o_form_buttons_view" style="margin-bottom:12px;">
                        <button name="action_compute" type="object"
                                string="Calcular Aguinaldo" class="btn-primary"/>
                        <button name="action_print_aguinaldo_pdf" string="Imprimir PDF" type="object" class="btn-secondary" icon="fa-file-pdf-o"/>
                <button name="action_export_excel" type="object"
                                string="Exportar Excel" class="btn-success"
                                invisible="not computed"/>
                    </div>

                    <!-- Tabla de resultados -->
                    <field name="result_ids" invisible="not computed"
                           form_view_ref="planilla_cr.view_aguinaldo_line_form">
                        <list string="Aguinaldo por Empleado" >
                            <field name="currency_id" column_invisible="1"/>
                            <field name="employee_id" string="Empleado"/>
                            <field name="branch" string="Sucursal"/>
                            <field name="slip_count" string="Boletas Jun-Nov" optional="hide"/>
                            <field name="months_worked" string="Meses Jun-Nov" optional="hide"/>
                            <field name="total_ordinary" string="Salarios Ordinarios"
                                   widget="monetary" sum="Total" optional="hide"/>
                            <field name="aguinaldo_amount" string="Aguinaldo Jun-Nov"
                                   widget="monetary" sum="Total Aguinaldo"/>
                            <field name="initial_amount" string="Acum. Inicial"
                                   widget="monetary" sum="Total Inicial" optional="show"/>
                            <field name="provision_acumulada"
                                   string="Provisionado dic→hoy"
                                   widget="monetary" sum="Total Provisionado"/>
                            <field name="total_acumulado"
                                   string="Total Acumulado"
                                   widget="monetary" sum="Gran Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aguinaldo_line_form" model="ir.ui.view">
        <field name="name">planilla.aguinaldo.line.form</field>
        <field name="model">planilla.aguinaldo.line</field>
        <field name="arch" type="xml">
            <form string="Detalle por Empleado">
                <field name="currency_id" invisible="1"/>
                <group>
                    <group string="Identificación">
                        <field name="employee_id" readonly="1"/>
                        <field name="branch" readonly="1"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle"/>
                    El Aguinaldo (Art. 228 CT) se calcula sobre el año completo
                    Diciembre-Noviembre. El sistema arma ese año completo con
                    DOS fuentes de datos distintas (ver desglose abajo), pero
                    el campo "Aguinaldo" ya es el resultado FINAL de todo el año
                    -- no es necesario sumarle nada más.
                </div>
                <group string="Desglose: de dónde sale el Aguinaldo del año completo">
                    <group string="Diciembre - Mayo (capturado al implementar el sistema)">
                        <field name="initial_amount" string="Acumulado Inicial" readonly="1"/>
                    </group>
                    <group string="Junio - Noviembre (calculado desde boletas del sistema)">
                        <field name="slip_count" string="Boletas usadas" readonly="1"/>
                        <field name="months_worked" string="Meses trabajados" readonly="1"/>
                        <field name="total_ordinary" string="Salarios Ordinarios del semestre" readonly="1"/>
                    </group>
                </group>
                <group string="Resultado: Aguinaldo del Año Completo (Dic-Nov)">
                    <field name="aguinaldo_amount"
                           string="AGUINALDO A PAGAR (Inicial + Jun-Nov, ya sumados)"
                           readonly="1" style="font-weight:bold; font-size:1.15em;"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    <i class="fa fa-exclamation-triangle"/>
                    Los campos de abajo son un cálculo APARTE, sin relación con
                    el Aguinaldo de arriba: es la provisión mensual que se va
                    acumulando en la contabilidad, desde la fecha de corte del
                    empleado hasta hoy (puede cubrir más o menos meses que el
                    Aguinaldo del año, según cuándo se implementó el sistema
                    para cada empleado).
                </div>
                <group string="Provisión Contable Acumulada (independiente del Aguinaldo de arriba)">
                    <field name="provision_acumulada" string="Provisión de boletas posteriores al corte" readonly="1"/>
                    <field name="total_acumulado" string="Total Acumulado (Inicial + Provisión)"
                           readonly="1" style="font-weight:bold;"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_aguinaldo_wizard" model="ir.actions.act_window">
        <field name="name">Decimo Mes (Aguinaldo)</field>
        <field name="res_model">planilla.aguinaldo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
