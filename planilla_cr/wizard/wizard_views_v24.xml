<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Feature 4: Horas Extras Consolidado ── -->
    <record id="view_overtime_consolidated_form" model="ir.ui.view">
        <field name="name">planilla.overtime.consolidated.report.form</field>
        <field name="model">planilla.overtime.consolidated.report</field>
        <field name="arch" type="xml">
            <form string="Reporte Consolidado de Horas Extras">
                <sheet>
                    <group>
                        <group><field name="company_id"/><field name="branch_id"/></group>
                        <group><field name="date_from"/><field name="date_to"/><field name="group_by"/></group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pdf"   type="object" string="PDF"   class="btn-primary"/>
                    <button name="action_export_excel"   type="object" string="Excel" class="btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_overtime_consolidated_wizard" model="ir.actions.act_window">
        <field name="name">Horas Extras Consolidado</field>
        <field name="res_model">planilla.overtime.consolidated.report</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

    <!-- ── Feature 5: MTSS Export ── -->
    <record id="view_mtss_export_form" model="ir.ui.view">
        <field name="name">planilla.mtss.export.form</field>
        <field name="model">planilla.mtss.export</field>
        <field name="arch" type="xml">
            <form string="Exportación MTSS">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong><i class="fa fa-clipboard" title="Clipboard"/> Planilla MTSS:</strong> Formato para inspecciones del Ministerio de Trabajo.
                        Incluye empleados activos con cédula, jornada, salario y datos CCSS.
                    </div>
                    <group>
                        <group><field name="company_id"/><field name="branch_id"/></group>
                        <group><field name="date_from"/><field name="date_to"/><field name="include_inactive"/></group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_excel" type="object" string="Exportar Excel MTSS" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mtss_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportación MTSS</field>
        <field name="res_model">planilla.mtss.export</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

    <!-- ── Feature 8: Simulador de Liquidación ── -->
    <record id="view_termination_simulator_form" model="ir.ui.view">
        <field name="name">planilla.termination.simulator.form</field>
        <field name="model">planilla.termination.simulator</field>
        <field name="arch" type="xml">
            <form string="Simulador de Liquidación Laboral">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Simulador:</strong> Estima el costo de una liquidación. No guarda ni modifica datos reales.
                    </div>

                    <!-- SECCIÓN 1: Parámetros de entrada -->
                    <group string="Parámetros de la Simulación">
                        <group>
                            <field name="employee_id"/>
                            <field name="simulated_date"/>
                            <field name="termination_reason"/>
                        </group>
                        <group string="Datos del Empleado" invisible="not entry_date">
                            <field name="entry_date" readonly="1"/>
                            <field name="years_service" readonly="1" invisible="not computed"/>
                            <field name="last_salary" readonly="1" invisible="not computed"/>
                            <field name="department" readonly="1"/>
                            <field name="job_position" readonly="1"/>
                            <field name="branch_name" readonly="1"/>
                        </group>
                    </group>

                    <!-- SECCIÓN 2: Desglose del cálculo -->
                    <group string="Desglose de la Liquidación" invisible="not computed">
                        <group string="Componentes">
                            <field name="preaviso_days" readonly="1"/>
                            <field name="preaviso_amount" readonly="1"/>
                            <field name="cesantia_amount" readonly="1"/>
                            <field name="vacation_days" readonly="1"/>
                            <field name="vacation_amount" readonly="1"/>
                            <field name="aguinaldo_months" readonly="1"/>
                            <field name="aguinaldo_amount" readonly="1"/>
                        </group>
                        <group string="Totales">
                            <field name="total_gross" readonly="1"/>
                            <field name="ccss_on_total" readonly="1"/>
                            <field name="total_net" readonly="1"
                                   style="font-weight:bold;color:#E67E22;"/>
                        </group>
                    </group>

                    <!-- SECCIÓN 3: Préstamos y adelantos pendientes -->
                    <group string="Préstamos y Adelantos Pendientes" invisible="not computed">
                        <div class="alert alert-warning" role="alert" invisible="has_loans">
                            El empleado no tiene préstamos ni adelantos pendientes.
                        </div>
                        <field name="loan_line_ids" readonly="1" invisible="not has_loans" nolabel="1" colspan="2">
                            <list>
                                <field name="loan_type"/>
                                <field name="amount_total"/>
                                <field name="amount_paid"/>
                                <field name="amount_pending" decoration-danger="amount_pending &gt; 0"/>
                            </list>
                        </field>
                        <group invisible="not has_loans">
                            <field name="total_loans_pending" readonly="1"
                                   style="font-weight:bold;color:#E74C3C;"/>
                        </group>
                    </group>

                    <!-- SECCIÓN 4: Total final -->
                    <group string="Total a Pagar al Empleado" invisible="not computed">
                        <group>
                            <field name="total_net" readonly="1" string="Neto liquidación"/>
                            <field name="total_loans_pending" readonly="1" string="Menos: deudas pendientes"
                                   style="color:#E74C3C;"/>
                            <field name="total_final" readonly="1"
                                   style="font-weight:bold;font-size:16px;color:#27AE60;"/>
                        </group>
                    </group>

                    <!-- SECCIÓN 5: Notas legales -->
                    <group string="Notas del Cálculo" invisible="not computed">
                        <field name="notes" readonly="1" nolabel="1" colspan="2"
                               style="font-family:monospace;font-size:11px;background:#F8F9FA;padding:8px;"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_simulate" type="object" string="Calcular Liquidación"
                            class="btn-primary" invisible="computed"/>
                    <button name="action_simulate" type="object" string="Recalcular"
                            class="btn-secondary" invisible="not computed"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_termination_simulator" model="ir.actions.act_window">
        <field name="name">Simulador de Liquidación</field>
        <field name="res_model">planilla.termination.simulator</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

    <!-- ── Feature 10: ZIP Auditoría ── -->
    <record id="view_audit_zip_wizard_form" model="ir.ui.view">
        <field name="name">planilla.audit.zip.wizard.form</field>
        <field name="model">planilla.audit.zip.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportación ZIP para Auditoría">
                <sheet>
                    <div class="alert alert-success" role="alert">
                        <strong>Paquete de Auditoría:</strong> Genera un ZIP con todos los documentos del período
                        listo para entregar al auditor externo.
                    </div>
                    <group>
                        <group string="Filtros">
                            <field name="company_id"/><field name="branch_id"/>
                            <field name="date_from"/><field name="date_to"/>
                        </group>
                        <group string="Documentos a incluir">
                            <field name="include_payslips_pdf"/>
                            <field name="include_employer_cost"/>
                            <field name="include_mtss"/>
                            <field name="include_overtime"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_zip" type="object"
                            string="Generar ZIP" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_audit_zip_wizard" model="ir.actions.act_window">
        <field name="name">Exportación ZIP Auditoría</field>
        <field name="res_model">planilla.audit.zip.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

</odoo>
