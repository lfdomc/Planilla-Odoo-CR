<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Feature 4: Horas Extras Consolidado ── -->
    <record id="view_overtime_consolidated_form" model="ir.ui.view">
        <field name="name">planilla.overtime.consolidated.report.form</field>
        <field name="model">planilla.overtime.consolidated.report</field>
        <field name="arch" type="xml">
            <form string="Reporte Consolidado de Horas Extras">
                <sheet>
                    <group>
                        <group><field name="company_id"/><field name="branch_id"/></group>
                        <group><field name="date_from"/><field name="date_to"/><field name="group_by"/></group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_pdf"   type="object" string="PDF"   class="btn-primary"/>
                    <button name="action_export_excel"   type="object" string="Excel" class="btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_overtime_consolidated_wizard" model="ir.actions.act_window">
        <field name="name">Horas Extras Consolidado</field>
        <field name="res_model">planilla.overtime.consolidated.report</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

    <!-- ── Feature 5: MTSS Export ── -->
    <record id="view_mtss_export_form" model="ir.ui.view">
        <field name="name">planilla.mtss.export.form</field>
        <field name="model">planilla.mtss.export</field>
        <field name="arch" type="xml">
            <form string="Exportación MTSS">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <strong><i class="fa fa-clipboard" title="Clipboard"/> Planilla MTSS:</strong> Formato para inspecciónes del Ministerio de Trabajo.
                        Incluye empleados activos con cédula, jornada, salario y datos CCSS.
                    </div>
                    <group>
                        <group><field name="company_id"/><field name="branch_id"/></group>
                        <group><field name="date_from"/><field name="date_to"/><field name="include_inactive"/></group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_excel" type="object" string="Exportar Excel MTSS" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mtss_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportación MTSS</field>
        <field name="res_model">planilla.mtss.export</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

    <!-- Simulador de Liquidación -->
    <record id="view_termination_simulator_form" model="ir.ui.view">
        <field name="name">planilla.termination.simulator.form</field>
        <field name="model">planilla.termination.simulator</field>
        <field name="arch" type="xml">
            <form string="Simulador de Liquidación Laboral">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Simulador:</strong> Estima el costo de una liquidación. No guarda ni modifica datos reales.
                    </div>

                    <!-- Parámetros -->
                    <group string="Parámetros de la Simulación">
                        <group>
                            <field name="employee_id"/>
                            <field name="simulated_date"/>
                            <field name="termination_reason"/>
                        </group>
                        <group string="Salarios &#250;ltimos 6 meses (Art. 153 CT)">
                            <div colspan="2" class="alert alert-info" role="alert"
                                 style="margin-bottom:8px;">
                                Los salarios brutos se pre-cargan autom&#225;ticamente
                                desde las boletas pagadas en el sistema. Puede
                                editarlos o completar los que falten. El promedio
                                se calcula solo sobre los meses con valor (igual
                                que el Excel de RRHH).
                            </div>
                            <!-- Fila 1: mes 1 y 2 -->
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:8px;">
                                <div>
                                    <label for="sal_m1" style="font-size:12px;color:#666;">Mes 1 (m&#225;s reciente)</label>
                                    <field name="sal_m1" nolabel="1"
                                           style="width:100%;font-size:15px;padding:6px 10px;border:1px solid #ccc;border-radius:4px;"/>
                                </div>
                                <div>
                                    <label for="sal_m2" style="font-size:12px;color:#666;">Mes 2</label>
                                    <field name="sal_m2" nolabel="1"
                                           style="width:100%;font-size:15px;padding:6px 10px;border:1px solid #ccc;border-radius:4px;"/>
                                </div>
                            </div>
                            <!-- Fila 2: mes 3 y 4 -->
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:8px;">
                                <div>
                                    <label for="sal_m3" style="font-size:12px;color:#666;">Mes 3</label>
                                    <field name="sal_m3" nolabel="1"
                                           style="width:100%;font-size:15px;padding:6px 10px;border:1px solid #ccc;border-radius:4px;"/>
                                </div>
                                <div>
                                    <label for="sal_m4" style="font-size:12px;color:#666;">Mes 4</label>
                                    <field name="sal_m4" nolabel="1"
                                           style="width:100%;font-size:15px;padding:6px 10px;border:1px solid #ccc;border-radius:4px;"/>
                                </div>
                            </div>
                            <!-- Fila 3: mes 5 y 6 -->
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                                <div>
                                    <label for="sal_m5" style="font-size:12px;color:#666;">Mes 5</label>
                                    <field name="sal_m5" nolabel="1"
                                           style="width:100%;font-size:15px;padding:6px 10px;border:1px solid #ccc;border-radius:4px;"/>
                                </div>
                                <div>
                                    <label for="sal_m6" style="font-size:12px;color:#666;">Mes 6 (m&#225;s antiguo)</label>
                                    <field name="sal_m6" nolabel="1"
                                           style="width:100%;font-size:15px;padding:6px 10px;border:1px solid #ccc;border-radius:4px;"/>
                                </div>
                            </div>
                            <!-- Resumen -->
                            <div style="background:#f0f7ff;border-radius:6px;padding:10px 14px;display:flex;justify-content:space-between;align-items:center;">
                                <span style="color:#555;font-size:13px;">
                                    Meses con salario:
                                    <field name="sal_meses_con_valor" nolabel="1"
                                           style="display:inline;width:30px;font-weight:bold;border:none;background:transparent;"/>
                                </span>
                                <span style="font-size:15px;font-weight:bold;color:#1a73e8;">
                                    Promedio:
                                    <field name="sal_promedio_calc" nolabel="1"
                                           style="display:inline;font-weight:bold;color:#1a73e8;border:none;background:transparent;font-size:15px;"/>
                                </span>
                            </div>
                            <field name="use_salary_average" invisible="1"/>
                            <field name="salary_average_manual" invisible="1"/>
                        </group>
                        <group string="Datos del Empleado" invisible="not entry_date">
                            <field name="entry_date" readonly="1"/>
                            <field name="years_service" readonly="1" invisible="not computed"
                                   string="Años de Servicio"/>
                            <field name="last_salary" readonly="1" invisible="not computed"/>
                            <field name="department" readonly="1"/>
                            <field name="job_position" readonly="1"/>
                            <field name="branch_name" readonly="1"/>
                        </group>
                    </group>

                    <!-- Desglose -->
                    <group string="Desglose de la Liquidación" invisible="not computed">

                        <!-- Preaviso -->
                        <group string="Preaviso (Art. 28 CT)">
                            <field name="preaviso_applies" string="¿Aplica preaviso?"/>
                            <field name="preaviso_days" readonly="1" string="Días de Preaviso"
                                   invisible="not preaviso_applies"/>
                            <field name="preaviso_amount" readonly="1" string="Monto Preaviso (CRC)"
                                   invisible="not preaviso_applies"/>
                        </group>

                        <!-- Cesantía -->
                        <group string="Cesantía (Art. 29 CT)">
                            <field name="cesantia_days" string="Días de Cesantía"
                                   help="Pre-calculado por ley Art. 29 CT. Puede editar si la empresa usa criterio diferente (ej: 14 dias en lugar de 18.33)."/>
                            <field name="cesantia_daily" readonly="1" string="Salario Diario (CRC)"/>
                            <field name="cesantia_amount" readonly="1" string="Monto Cesantía (CRC)"/>
                            <button name="action_recalculate_cesantia" type="object"
                                    string="↻ Recalcular Cesantía con días editados"
                                    class="btn-secondary"
                                    invisible="cesantia_days_locked"
                                    colspan="2"/>
                        </group>

                        <!-- Vacaciones -->
                        <group string="Vacaciones (Art. 153 CT)">
                            <field name="vac_initial_days" readonly="1"
                                   string="Días Saldo Inicial (pre-sistema)"
                                   invisible="vac_initial_days == 0"/>
                            <field name="vac_accrued_since" readonly="1"
                                   string="Días Acumulados desde Corte"
                                   invisible="vac_initial_days == 0"/>
                            <field name="vac_taken_system" readonly="1"
                                   string="Días Tomados en Sistema"
                                   invisible="vac_taken_system == 0"/>
                            <field name="vacation_days" readonly="1"
                                   string="Total Días a Pagar"/>
                            <field name="vac_daily_rate" readonly="1" string="Salario Diario (CRC)"/>
                            <field name="vacation_amount" readonly="1" string="Monto Vacaciones (CRC)"/>
                        </group>

                        <!-- Aguinaldo -->
                        <group string="Aguinaldo (Art. 228 CT)">
                            <field name="aguinaldo_initial" readonly="1"
                                   string="Acumulado Inicial (pre-sistema)"
                                   invisible="aguinaldo_initial == 0"/>
                            <field name="aguinaldo_system" readonly="1"
                                   string="Del Sistema (boletas)"
                                   invisible="aguinaldo_initial == 0"/>
                            <field name="aguinaldo_months" readonly="1" string="Meses en Período"/>
                            <field name="aguinaldo_amount" readonly="1" string="Monto Aguinaldo (CRC)"/>
                        </group>

                        <!-- Totales -->
                        <group string="Totales">
                            <field name="total_gross" readonly="1"
                                   string="Subtotal Bruto (CRC)"
                                   help="Suma bruta: preaviso + cesantia + vacaciones + aguinaldo. Aguinaldo y cesantia estan exentos de CCSS y Renta."/>
                            <field name="ccss_rate" readonly="1"
                                   string="Tasa CCSS Obrero (%)"
                                   help="CCSS se aplica SOLO sobre vacaciones y preaviso. Aguinaldo (Art.35 Ley CCSS) y cesantia (Art.173 CT) estan exentos."/>
                            <field name="ccss_on_total" readonly="1"
                                   string="CCSS Obrero (vac+preaviso)"/>
                            <field name="total_net" readonly="1"
                                   string="Neto a Pagar (CRC)"
                                   style="font-weight:bold;color:#27AE60;"/>
                        </group>
                        <div class="alert alert-info" role="alert">
                            <strong>Exenciones legales:</strong>
                            Aguinaldo (Art. 35 Ley CCSS) y Cesant&#237;a (Art. 173 CT)
                            est&#225;n exentos de CCSS y de Impuesto de Renta.
                            La CCSS obrero se aplica &#250;nicamente sobre vacaciones y preaviso.
                        </div>

                    </group>

                    <!-- Préstamos -->
                    <group string="Préstamos y Adelantos Pendientes" invisible="not computed">
                        <div class="alert alert-warning" role="alert" invisible="has_loans">
                            El empleado no tiene préstamos ni adelantos pendientes.
                        </div>
                        <field name="loan_line_ids" readonly="1" invisible="not has_loans"
                               nolabel="1" colspan="2">
                            <list>
                                <field name="loan_type"/>
                                <field name="amount_total"/>
                                <field name="amount_paid"/>
                                <field name="amount_pending" decoration-danger="amount_pending &gt; 0"/>
                            </list>
                        </field>
                        <group invisible="not has_loans">
                            <field name="total_loans_pending" readonly="1"
                                   style="font-weight:bold;color:#E74C3C;"/>
                        </group>
                    </group>

                    <!-- Total final -->
                    <group string="Total a Pagar al Empleado" invisible="not computed">
                        <group>
                            <field name="total_net" readonly="1" string="Neto Liquidación"/>
                            <field name="total_loans_pending" readonly="1"
                                   string="Menos: Deudas Pendientes"
                                   style="color:#E74C3C;"/>
                            <field name="total_final" readonly="1"
                                   style="font-weight:bold;font-size:16px;color:#27AE60;"/>
                        </group>
                    </group>

                    <!-- Notas -->
                    <group string="Notas del Cálculo" invisible="not computed">
                        <field name="notes" readonly="1" nolabel="1" colspan="2"
                               style="font-family:monospace;font-size:11px;background:#F8F9FA;padding:8px;"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_simulate" type="object" string="Calcular Liquidación"
                            class="btn-primary" invisible="computed"/>
                    <button name="action_simulate" type="object" string="Recalcular"
                            class="btn-secondary" invisible="not computed"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_termination_simulator" model="ir.actions.act_window">
        <field name="name">Simulador de Liquidación</field>
        <field name="res_model">planilla.termination.simulator</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

    <!-- ── Feature 10: ZIP Auditoría ── -->
    <record id="view_audit_zip_wizard_form" model="ir.ui.view">
        <field name="name">planilla.audit.zip.wizard.form</field>
        <field name="model">planilla.audit.zip.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportación ZIP para Auditoría">
                <sheet>
                    <div class="alert alert-success" role="alert">
                        <strong>Paquete de Auditoría:</strong> Genera un ZIP con todos los documentos del período
                        listo para entregar al auditor externo.
                    </div>
                    <group>
                        <group string="Filtros">
                            <field name="company_id"/><field name="branch_id"/>
                            <field name="date_from"/><field name="date_to"/>
                        </group>
                        <group string="Documentos a incluir">
                            <field name="include_payslips_pdf"/>
                            <field name="include_employer_cost"/>
                            <field name="include_mtss"/>
                            <field name="include_overtime"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_zip" type="object"
                            string="Generar ZIP" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_audit_zip_wizard" model="ir.actions.act_window">
        <field name="name">Exportación ZIP Auditoría</field>
        <field name="res_model">planilla.audit.zip.wizard</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>

</odoo>
