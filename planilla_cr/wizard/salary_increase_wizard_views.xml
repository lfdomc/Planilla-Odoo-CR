<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salary_increase_wizard_form" model="ir.ui.view">
        <field name="name">planilla.salary.increase.wizard.form</field>
        <field name="model">planilla.salary.increase.wizard</field>
        <field name="arch" type="xml">
            <form string="Incremento Salarial Masivo">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Incremento Salarial Masivo</strong> -- Configure el incremento y
                        verifique la vista previa antes de aplicar. Esta acción actualiza el salario
                        base y registra el cambio en el historial de cada empleado.
                    </div>
                    <group>
                        <group string="Tipo de Incremento">
                            <field name="increase_type" widget="radio"/>
                            <field name="percent" invisible="increase_type != 'percent'"
                                   string="Porcentaje (%)"/>
                            <field name="fixed_amount" invisible="increase_type != 'fixed'"
                                   string="Monto Fijo (CRC)"/>
                            <field name="effective_date"/>
                            <field name="note" placeholder="Ej: Aumento salario mínimo 2026"/>
                        </group>
                        <group string="Aplicar a">
                            <field name="filter_type" widget="radio"/>
                            <field name="department_id"
                                   invisible="filter_type != 'department'"/>
                            <field name="branch_id"
                                   invisible="filter_type != 'branch'"/>
                            <field name="employee_ids"
                                   invisible="filter_type != 'employee'"
                                   widget="many2many_tags"/>
                        </group>
                    </group>
                    <separator string="Vista Previa de Cambios"/>
                    <field name="preview_line_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="current_salary" string="Salario Actual"/>
                            <field name="new_salary" string="Salario Nuevo"/>
                            <field name="difference" string="Diferencia"
                                   decoration-success="difference > 0"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar Incremento"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_salary_increase_wizard" model="ir.actions.act_window">
        <field name="name">Incremento Salarial Masivo</field>
        <field name="res_model">planilla.salary.increase.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
