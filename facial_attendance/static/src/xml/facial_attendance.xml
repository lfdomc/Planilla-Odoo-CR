<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Template: Quiosco de Reconocimiento Facial
         ═══════════════════════════════════════════════════════════════════════ -->
    <t t-name="facial_attendance.Kiosk">
        <div class="o_facial_kiosk">

            <!-- Reloj -->
            <div class="o_facial_clock">
                <div class="clock-time" t-esc="state.clockTime"/>
                <div class="clock-date" t-esc="state.clockDate"/>
            </div>

            <!-- Encabezado -->
            <div class="o_facial_kiosk_header">
                <h1>Control de Asistencia</h1>
                <p class="subtitle">Mire directamente a la cámara para registrar su asistencia</p>
            </div>

            <!-- Badge de posición GPS en vivo del kiosco -->
            <div t-if="showGpsBadge"
                 t-att-class="'o_facial_gps_badge ' + (state.gpsStatus === 'ok' ? 'gps-ok' : 'gps-out')">
                <span class="gps-badge-dot"/>
                <span t-esc="gpsBadgeText"/>
            </div>

            <!-- Alerta destacada: kiosco fuera de zona -->
            <div t-if="gpsOutOfRangeAlert" class="o_facial_gps_alert">
                ⚠️ Kiosco no se encuentra en el lugar correcto. Las marcas se registrarán como fuera de la zona de trabajo.
            </div>

            <!-- Área de cámara -->
            <div t-att-class="'o_facial_camera_wrapper ' + cameraState + ' ' + gpsIndicatorClass">

                <!-- Video -->
                <video t-ref="video"
                       class="o_facial_video"
                       autoplay="true"
                       muted="true"
                       playsinline="true"/>

                <!-- Canvas oculto para captura -->
                <canvas t-ref="canvas" class="o_facial_canvas"/>

                <!-- Guía oval -->
                <div class="o_facial_guide">
                    <div class="o_facial_guide-oval"/>
                </div>

                <!-- Barra de escaneo -->
                <div t-if="showScanning" class="o_facial_scanning"/>

                <!-- Overlay: cargando -->
                <div t-if="showLoading" class="o_facial_overlay">
                    <div class="overlay-icon">⏳</div>
                    <div class="overlay-text">Iniciando cámara…</div>
                </div>

                <!-- Overlay: sin cámara -->
                <div t-if="showNoCamera" class="o_facial_overlay">
                    <div class="overlay-icon">📷</div>
                    <div class="overlay-text">Sin acceso a cámara</div>
                    <div class="overlay-sub" t-esc="state.cameraError"/>
                </div>

                <!-- Overlay: dispositivo pendiente de activacion -->
                <div t-if="showPendingActivation" class="o_facial_overlay" style="background: rgba(234,179,8,0.15)">
                    <div class="overlay-icon">🔒</div>
                    <div class="overlay-text">Dispositivo no activado</div>
                    <div class="overlay-sub" t-esc="state.errorMsg"/>
                </div>

                <!-- Boton: listo para marcar, esperando que el usuario inicie la deteccion -->
                <div t-if="showWaitingButton" class="o_facial_overlay o_facial_waiting_button">
                    <button class="o_facial_mark_btn" t-on-click="startActiveDetection">
                        Marcar Asistencia
                    </button>
                    <div class="overlay-sub">Presione el boton y mire a la camara</div>
                </div>

                <!-- Overlay: éxito (verde normal, ambar si quedo fuera de area) -->
                <div t-if="showResult"
                     class="o_facial_overlay"
                     t-att-style="resultOutOfRange ? 'background: rgba(234,179,8,0.18)' : 'background: rgba(34,197,94,0.15)'">
                    <div class="overlay-icon" t-esc="resultOutOfRange ? '⚠️' : '✅'"/>
                    <div class="overlay-text" t-esc="state.result.employee_name"/>
                    <div class="overlay-sub">
                        <t t-if="state.result.action_type === 'check_in'">🟢 Entrada registrada</t>
                        <t t-elif="state.result.action_type === 'check_out'">🔴 Salida registrada</t>
                    </div>
                    <div t-if="resultOutOfRange" class="overlay-sub" style="color:#b45309; font-weight:600">
                        Fuera del área permitida -- queda marcada para revisión
                    </div>
                </div>

            </div>

            <!-- Resultado del reconocimiento -->
            <div class="o_facial_result">

                <!-- Resultado exitoso -->
                <t t-if="showResult and state.result">
                    <div t-att-class="'o_facial_result_card ' + (resultOutOfRange ? 'warning-card' : 'success-card')">
                        <div class="o_facial_result_name" t-esc="state.result.employee_name"/>
                        <div t-att-class="'o_facial_result_action ' + actionClass"
                             t-esc="state.result.action_label"/>
                        <div class="o_facial_result_time" t-esc="state.result.time"/>
                        <div class="o_facial_result_confidence">
                            Confianza: <t t-esc="state.result.confidence"/>%
                        </div>
                        <div t-if="resultOutOfRange" class="o_facial_result_error" style="margin-top:6px">
                            ⚠️ Marcación fuera del área permitida (<t t-esc="state.result.gps_distance_meters"/>m).
                            Su asistencia fue registrada, pero requiere revisión del supervisor.
                        </div>
                    </div>
                </t>

                <!-- Dispositivo pendiente de activacion -->
                <t t-if="showPendingActivation">
                    <div class="o_facial_result_card error-card">
                        <div class="overlay-icon" style="font-size:2rem">🔒</div>
                        <div class="o_facial_result_error" t-esc="state.errorMsg"/>
                    </div>
                </t>

                <!-- Error -->
                <t t-if="showError">
                    <div class="o_facial_result_card error-card">
                        <div class="overlay-icon" style="font-size:2rem">❌</div>
                        <div class="o_facial_result_error" t-esc="state.errorMsg"/>
                    </div>
                </t>

                <!-- Estado listo (instrucción) -->
                <t t-if="!showResult and !showError and !showLoading and !showNoCamera and !showPendingActivation">
                    <p style="color: #64748b; font-size: 0.9rem; margin-top: 12px;">
                        Posicione su rostro dentro del óvalo para registrar su asistencia
                    </p>
                </t>

            </div>

            <!-- Pie del quiosco -->
            <div class="o_facial_kiosk_footer">
                <div class="o_facial_status_dot"/>
                <span class="o_facial_status_label">Sistema activo - Reconocimiento automático</span>
            </div>

        </div>
    </t>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Template: Widget de Cámara para Wizard de Registro
         ═══════════════════════════════════════════════════════════════════════ -->
    <t t-name="facial_attendance.CameraWidget">
        <div class="o_facial_camera_container">

            <!-- Error de cámara -->
            <t t-if="state.error">
                <div class="alert alert-danger">
                    <i class="fa fa-exclamation-circle me-2"/>
                    <span t-esc="state.error"/>
                </div>
            </t>

            <!-- Stream de video (antes de capturar) -->
            <t t-if="!state.captured">
                <div>
                    <video t-ref="wizardVideo"
                           class="o_facial_wizard_video"
                           autoplay="true"
                           muted="true"
                           playsinline="true"/>
                    <canvas t-ref="wizardCanvas" class="o_facial_wizard_canvas"/>
                </div>
                <div class="mt-3">
                    <p class="text-muted mb-2" style="font-size:0.85rem">
                        📋 Asegúrese de que su rostro esté bien iluminado y centrado
                    </p>
                    <button t-on-click="captureImage"
                            class="o_facial_capture_btn"
                            t-att-disabled="!state.streaming">
                        📷 Capturar Foto
                    </button>
                </div>
            </t>

            <!-- Preview de imagen capturada -->
            <t t-if="state.captured">
                <div>
                    <img t-ref="wizardPreview"
                         class="o_facial_wizard_preview"
                         alt="Imagen capturada"/>
                    <canvas t-ref="wizardCanvas" class="o_facial_wizard_canvas"/>
                </div>
                <div class="mt-3">
                    <div class="alert alert-success py-2 mb-2">
                        ✅ Imagen capturada correctamente. Haga clic en "Guardar Registro".
                    </div>
                    <button t-on-click="retakeImage"
                            class="o_facial_retake_btn">
                        🔄 Volver a Tomar
                    </button>
                </div>
            </t>

        </div>
    </t>

</templates>
