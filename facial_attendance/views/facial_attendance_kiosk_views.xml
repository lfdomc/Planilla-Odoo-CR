<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template del quiosco HTML (standalone, sin backend de Odoo) -->
    <template id="kiosk_template" name="Quiosco de Reconocimiento Facial">
        <t t-call="web.layout">
            <t t-set="head">
                <!--
                    Carga CSS + JS del quiosco a traves del bundle dedicado.
                    Incluye kiosk_standalone.js, que monta el componente OWL
                    en #facial_kiosk_app al cargar la pagina.
                -->
                <t t-call-assets="facial_attendance.assets_kiosk" t-js="true" t-css="true"/>
                <title>Quiosco de Asistencia - <t t-esc="company.name"/></title>
            </t>
            <t t-set="body_classname">o_facial_kiosk_body</t>

            <t t-if="public_mode and not public_kiosk_enabled">
                <!--
                    El quiosco publico esta deshabilitado desde Ajustes.
                    Mostrar aviso en lugar de montar la camara.
                -->
                <div class="o_facial_kiosk_disabled">
                    <h1>Quiosco no disponible</h1>
                    <p>
                        El quiosco público de reconocimiento facial está deshabilitado.
                        Un administrador debe activarlo desde
                        <strong>Ajustes → Reconocimiento Facial</strong>.
                    </p>
                </div>
            </t>
            <t t-else="">
                <!--
                    data-recognize-url: URL del endpoint JSON-RPC que usara
                    kiosk_standalone.js al montar el componente OWL.
                    La separa entre la ruta autenticada (/recognize) y la
                    publica (/kiosk/public/recognize).
                -->
                <div id="facial_kiosk_app"
                     t-att-data-company="company.name"
                     t-att-data-logo="'/web/image/res.company/%d/logo' % company.id"
                     t-att-data-recognize-url="recognize_url">
                    <!-- El componente OWL se monta aqui via kiosk_standalone.js -->
                </div>
            </t>
        </t>
    </template>

    <!-- Template mostrado cuando el enlace con token no corresponde a
         ningun kiosco (nunca existio, o se regenero y este ya quedo
         invalido). Sin menus de Odoo, igual que el kiosco normal. -->
    <template id="kiosk_invalid_token_template" name="Enlace de Quiosco Invalido">
        <t t-call="web.layout">
            <t t-set="head">
                <title>Enlace no valido</title>
            </t>
            <t t-set="body_classname">o_facial_kiosk_body</t>
            <div class="o_facial_kiosk_disabled">
                <h1>Enlace no válido</h1>
                <p>
                    Este enlace de quiosco ya no está activo. Puede haber
                    sido regenerado o el kiosco fue eliminado. Contacte a
                    un administrador para obtener el enlace actualizado.
                </p>
            </div>
        </t>
    </template>

    <!-- Accion URL (abre la pagina standalone en nueva pestana) -->
    <record id="action_facial_kiosk" model="ir.actions.act_url">
        <field name="name">Abrir Quiosco de Asistencia</field>
        <field name="url">/facial_attendance/kiosk</field>
        <field name="target">new</field>
    </record>

    <!-- Accion cliente para el menu backend (monta el componente dentro del webclient) -->
    <record id="action_facial_kiosk_view" model="ir.actions.client">
        <field name="name">Quiosco de Reconocimiento Facial</field>
        <field name="tag">facial_attendance.Kiosk</field>
    </record>

</odoo>
