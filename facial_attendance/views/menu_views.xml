<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Menú principal dentro de Asistencias.
         FIX: sequence=30 (antes 1), el menu nativo "Check In / Check
         Out" usa sequence=10 y "Manage Attendances" (registros
         normales de asistencia) usa sequence=20 en Odoo 19 (confirmado
         contra el codigo fuente real de hr_attendance). Con sequence=1
         este menu quedaba ANTES de ambos, haciendo que "Reconocimiento
         Facial" apareciera como la primera pantalla al entrar al
         modulo de Asistencias, en vez del comportamiento nativo
         esperado (que muestre primero los registros de asistencia). -->
    <menuitem id="menu_facial_attendance_root"
              name="Reconocimiento Facial"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="30"
              groups="hr.group_hr_user"/>

    <!-- Quiosco: sequence=1 lo ubica como primera opcion visible dentro
         del menu de Asistencias, junto al Modo Quiosco nativo. -->
    <menuitem id="menu_facial_attendance_kiosk"
              name="Abrir Quiosco (Reconocimiento Facial)"
              parent="menu_facial_attendance_root"
              action="action_facial_kiosk_view"
              sequence="1"
              groups="hr.group_hr_user"/>

    <!-- Registros -->
    <menuitem id="menu_facial_attendance_logs"
              name="Registros de Reconocimiento"
              parent="menu_facial_attendance_root"
              action="facial_attendance_log_action"
              sequence="20"
              groups="hr.group_hr_user"/>

    <!-- Sucursales -->
    <menuitem id="menu_facial_attendance_branches"
              name="Sucursales"
              parent="menu_facial_attendance_root"
              action="action_facial_attendance_branch"
              sequence="22"
              groups="hr.group_hr_manager"/>

    <!-- Kioscos -->
    <menuitem id="menu_facial_attendance_kiosks"
              name="Kioscos"
              parent="menu_facial_attendance_root"
              action="action_facial_attendance_kiosk"
              sequence="25"
              groups="hr.group_hr_manager"/>

    <!-- Empleados con rostro registrado -->
    <menuitem id="menu_facial_attendance_employees"
              name="Empleados Registrados"
              parent="menu_facial_attendance_root"
              action="hr.open_view_employee_list_my"
              sequence="30"
              groups="hr.group_hr_manager"/>

    <!-- Configuración -->
    <menuitem id="menu_facial_log_cleanup"
              name="Limpiar Imagenes Antiguas"
              parent="menu_facial_attendance_root"
              action="action_facial_log_cleanup_wizard"
              sequence="26"
              groups="hr.group_hr_manager"/>

    <menuitem id="menu_facial_attendance_config"
              name="Configuración"
              parent="menu_facial_attendance_root"
              action="base_setup.action_general_configuration"
              sequence="90"
              groups="hr.group_hr_manager"/>

</odoo>
