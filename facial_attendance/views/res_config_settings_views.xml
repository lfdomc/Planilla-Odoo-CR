<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_facial" model="ir.ui.view">
        <field name="name">res.config.settings.view.facial.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Reconocimiento Facial" name="facial_attendance"
                     groups="hr.group_hr_manager">

                    <block title="Detección y Reconocimiento">
                        <setting string="Modelo de Detección Facial"
                                 help="HOG es más rápido (CPU). CNN es más preciso (requiere GPU). Se aplica tanto al registro del rostro como al reconocimiento.">
                            <field name="facial_recognition_model" widget="radio"/>
                        </setting>
                        <setting string="Tolerancia de Reconocimiento"
                                 help="0.4 = muy estricto | 0.55 = recomendado | 0.6 = tolerante">
                            <field name="facial_recognition_tolerance"/>
                        </setting>
                        <setting string="Umbral Mínimo de Confianza (%)"
                                 help="Porcentaje mínimo para aceptar el reconocimiento. Recomendado: 60%">
                            <field name="facial_confidence_threshold"/>
                        </setting>
                    </block>

                    <block title="Comportamiento">
                        <setting string="Guardar Imágenes Capturadas"
                                 help="Guarda la foto de cada reconocimiento exitoso en el log.">
                            <field name="facial_save_images"/>
                        </setting>
                        <setting string="Acción Automática Entrada/Salida"
                                 help="Detecta automáticamente si el empleado está entrando o saliendo.">
                            <field name="facial_auto_action"/>
                        </setting>
                    </block>

                    <block title="Quiosco Público">
                        <setting string="Habilitar Quiosco Público (sin login)"
                                 help="Activa /facial_attendance/kiosk/public para tablets dedicadas en la entrada sin requerir inicio de sesión de Odoo. Use solo en redes controladas.">
                            <field name="facial_enable_public_kiosk"/>
                        </setting>
                        <setting string="Enlace del Quiosco Público"
                                 invisible="not facial_enable_public_kiosk"
                                 help="Copie este enlace y ábralo en el dispositivo dedicado (tablet, celular, computadora).">
                            <field name="facial_public_kiosk_url" widget="CopyClipboardChar" readonly="1"/>
                        </setting>
                    </block>

                    <block title="Quioscos con Reconocimiento Facial">
                        <setting string="Quioscos"
                                 help="Cada dispositivo (tablet, celular) tiene su propio enlace único, igual que el enlace con token del Modo Quiosco nativo de Asistencias -- sin iniciar sesión, sin menús de Odoo, solo la pantalla de cámara.">
                            <div class="text-muted">
                                Cada kiosco genera su propio enlace directo. Cree o
                                gestione sus kioscos desde
                                <strong>Asistencias → Reconocimiento Facial → Kioscos</strong>,
                                y copie el enlace de cada uno (campo "Enlace del
                                Kiosco") al dispositivo dedicado.
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
